"use client";

import { useState, useEffect, useRef, useCallback, type CSSProperties, type PointerEvent as ReactPointerEvent, type ReactElement, type ReactNode } from 'react';
import { CountDrum, FRAC_PARTS, REM_PX, STEP_DELAYS_MS, pace, pauseAll, resumeAll, cleanNumber, toRem, useCellSize, computeNumber, numberValue, type FracPart, type FractionParts, type MathOp, type NumberData, type NumberType } from './math/shared';
import { type DivisionMethod, type DivisionResult } from './operations/basic/DivisionBoard';
import { OPERATIONS } from './operations/registry';
import FitBoard from './math/FitBoard';
import SevenSeg, { formatElapsed } from './math/SevenSeg';

interface DigitCounts { n1: number; n2: number; }

// Fractions: how many digits each numerator / denominator has (1 to 6, one slider each), and new random ones: never 0
// (no denominator 0, and no numerator 0 either, which would make an empty example)
const FRACTION_MAX_DIGITS = 6;
const FRACTION_LABELS: Record<FracPart, string> = { n1: 'Numerator 1', d1: 'Denominator 1', n2: 'Numerator 2', d2: 'Denominator 2' };
const newFraction = (counts: Record<FracPart, number>): FractionParts => {
  let parts: FractionParts;
  let tries = 0;
  do {
    parts = { n1: computeNumber(counts.n1, 'integer'), d1: computeNumber(counts.d1, 'integer'), n2: computeNumber(counts.n2, 'integer'), d2: computeNumber(counts.d2, 'integer') };
  } while (FRAC_PARTS.some(k => numberValue(parts[k]) === 0) && ++tries < 100);
  return parts;
};
const EMPTY: NumberData = { digits: [], decimalCount: 0, sign: 1 };

// The steps window can be closed (only a thin strip with its arrow stays) and resized by dragging its edge. Beside the
// board (wide desktops, the `desk` + lg layout) its width changes, with < (open) and > (closed); under the board
// (tablets, phones) its height, with ˅ (open) and ˄ (closed). Open/closed and both sizes are remembered
const STEPS_STRIP = 30; // px: the closed window
// The title and the controls column sit 10px from the panel's left edge (Julian: first 5px, then 5px back to the right),
// whatever its left padding (p-3 / sm:p-5 / md:p-6 / lg:p-8 = 12 / 20 / 24 / 32px): pulled left by the padding minus 10px
// The controls column (drums, buttons) and the elapsed-time counter above it sit 3px lower (Julian), in every tab
const COL_DROP = 3;
const EDGE_5 = '-ml-[0.125rem] sm:-ml-[0.625rem] md:-ml-[0.875rem] lg:-ml-[1.375rem]';

// The frame of the boards that have no size rule of their own (fractions): centred in the width the board is laid out
// for (`viewW`, nominal px; not the area's live width, which changes every frame while the steps window slides), gliding
// with `smooth`, and reporting its width (like the other boards: see toggleSteps)
function FramedBoard({ viewW, smooth, onNaturalWidth, children }: { viewW: number; smooth: boolean; onNaturalWidth: (w: number) => void; children: ReactNode }): ReactElement {
  const ref = useRef<HTMLDivElement>(null);
  const [w, setW] = useState(0);
  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const ro = new ResizeObserver(() => {
      const k = REM_PX / (parseFloat(getComputedStyle(document.documentElement).fontSize) || REM_PX);
      setW(el.offsetWidth * k);
    });
    ro.observe(el);
    return () => ro.disconnect();
  }, []);
  useEffect(() => { if (w) onNaturalWidth(w); }, [w, onNaturalWidth]);
  return (
    <div
      ref={ref}
      className={`w-max shrink-0 mb-auto px-2 pb-4 ${w ? '' : 'mx-auto'} ${smooth ? 'transition-[margin-left] duration-600 ease-[cubic-bezier(0.22,1,0.36,1)]' : ''}`}
      style={w && viewW ? toRem({ marginLeft: Math.max(0, (viewW - w) / 2) }) : undefined}
    >
      {children}
    </div>
  );
}
// The open / close arrow: a chevron whose arms are 120° apart, pointing where the window will go: beside the board
// < when closed (it opens to the left) and > when open (it closes to the right); under the board ˄ closed, ˅ open
const StepsChevron = ({ dir }: { dir: 'left' | 'right' | 'up' | 'down' }): ReactElement => (
  // Each arm 60° from the axis (8.5 up, 4.9 across), so the arms are 120° apart; the box is as tight as the stroke
  <svg viewBox="0 0 7.5 20" aria-hidden="true" className="w-[7.5px] h-5 overflow-visible" style={{ transform: `rotate(${{ left: 0, right: 180, up: 90, down: -90 }[dir]}deg)` }}>
    <path d="M6.2 1.5 1.3 10l4.9 8.5" fill="none" stroke="currentColor" strokeWidth="2.6" strokeLinecap="round" strokeLinejoin="round" />
  </svg>
);
const STEPS_SIDE_QUERY = '(min-width: 64rem) and (min-width: 48rem) and (min-height: 37.5rem)';
const readSteps = (): { open: boolean; w: number | null; h: number | null } => {
  try {
    const v = JSON.parse(localStorage.getItem('math-explorer-steps') ?? 'null');
    if (v && typeof v === 'object') return { open: v.open !== false, w: typeof v.w === 'number' ? v.w : null, h: typeof v.h === 'number' ? v.h : null };
  } catch { /* storage off: defaults */ }
  return { open: true, w: null, h: null };
};

// Inline so the 3D look doesn't depend on how a Tailwind build handles long arbitrary values
// Explanation steps: #fb8c69 with a soft gradient from right (lighter) to left (deeper)
const STEP_TEXT: CSSProperties = {
  backgroundImage: 'linear-gradient(270deg, #fdbca6 0%, #fb8c69 50%, #d9653f 100%)',
  WebkitBackgroundClip: 'text',
  backgroundClip: 'text',
  color: 'transparent',
};

// The step being explained now (the newest line) and its arrow: one plain colour (Julian)
const CURRENT_STEP = '#58c7fe';
const CURRENT_STEP_TEXT: CSSProperties = { color: CURRENT_STEP };
// The last line, "Done! Result = …" (the result of the explanation): three shades from left to right (Julian) — dark at
// the start (#1e958b), light in the middle (#2ad4c6), a little darker again at the end (a quarter of the way back to the
// dark one). Its arrow goes from the dark to the light one
const RESULT_GRADIENT = ['#1e958b', '#2ad4c6', '#27c4b7'];
// …with a touch of white where it is lightest (Julian): a soft shine in the middle (the light shade, 65% towards white)
const RESULT_SHINE = '#b4f2ec';
const RESULT_STEP = 'url(#resultArrowGrad)';
const RESULT_STEP_TEXT: CSSProperties = {
  backgroundImage: `linear-gradient(90deg, ${RESULT_GRADIENT[0]} 0%, ${RESULT_GRADIENT[1]} 35%, ${RESULT_SHINE} 50%, ${RESULT_GRADIENT[1]} 65%, ${RESULT_GRADIENT[2]} 100%)`,
  WebkitBackgroundClip: 'text',
  backgroundClip: 'text',
  color: 'transparent',
  fontWeight: 700,
};
// …and a little bigger than the other steps (its arrow grows with it: it is sized in em)
const RESULT_STEP_SIZE: CSSProperties = { fontSize: '1.25em' };

// Arrow head in front of each step (no shaft), about as tall as the capital letters (0.9em)
const StepArrow = ({ color }: { color?: string }): ReactElement => (
  <svg viewBox="0 0 10 12" className="mt-[0.35em] h-[0.9em] w-auto shrink-0" aria-hidden="true">
    <path d="M0 0 10 6 0 12z" fill={color ?? 'url(#stepArrowGrad)'} />
  </svg>
);

// Each operation's title is tinted with its tab's colour, fading from left to right
// The title's colours come from its tab (OPERATIONS[].color): from a lighter tint of it on the left to the colour itself
const tint = (hex: string, amount: number): string => {
  const n = parseInt(hex.slice(1), 16);
  const mix = (c: number) => Math.round(c + (255 - c) * amount).toString(16).padStart(2, '0');
  return `#${mix((n >> 16) & 255)}${mix((n >> 8) & 255)}${mix(n & 255)}`;
};

const TITLE_3D: CSSProperties = {
  // Letter face: bright at the top, clearly shaded towards the bottom (the colour layer is added per operation)
  backgroundImage: 'linear-gradient(180deg, #ffffff 0%, #ececf2 38%, #a9a9b5 74%, #74747f 100%)',
  WebkitBackgroundClip: 'text',
  backgroundClip: 'text',
  color: 'transparent',
  filter: [
    'drop-shadow(0 -1px 0 rgba(255, 255, 255, 0.95))',  // bright light on the top edge
    // extruded side: eight layers going down and slightly right (depth), each darker than the last
    ...['#9b9ba7', '#898995', '#777783', '#666671', '#55555e', '#45454d', '#36363d', '#28282e']
      .map(c => `drop-shadow(0.3px 1px 0 ${c})`),
    'drop-shadow(2px 12px 10px rgba(0, 0, 0, 0.8))',    // shadow cast on the panel
  ].join(' '),
};

// An SVG path through `pts` with rounded corners: radius r, or r(corner) per corner, smaller where a segment is short
const roundedPath = (pts: [number, number][], r: number | ((corner: [number, number]) => number)): string => {
  if (pts.length < 2) return '';
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [px, py] = pts[i - 1], [x, y] = pts[i], [nx, ny] = pts[i + 1];
    const lin = Math.hypot(x - px, y - py), lout = Math.hypot(nx - x, ny - y);
    const k = Math.min(typeof r === 'number' ? r : r(pts[i]), lin / 2, lout / 2);
    const ax = x - ((x - px) / lin) * k, ay = y - ((y - py) / lin) * k;
    const bx = x + ((nx - x) / lout) * k, by = y + ((ny - y) / lout) * k;
    d += ` L${ax} ${ay} Q${x} ${y} ${bx} ${by}`;
  }
  const [lx, ly] = pts[pts.length - 1];
  return `${d} L${lx} ${ly}`;
};

export default function MathExplorer(): ReactElement {
  const [digitCounts, setDigitCounts] = useState<Record<MathOp, DigitCounts>>({
    // Every number starts with 1 digit (Julian); the drums go up to 12
    addition: { n1: 1, n2: 1 }, subtraction: { n1: 1, n2: 1 }, multiplication: { n1: 1, n2: 1 }, division: { n1: 1, n2: 1 }, fractions: { n1: 1, n2: 1 },
  });
  // Decimal places chosen for each number when it's a float (0 to 4)
  const [decimalCounts, setDecimalCounts] = useState<Record<MathOp, DigitCounts>>({
    addition: { n1: 2, n2: 2 }, subtraction: { n1: 2, n2: 2 }, multiplication: { n1: 2, n2: 2 }, division: { n1: 2, n2: 2 }, fractions: { n1: 2, n2: 2 },
  });
  const [numberTypes, setNumberTypes] = useState<Record<MathOp, NumberType>>({
    addition: 'integer', subtraction: 'integer', multiplication: 'integer', division: 'integer', fractions: 'integer',
  });
  const [activeOp, setActiveOp] = useState<MathOp>('addition');
  const [num1, setNum1] = useState<NumberData>({ digits: [], decimalCount: 0, sign: 1 });
  const [num2, setNum2] = useState<NumberData>({ digits: [], decimalCount: 0, sign: 1 });
  // Fractions: the numerators and denominators (their signs are N1's and N2's)
  const [fracCounts, setFracCounts] = useState<Record<FracPart, number>>({ n1: 1, d1: 1, n2: 1, d2: 1 });
  const [fracParts, setFracParts] = useState<FractionParts>({ n1: EMPTY, d1: EMPTY, n2: EMPTY, d2: EMPTY });
  const [status, setStatus] = useState('');
  // History of the explanation steps of the current computation, oldest first
  const [steps, setSteps] = useState<string[]>([]);
  const stepsRef = useRef<HTMLDivElement>(null);
  // Keep the newest step in view as the history grows
  useEffect(() => {
    const el = stepsRef.current;
    if (el) el.scrollTop = el.scrollHeight;
  }, [steps.length]);
  const [isAnimating, setIsAnimating] = useState(false);
  // Multiplication and division have their own boards. A reset remounts them (new key), and `boardRun` starts their animation.
  const [boardKey, setBoardKey] = useState(0);
  // Division: how the decimal points are moved before dividing (see DivisionBoard)
  // Step delay: which of STEP_DELAYS_MS (0, 0.5, 1, 1.5, 2 s) is added after each explanation step; remembered
  // Pause / Resume of a running explanation (see pauseAll in shared)
  const [paused, setPaused] = useState(false);
  // Elapsed time of the explanation (Julian): from Explain to Me to the end; it stops while paused and goes on at Resume;
  // Stop (and anything that clears the board) sets it back to 0. `acc`: the time counted so far, `start`: when the
  // current stretch began (null: not counting)
  const timer = useRef<{ acc: number; start: number | null }>({ acc: 0, start: null });
  const [elapsed, setElapsed] = useState(0);
  const [timing, setTiming] = useState(false);
  const timerStart = () => { timer.current = { acc: 0, start: performance.now() }; setElapsed(0); setTiming(true); };
  const timerHold = () => {
    const t = timer.current;
    if (t.start !== null) { t.acc += performance.now() - t.start; t.start = null; }
    setElapsed(t.acc); setTiming(false);
  };
  const timerGo = () => { if (timer.current.start === null) { timer.current.start = performance.now(); setTiming(true); } };
  const timerReset = () => { timer.current = { acc: 0, start: null }; setElapsed(0); setTiming(false); };
  useEffect(() => {
    if (!timing) return;
    const id = window.setInterval(() => {
      const t = timer.current;
      setElapsed(t.acc + (t.start !== null ? performance.now() - t.start : 0));
    }, 50);
    return () => window.clearInterval(id);
  }, [timing]);
  const togglePause = () => {
    if (!isAnimating) return;
    if (paused) { resumeAll(); setPaused(false); timerGo(); } else { pauseAll(); setPaused(true); timerHold(); }
  };
  const [stepDelay, setStepDelayState] = useState(0);
  const setStepDelay = (v: number) => {
    setStepDelayState(v);
    pace.stepMs = STEP_DELAYS_MS[v] ?? 0;
    try { localStorage.setItem('math-explorer-step-delay', String(v)); } catch { /* storage off */ }
  };
  useEffect(() => {
    const id = window.setTimeout(() => {
      try {
        const v = Number(localStorage.getItem('math-explorer-step-delay'));
        if (v > 0 && v < STEP_DELAYS_MS.length) { setStepDelayState(v); pace.stepMs = STEP_DELAYS_MS[v]; }
      } catch { /* storage off */ }
    }, 0);
    return () => window.clearTimeout(id);
  }, []);
  const [divisionMethod, setDivisionMethod] = useState<DivisionMethod>('classic');
  // Division: a result with a remainder or with decimals (at most 3); numbers with decimals always get decimals
  const [divisionResult, setDivisionResult] = useState<DivisionResult>('remainder');
  const effectiveDivisionResult: DivisionResult = numberTypes.division === 'float' ? 'decimals' : divisionResult;
  const [boardRun, setBoardRun] = useState(false);

  // Width of the board area, so the division board can stack its numbers when they don't fit on one line
  // Header: from lg up, the control band stays on the title's row as long as the title's slot (as wide as the
  // longest title, MULTIPLICATION), the band and the tabs fit there; only then does it move under the tabs.
  // Measured, so it reacts to the real widths, and the same for every operation, so the band never jumps when
  // you change operation.
  const headerRef = useRef<HTMLDivElement>(null);
  const titleSlotRef = useRef<HTMLDivElement>(null);
  const bandRef = useRef<HTMLDivElement>(null);
  const tabsRef = useRef<HTMLElement>(null);
  const [bandInline, setBandInline] = useState(true);
  useEffect(() => {
    const header = headerRef.current, slot = titleSlotRef.current, band = bandRef.current, tabs = tabsRef.current;
    if (!header || !slot || !band || !tabs) return;
    const lg = window.matchMedia('(min-width: 64rem)');
    const measure = () => {
      const gap = parseFloat(getComputedStyle(header).columnGap) || 0;
      // The three widths don't depend on where the band sits (all are their natural widths from lg up), so this can't flicker
      // The title's slot is as wide as the longest title (MULTIPLICATION), so the decision is the same for every operation
      const need = slot.offsetWidth + band.offsetWidth + tabs.offsetWidth + 2 * gap;
      setBandInline(lg.matches && need <= header.clientWidth);
    };
    const ro = new ResizeObserver(measure);
    [header, slot, band, tabs].forEach(el => ro.observe(el));
    lg.addEventListener('change', measure);
    measure();
    return () => { ro.disconnect(); lg.removeEventListener('change', measure); };
  }, []);

  // Operation tabs as a "snake": one line that runs down the left edge of the first tab, along its bottom, up between
  // the first two tabs, along the top of the second, down again, along the bottom of the third, and so on, ending with
  // the right edge of the last tab. The active tab's stretch of the line (a U around it) is drawn in its colour.
  const [snake, setSnake] = useState<{ base: string; close: string; active: string; w: number; h: number } | null>(null);
  useEffect(() => {
    const nav = tabsRef.current;
    if (!nav) return;
    const measure = () => {
      const box = nav.getBoundingClientRect();
      const tabs = Array.from(nav.querySelectorAll<HTMLButtonElement>('button[data-op]')).map(b => b.getBoundingClientRect());
      if (tabs.length < 2) { setSnake(null); return; }
      const half = 0.75; // half the stroke, so the whole line stays visible
      const top = Math.min(...tabs.map(t => t.top)) - box.top + half;
      const bottom = Math.max(...tabs.map(t => t.bottom)) - box.top - half;
      // The verticals sit in the middle of the gaps between tabs; the two outer ones keep the same distance from the
      // first and last tab (half a gap), so Addition and Fractions look like the tabs in between
      const gap = tabs[1].left - tabs[0].right;
      const xs = [tabs[0].left - box.left - gap / 2];
      for (let i = 0; i < tabs.length - 1; i++) xs.push((tabs[i].right + tabs[i + 1].left) / 2 - box.left);
      xs.push(tabs[tabs.length - 1].right - box.left + gap / 2);
      // Tab i runs along the bottom when i is even, along the top when it's odd
      const edge = (i: number) => (i % 2 === 0 ? bottom : top);
      const other = (i: number) => (i % 2 === 0 ? top : bottom);
      const pts: [number, number][] = [[xs[0], other(0)]];
      tabs.forEach((_, i) => { pts.push([xs[i], edge(i)], [xs[i + 1], edge(i)]); });
      pts.push([xs[tabs.length], other(tabs.length - 1)]);
      // Every turn has the same, small radius, so each S between two tabs is symmetric
      const radius = 7;
      // The active tab's stretch: its two sides and its edge, plus the start of each turn onto the neighbouring tabs,
      // as far as the end of each curve (one radius), so its coloured ends follow the grey line and are the same on
      // both sides (the line's two ends stay straight)
      const a = OPERATIONS.findIndex(o => o.id === activeOp);
      let active = '';
      if (a >= 0) {
        const last = tabs.length - 1;
        const seg: [number, number][] = [];
        if (a > 0) seg.push([xs[a] - radius, other(a)]);
        seg.push([xs[a], other(a)], [xs[a], edge(a)], [xs[a + 1], edge(a)], [xs[a + 1], other(a)]);
        if (a < last) seg.push([xs[a + 1] + radius, other(a)]);
        active = roundedPath(seg, radius);
      }
      // The line closes every tab: on the side the snake leaves open (the top of tabs 1, 3, 5, the bottom of 2, 4),
      // with the same rounded turns, so each junction between tabs has a curve on both sides and every tab is framed
      const close = tabs.map((_, i) => roundedPath([[xs[i], edge(i)], [xs[i], other(i)], [xs[i + 1], other(i)], [xs[i + 1], edge(i)]], radius)).join(' ');
      setSnake({ base: roundedPath(pts, radius), close, active, w: box.width, h: box.height });
    };
    const ro = new ResizeObserver(measure);
    ro.observe(nav);
    nav.querySelectorAll('button[data-op]').forEach(b => ro.observe(b));
    measure();
    return () => ro.disconnect();
  }, [activeOp]);

  const viewRef = useRef<HTMLDivElement>(null);
  // The steps window: open or closed, its width (beside the board) and height (under it); null = the layout's default
  const [stepsUi, setStepsUi] = useState<{ open: boolean; w: number | null; h: number | null }>({ open: true, w: null, h: null });
  const [stepsSide, setStepsSide] = useState(false);
  // How much wider than its usual width the steps window is (beside the board; its usual width is the layout's:
  // 30% of the row, between 16rem and 28rem). Measured on every size change, dragging included
  const [stepsExtra, setStepsExtra] = useState(0);
  // Default width beside the board (Julian): the window's left edge lines up with the left edge of the Addition tab
  // (row's right edge − the tab's left edge). null: not measurable (tabs elsewhere, or a width out of 200px … half the
  // row): the layout's default (30% of the row, between 16rem and 28rem)
  const [stepsDefaultW, setStepsDefaultW] = useState<number | null>(null);
  const stepsBoxRef = useRef<HTMLDivElement>(null);
  // The grip mark on the resize edge (80px long) is centred on the pointer: moved directly (no re-render of the page, so
  // it never lags behind), as soon as the pointer comes onto the edge and while it moves or drags. Kept 40px (half the
  // mark) inside the ends, so it never sticks out of the window
  const gripRef = useRef<HTMLSpanElement>(null);
  const placeGrip = (e: ReactPointerEvent<HTMLDivElement>) => {
    const mark = gripRef.current;
    if (!mark) return;
    const r = e.currentTarget.getBoundingClientRect();
    const side = r.height > r.width;
    const at = side ? e.clientY - r.top : e.clientX - r.left;
    const len = side ? r.height : r.width;
    mark.style[side ? 'top' : 'left'] = `${Math.max(40, Math.min(len - 40, at))}px`;
  };
  useEffect(() => {
    const box = stepsBoxRef.current;
    const row = box?.parentElement;
    if (!box || !row) return;
    const measure = () => {
      if (!stepsSide || !stepsUi.open) { setStepsExtra(0); return; }
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || REM_PX;
      const usual = stepsDefaultW ?? Math.min(28 * rem, Math.max(16 * rem, row.clientWidth * 0.3));
      setStepsExtra(Math.max(0, Math.round((box.getBoundingClientRect().width - usual) * (REM_PX / rem))));
    };
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(box);
    ro.observe(row);
    return () => ro.disconnect();
  }, [stepsSide, stepsUi.open, stepsDefaultW]);
  useEffect(() => {
    const row = stepsBoxRef.current?.parentElement;
    const nav = tabsRef.current;
    if (!row || !nav) return;
    const measure = () => {
      const tab = nav.querySelector('button[data-op="addition"]');
      if (!stepsSide || !tab) { setStepsDefaultW(null); return; }
      const w = Math.round(row.getBoundingClientRect().right - tab.getBoundingClientRect().left);
      setStepsDefaultW(w >= 200 && w <= row.clientWidth * 0.5 ? w : null);
    };
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(row);
    ro.observe(nav);
    window.addEventListener('resize', measure);
    return () => { ro.disconnect(); window.removeEventListener('resize', measure); };
  }, [stepsSide]);

  // The layout changed (beside / under the board): the mark starts again from the middle of the new edge
  useEffect(() => {
    const mark = gripRef.current;
    if (mark) { mark.style.top = ''; mark.style.left = ''; }
  }, [stepsSide]);
  useEffect(() => {
    const id = window.setTimeout(() => setStepsUi(readSteps()), 0);
    const mq = window.matchMedia(STEPS_SIDE_QUERY);
    const on = () => setStepsSide(mq.matches);
    on();
    mq.addEventListener('change', on);
    return () => { window.clearTimeout(id); mq.removeEventListener('change', on); };
  }, []);
  // Opening / closing the steps window (Julian): it slides smoothly, and when it gets there it gives a small shake, as
  // if it bumped into the edge. `bumpRef` marks that the next end of the width / height transition is such a slide
  const bumpRef = useRef(false);
  // The digits while the window opens / closes beside the board (Julian):
  // - window at its default width or narrower: the digits don't move at all — the boards keep the width they had with
  //   the window open (`frozenViewW`, nominal px) while it slides, and while it stays closed;
  // - window wider than its default: closing gives the digits room to grow (and to sit in the middle), opening takes it
  //   back — the boards get the final width at once and glide there with the window (`smoothFit`, 600ms), no jerk
  const [frozenViewW, setFrozenViewW] = useState<number | null>(null);
  // The width the board needs at full size (reported by the board): a wider window only matters when the board doesn't
  // fit beside it (Julian: with 2–3 digits the digits stay put even if the window was widened)
  const naturalWRef = useRef(0);
  const onNaturalWidth = useCallback((w: number) => { naturalWRef.current = w; }, []);
  // Closed after a window that did push the digits: they are centred on the page while it stays closed
  const [closedCentred, setClosedCentred] = useState(false);
  const [smoothFit, setSmoothFit] = useState(false);
  const smoothTimer = useRef<number | undefined>(undefined);
  const stepsWide = stepsSide && stepsUi.w !== null && stepsDefaultW !== null && stepsUi.w > stepsDefaultW + 1;
  const toggleSteps = () => {
    bumpRef.current = true;
    const opening = !stepsUi.open;
    if (stepsSide) {
      const box = stepsBoxRef.current, row = box?.parentElement;
      const k = (parseFloat(getComputedStyle(document.documentElement).fontSize) || REM_PX) / REM_PX;
      // the window's open width (px on screen) and how much narrower the board area is with it open than closed
      const openPx = stepsUi.w ?? stepsDefaultW ?? Math.min(28 * REM_PX * k, Math.max(16 * REM_PX * k, (row?.clientWidth ?? 0) * 0.3));
      const delta = (openPx - STEPS_STRIP) / k;
      const openViewW = opening ? viewWidth - delta : viewWidth;
      window.clearTimeout(smoothTimer.current);
      // the board fits beside the open window (with ~1px to spare): the window's width doesn't touch the digits
      const affected = stepsWide && naturalWRef.current > openViewW - 1;
      setClosedCentred(!opening && affected);
      if (!affected) {
        setSmoothFit(false);
        setFrozenViewW(openViewW);
        // opening: once it is open again the board area really is that wide
        if (opening) smoothTimer.current = window.setTimeout(() => setFrozenViewW(null), 650);
      } else {
        setFrozenViewW(opening ? openViewW : viewWidth + delta);
        setSmoothFit(true);
        smoothTimer.current = window.setTimeout(() => { setSmoothFit(false); setFrozenViewW(null); }, 650);
      }
    }
    saveSteps({ ...stepsUi, open: opening });
  };

  const onStepsSlideEnd = (e: React.TransitionEvent<HTMLDivElement>) => {
    if (e.target !== e.currentTarget || (e.propertyName !== 'width' && e.propertyName !== 'height') || !bumpRef.current) return;
    bumpRef.current = false;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // the first move goes on in the slide's direction (closing: right / down; opening: left / up), then a damped wobble
    const dir = stepsUi.open ? -1 : 1;
    const t = (d: number) => (stepsSide ? `translateX(${d * dir}px)` : `translateY(${d * dir}px)`);
    e.currentTarget.animate([0, 6, -4, 3, -1.5, 0.5, 0].map(d => ({ transform: t(d) })), { duration: 420, easing: 'ease-out' });
  };
  const saveSteps = (v: { open: boolean; w: number | null; h: number | null }) => {
    setStepsUi(v);
    try { localStorage.setItem('math-explorer-steps', JSON.stringify(v)); } catch { /* storage off */ }
  };
  // Dragging the window's edge: beside the board, its left edge (left = wider); under it, its top edge (up = taller)
  const startStepsResize = (e: ReactPointerEvent<HTMLDivElement>) => {
    const box = stepsBoxRef.current;
    if (!box) return;
    e.preventDefault();
    const handle = e.currentTarget;
    handle.setPointerCapture(e.pointerId);
    const r = box.getBoundingClientRect();
    const start = { x: e.clientX, y: e.clientY, w: r.width, h: r.height };
    let last = stepsUi;
    // While dragging, the window's size is set directly on it: no 0.3s transition (that one is only for opening and
    // closing) and no re-render of the page, so the edge and its grip mark stay right under the pointer. The size is
    // saved (and React takes over again) when the pointer is released
    box.style.transition = 'none';
    if (stepsSide) { box.style.minWidth = '200px'; box.style.maxWidth = '70vw'; }
    const move = (ev: PointerEvent) => {
      if (stepsSide) {
        const w = Math.round(Math.min(window.innerWidth * 0.7, Math.max(200, start.w - (ev.clientX - start.x))));
        box.style.width = `${w}px`;
        last = { ...stepsUi, open: true, w };
      } else {
        const h = Math.round(Math.min(window.innerHeight * 0.7, Math.max(80, start.h - (ev.clientY - start.y))));
        box.style.height = `${h}px`;
        last = { ...stepsUi, open: true, h };
      }
    };
    const up = () => {
      handle.removeEventListener('pointermove', move);
      handle.removeEventListener('pointerup', up);
      handle.removeEventListener('pointercancel', up);
      saveSteps(last);
      // React's style for the window applies again from the next frame (with the transition back)
      requestAnimationFrame(() => { box.style.transition = ''; });
    };
    handle.addEventListener('pointermove', move);
    handle.addEventListener('pointerup', up);
    handle.addEventListener('pointercancel', up);
  };

  // While an explanation runs, the board area follows the newest row: only when something actually written on the
  // board (a digit, a chip, a sign) goes below the bottom of the area, it scrolls down smoothly just enough to show it.
  // (Julian: the boards keep room for the rows still to come, so scrolling to the very bottom hid the numbers
  // at the top while the rows below were still empty.)
  const runningRef = useRef(false);
  useEffect(() => { runningRef.current = isAnimating; }, [isAnimating]);
  useEffect(() => {
    const el = viewRef.current;
    const content = el?.firstElementChild;
    if (!el || !content) return;
    let frame = 0;
    const follow = () => {
      frame = 0;
      if (!runningRef.current || el.scrollHeight <= el.clientHeight + 1) return;
      // the lowest piece of text that can be seen (leaves with text, not faded out)
      let lowest = -Infinity;
      for (const node of content.querySelectorAll('*')) {
        if (node.childElementCount || !node.textContent?.trim()) continue;
        const r = node.getBoundingClientRect();
        if (!r.height || r.bottom <= lowest) continue;
        let hidden = false;
        for (let a: Element | null = node; a && a !== content; a = a.parentElement) {
          if (Number(getComputedStyle(a).opacity) < 0.05) { hidden = true; break; }
        }
        if (!hidden) lowest = r.bottom;
      }
      const over = lowest + 16 - el.getBoundingClientRect().bottom;
      if (over > 1) el.scrollBy({ top: over, behavior: 'smooth' });
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(follow); };
    const ro = new ResizeObserver(schedule);
    ro.observe(content);
    const mo = new MutationObserver(schedule);
    mo.observe(content, { childList: true, subtree: true, characterData: true });
    return () => { ro.disconnect(); mo.disconnect(); if (frame) cancelAnimationFrame(frame); };
  });
  // The digit drums' box (two 40px drums 12px apart, p-3, 1px border: 118px) centred on the board's two numbers (Julian):
  // N1's cells start 60px down the board area and N2's end cell + 34 + cell further (addition / subtraction)
  const DRUM_BOX_H = 2 * 40 + 12 + 2 * 12 + 2;
  // Everything on the board, and the controls column with it, sits 25px higher than it used to (Julian, to save room):
  // the boards lost their 16px top padding and, from md up, the board area moves 9px up into the gap under the header
  // (it can't all come from the padding: the fraction labels above the numerators need the room)
  const BOARD_LIFT = 25;
  const [viewWidth, setViewWidth] = useState(0);
  const [viewHeight, setViewHeight] = useState(0);
  // The width the boards lay themselves out for
  const boardViewW = frozenViewW ?? viewWidth;
  useEffect(() => {
    const el = viewRef.current;
    if (!el) return;
    // Stored in nominal px (at a 16px root font size), the unit the boards compute their geometry in
    const ro = new ResizeObserver(entries => {
      const rootPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || REM_PX;
      setViewWidth(entries[0].contentRect.width * (REM_PX / rootPx));
      setViewHeight(entries[0].contentRect.height * (REM_PX / rootPx));
    });
    ro.observe(el);
    return () => ro.disconnect();
  }, []);

  useEffect(() => {
    const id = window.setTimeout(() => {
      setNum1(computeNumber(1, 'integer'));
      setNum2(computeNumber(1, 'integer'));
    }, 0);
    return () => window.clearTimeout(id);
  }, []);

  const activeConfig = OPERATIONS.find(o => o.id === activeOp) ?? OPERATIONS[0];
  // An operation is ready once it has a board
  const ready = !!activeConfig.board;
  // Numbers that can't be explained (a fraction with the denominator 0): Explain to Me and Redo stay disabled, with
  // the reason as their tooltip, until the numbers change
  const blocked = activeConfig.blocked?.({ num1, num2, fraction: fracParts }) ?? null;

  // Digit cell size (px), for placing the controls column next to the first operand
  const cell = useCellSize();
  // From md up the controls column floats over the board area (absolute), so the area is kept at least as tall as the column
  const colRef = useRef<HTMLDivElement>(null);
  // The elapsed-time counter sits halfway between the title and the controls column: the gap between them (px on screen)
  const titleRef = useRef<HTMLHeadingElement>(null);
  const [timerGap, setTimerGap] = useState(0);
  useEffect(() => {
    const measure = () => {
      const t = titleRef.current?.getBoundingClientRect(), c = colRef.current?.getBoundingClientRect();
      if (t && c) setTimerGap(Math.max(0, Math.round(c.top - t.bottom)));
    };
    measure();
    const ro = new ResizeObserver(measure);
    if (titleRef.current) ro.observe(titleRef.current);
    if (colRef.current) ro.observe(colRef.current);
    window.addEventListener('resize', measure);
    return () => { ro.disconnect(); window.removeEventListener('resize', measure); };
  }, [activeOp, cell]);
  // Room on the left of the board area that a board may move into (desktop): the area's left padding (md:pl-60) minus
  // the controls column on it, minus 15px kept free next to the column (Julian). 0 when the column is above the board
  const [leftRoom, setLeftRoom] = useState(0);
  // The middle of the page, from the board area's left content edge (nominal px)
  const [pageMidX, setPageMidX] = useState<number | undefined>(undefined);
  useEffect(() => {
    const view = viewRef.current, col = colRef.current;
    if (!view || !col) return;
    const measure = () => {
      const rootPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || REM_PX;
      const contentLeft = view.getBoundingClientRect().left + parseFloat(getComputedStyle(view).paddingLeft);
      setPageMidX(Math.round((document.documentElement.clientWidth / 2 - contentLeft) * (REM_PX / rootPx) * 10) / 10);
      if (getComputedStyle(col).position !== 'absolute') { setLeftRoom(0); return; }
      setLeftRoom(Math.max(0, Math.floor((contentLeft - col.getBoundingClientRect().right - 15) * (REM_PX / rootPx))));
    };
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(view);
    ro.observe(col);
    window.addEventListener('resize', measure);
    return () => { ro.disconnect(); window.removeEventListener('resize', measure); };
  }, []);
  const [colBottom, setColBottom] = useState(0);
  useEffect(() => {
    const col = colRef.current;
    if (!col) return;
    const md = window.matchMedia('(min-width: 48rem)');
    const measure = () => setColBottom(md.matches ? Math.ceil(col.offsetTop + col.offsetHeight + 16) : 0);
    const ro = new ResizeObserver(measure);
    ro.observe(col);
    md.addEventListener('change', measure);
    measure();
    return () => { ro.disconnect(); md.removeEventListener('change', measure); };
  }, [cell]);

  // `keepBoard` keeps the board mounted (used while turning a digit's drum,
  // so the tuning wheel keeps its drag and the rolling digits can animate)
  // Numbered explanation steps: during a computation each new explanation is shown as "Step N: …"
  // (the final "Done!" message is left unnumbered). The counter restarts with every reset.
  const stepRef = useRef(0);
  const announce = (text: string) => {
    let line = text;
    if (!text.startsWith('Done')) {
      stepRef.current += 1;
      line = `Step ${stepRef.current}: ${text}`;
    }
    setSteps(prev => [...prev, line]);
    setStatus(line);
    // Step delay: the board's next pause is longer by the chosen time
    if (!text.startsWith('Done')) pace.owed = pace.stepMs;
  };

  const resetResult = (keepBoard = false) => {
    setStatus(''); setIsAnimating(false);
    pace.owed = 0;
    // A paused explanation that is stopped or reset: everything runs again (the board is cleared anyway)
    resumeAll();
    setPaused(false);
    timerReset();
    stepRef.current = 0;
    setSteps([]);
    // A board that already ran still shows its old work, so it is remounted (cleared) even when keeping it
    if (!keepBoard || boardRun) setBoardKey(k => k + 1);
    setBoardRun(false);
  };

  // Redo: back to the problem exactly as it was entered (signs and all), clearing the explanation and any rewrite
  const hasWork = isAnimating || steps.length > 0 || boardRun;
  const redo = () => {
    if (!hasWork || blocked) return;
    resetResult();
  };

  const stopComputation = () => {
    if (!isAnimating) return;
    resetResult();
    setStatus('Computation stopped.');
  };

  const regenerate = (n1: number, n2: number, type: NumberType, op: MathOp = activeOp, decs: DigitCounts = decimalCounts[op]) => {
    // Floats get the decimal places chosen for each number. New numbers are never ones the operation can't explain
    // (its `blocked` in the registry, e.g. a fraction with the denominator 0): they are drawn again until they can be
    const blockedFor = OPERATIONS.find(o => o.id === op)?.blocked;
    let a: NumberData;
    let b: NumberData;
    let fraction: FractionParts;
    let tries = 0;
    do {
      a = computeNumber(n1, type, { decimals: decs.n1 });
      b = computeNumber(n2, type, { decimals: decs.n2 });
      // In division, the divisor can't be 0
      while (op === 'division' && b.digits.every(d => d === 0)) b = computeNumber(n2, type, { decimals: decs.n2 });
      // Fractions: new numerators and denominators too (N1 and N2 only give them their signs)
      fraction = op === 'fractions' ? newFraction(fracCounts) : fracParts;
    } while (blockedFor?.({ num1: a, num2: b, fraction }) && ++tries < 100);
    setNum1(a);
    setNum2(b);
    if (op === 'fractions') setFracParts(fraction);
    resetResult();
  };

  const selectOp = (op: MathOp) => {
    if (isAnimating) return;
    setActiveOp(op);
    regenerate(digitCounts[op].n1, digitCounts[op].n2, numberTypes[op], op);
  };

  const handleDigitCountChange = (target: 'n1' | 'n2', val: number) => {
    if (isAnimating) return;
    const next = { ...digitCounts[activeOp], [target]: val };
    setDigitCounts(prev => ({ ...prev, [activeOp]: next }));
    // Fewer digits than decimals + 1: the decimals come down too (a float keeps one digit before the point)
    const decs = { ...decimalCounts[activeOp] };
    if (decs[target] > val - 1) {
      decs[target] = Math.max(0, val - 1);
      setDecimalCounts(prev => ({ ...prev, [activeOp]: decs }));
    }
    regenerate(next.n1, next.n2, numberTypes[activeOp], activeOp, decs);
  };

  // Fractions: a slider changed how many digits a numerator or denominator has (1 to 6); new ones are drawn for all four
  const handleFracCountChange = (part: FracPart, val: number) => {
    if (isAnimating) return;
    const next = { ...fracCounts, [part]: val };
    setFracCounts(next);
    setFracParts(newFraction(next));
    resetResult();
  };

  // The decimal places a float number gets: as chosen, but never more than its digits allow
  const effectiveDecimals = (which: 'n1' | 'n2') => Math.min(decimalCounts[activeOp][which], digitCounts[activeOp][which] - 1);
  // − / + next to "N1 decimals" and "N2 decimals" (0 to 4); more decimals than the digits allow adds digits
  const changeDecimals = (which: 'n1' | 'n2', delta: 1 | -1) => {
    if (isAnimating) return;
    const d = Math.max(0, Math.min(4, effectiveDecimals(which) + delta));
    const decs = { ...decimalCounts[activeOp], [which]: d };
    const digs = { ...digitCounts[activeOp] };
    if (digs[which] < d + 1) digs[which] = d + 1;
    setDecimalCounts(prev => ({ ...prev, [activeOp]: decs }));
    setDigitCounts(prev => ({ ...prev, [activeOp]: digs }));
    regenerate(digs.n1, digs.n2, numberTypes[activeOp], activeOp, decs);
  };

  // Removes leading zeros left by turning the digit drums, and syncs the sliders with the new lengths
  const cleanOperands = (): [NumberData, NumberData] => {
    const a = cleanNumber(num1);
    const b = cleanNumber(num2);
    setNum1(a);
    setNum2(b);
    setDigitCounts(prev => ({ ...prev, [activeOp]: { n1: a.digits.length, n2: b.digits.length } }));
    return [a, b];
  };

  const cycleDigit = (which: 'n1' | 'n2', index: number, direction: 1 | -1) => {
    // Digits are changed by hovering a digit and turning its steel drum, but not during a computation
    if (isAnimating || index < 0) return;
    const setter = which === 'n1' ? setNum1 : setNum2;
    setter(prev => {
      const digits = [...prev.digits];
      digits[index] = (digits[index] + direction + 10) % 10;
      return { ...prev, digits };
    });
    resetResult(true);
  };

  // Fractions: a digit of a numerator / denominator turned with its steel drum
  const cycleFractionDigit = (part: FracPart, index: number, direction: 1 | -1) => {
    if (isAnimating || index < 0) return;
    setFracParts(prev => {
      const digits = [...prev[part].digits];
      digits[index] = (digits[index] + direction + 10) % 10;
      return { ...prev, [part]: { ...prev[part], digits } };
    });
    resetResult(true);
  };

  const toggleSign = (which: 'n1' | 'n2') => {
    if (isAnimating) return;
    const setter = which === 'n1' ? setNum1 : setNum2;
    setter(prev => ({ ...prev, sign: prev.sign === 1 ? -1 : 1 }));
    resetResult(true); // the board stays mounted
  };

  const startAnimation = () => {
    if (isAnimating || !ready || blocked || num1.digits.length === 0 || num2.digits.length === 0) return;

    const [, b] = cleanOperands();
    // Fractions: leading zeros left by the drums go too (007 → 7), and the sliders follow the new lengths
    if (activeOp === 'fractions') {
      const cleaned = Object.fromEntries(FRAC_PARTS.map(k => [k, cleanNumber(fracParts[k])])) as FractionParts;
      setFracParts(cleaned);
      setFracCounts({ n1: cleaned.n1.digits.length, d1: cleaned.d1.digits.length, n2: cleaned.n2.digits.length, d2: cleaned.d2.digits.length });
    }
    if (activeOp === 'division' && numberValue(b) === 0) {
      setStatus('We can’t divide by zero. Change N2 first.');
      return;
    }
    // The active board runs its own explanation (see operations/registry)
    resetResult();
    setIsAnimating(true);
    setBoardRun(true);
    timerStart();
  };

  // The +/− button in front of each number (each board places it)
  const renderSignButton = (which: 'n1' | 'n2', sign: 1 | -1) => (
    <button
      type="button"
      onClick={() => toggleSign(which)}
      disabled={isAnimating}
      aria-label={`Toggle sign of ${which.toUpperCase()}`}
      className={`w-8 h-8 shrink-0 self-center flex items-center justify-center rounded-full transition-all duration-500 disabled:opacity-60 bg-zinc-900/40 hover:bg-zinc-900/60 ${sign === 1 ? 'text-cyan-400 border border-cyan-500/30 shadow-[0_0_15px_rgba(6,182,212,0.2)] hover:shadow-[0_0_25px_rgba(6,182,212,0.4)]' : 'text-pink-400 border border-pink-500/30 shadow-[0_0_15px_rgba(236,72,153,0.2)] hover:shadow-[0_0_25px_rgba(236,72,153,0.4)]'}`}
    >
      {/* Drawn, not typed: a font's + and − sit a little off-centre; these are exactly in the middle of the circle */}
      <svg viewBox="0 0 12 12" aria-hidden="true" className="w-3 h-3 block">
        <path d={sign === 1 ? 'M6 1.5v9M1.5 6h9' : 'M1.5 6h9'} fill="none" stroke="currentColor" strokeWidth="2.6" strokeLinecap="round" />
      </svg>
    </button>
  );

  const explainLabel = isAnimating ? 'Processing...' : ready ? 'Explain to Me' : 'Coming soon';

  // Explain to Me, New Numbers and Stop. `wide`: in the controls column from md up, Explain to Me takes a whole row
  // (New Numbers and Stop share the next one), since the column is only as wide as INTEGER / FLOAT / Redo
  const renderActions = (wide: boolean) => {
    // In the column the buttons share its width, so they keep a small padding
    const pad = wide ? 'px-2' : 'px-2 sm:px-5 lg:px-4';
    return (
    <>
                <button
              type="button"
              onClick={startAnimation}
              disabled={isAnimating || !ready || !!blocked}
              title={blocked ?? undefined}
              className={`${wide ? 'md:col-span-2 ' : ''}h-10 sm:h-8 ${pad} inline-flex items-center justify-center whitespace-nowrap rounded-xl text-[11px] sm:text-[10px] font-bold leading-none text-white text-shadow-[0_1px_1px_rgba(0,0,0,0.3)] border transition-all hover:scale-105 border-[#1b55b8] bg-linear-to-l from-[#22b8d6] to-[#1d5fd1] shadow-[inset_0_1px_0_rgba(255,255,255,0.22),inset_0_-2px_0_rgba(0,0,0,0.25),0_3px_6px_rgba(0,0,0,0.35)] hover:from-[#3cc8e4] hover:to-[#2a6fe0] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.28),inset_0_-2px_0_rgba(0,0,0,0.25),0_3px_14px_rgba(34,184,214,0.45)] active:translate-y-px active:shadow-[inset_0_1px_0_rgba(255,255,255,0.15),inset_0_-1px_0_rgba(0,0,0,0.25),0_1px_2px_rgba(0,0,0,0.35)] disabled:bg-none disabled:bg-zinc-700 disabled:border-zinc-600 disabled:text-zinc-500 disabled:shadow-none disabled:text-shadow-none disabled:hover:scale-100 disabled:active:translate-y-0`}
            >
              {explainLabel}
            </button>
                <button
              type="button"
              disabled={isAnimating}
              onClick={() => {
                regenerate(digitCounts[activeOp].n1, digitCounts[activeOp].n2, numberTypes[activeOp]);
              }}
              className={`h-10 sm:h-8 ${pad} inline-flex items-center justify-center whitespace-nowrap rounded-xl text-[11px] sm:text-[10px] font-bold leading-none text-white text-shadow-[0_1px_1px_rgba(0,0,0,0.3)] border transition-all hover:scale-105 border-zinc-600 bg-linear-to-l from-[#55555f] to-[#34343b] shadow-[inset_0_1px_0_rgba(255,255,255,0.22),inset_0_-2px_0_rgba(0,0,0,0.25),0_3px_6px_rgba(0,0,0,0.35)] hover:from-[#62626d] hover:to-[#3d3d45] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.28),inset_0_-2px_0_rgba(0,0,0,0.25),0_3px_14px_rgba(161,161,170,0.3)] active:translate-y-px active:shadow-[inset_0_1px_0_rgba(255,255,255,0.15),inset_0_-1px_0_rgba(0,0,0,0.25),0_1px_2px_rgba(0,0,0,0.35)] disabled:opacity-60 disabled:hover:shadow-none disabled:hover:from-[#55555f] disabled:hover:to-[#34343b] disabled:hover:scale-100 disabled:active:translate-y-0`}
            >
              New Numbers
            </button>
                <button
              type="button"
              onClick={stopComputation}
              disabled={!isAnimating}
              className={`h-10 sm:h-8 ${pad} inline-flex items-center justify-center whitespace-nowrap rounded-xl text-[11px] sm:text-[10px] font-bold leading-none text-white text-shadow-[0_1px_1px_rgba(0,0,0,0.3)] border transition-all hover:scale-105 border-[#9a1c1c] bg-linear-to-l from-[#f04a4a] to-[#9c1a1a] shadow-[inset_0_1px_0_rgba(255,255,255,0.22),inset_0_-2px_0_rgba(0,0,0,0.25),0_3px_6px_rgba(0,0,0,0.35)] hover:from-[#f85d5d] hover:to-[#ae2020] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.28),inset_0_-2px_0_rgba(0,0,0,0.25),0_3px_14px_rgba(211,50,50,0.45)] active:translate-y-px active:shadow-[inset_0_1px_0_rgba(255,255,255,0.15),inset_0_-1px_0_rgba(0,0,0,0.25),0_1px_2px_rgba(0,0,0,0.35)] disabled:opacity-40 disabled:hover:shadow-none disabled:hover:from-[#f04a4a] disabled:hover:to-[#9c1a1a] disabled:hover:scale-100 disabled:active:translate-y-0`}
            >
              Stop
            </button>
    </>
    );
  };

  return (
    <div className="min-h-screen bg-zinc-950 text-zinc-100 flex flex-col md:flex-row font-sans">
      <style>{`
        @keyframes popIn {
          0% { opacity: 0; transform: scale(0.3); }
          70% { opacity: 1; transform: scale(1.1); }
          100% { opacity: 1; transform: scale(1); }
        }
        @keyframes fadeOut {
          from { opacity: 1; transform: scale(1); }
          to { opacity: 0; transform: scale(0.5); }
        }
        @keyframes carryFlight {
          0% { transform: translate(0, 0) scale(1); animation-timing-function: ease-in-out; }
          40% { transform: translate(var(--tx), 0) scale(1); animation-timing-function: linear; }
          100% { transform: translate(var(--tx), var(--ty)) scale(1.4); }
        }
        @keyframes rollUp {
          from { transform: translateY(100%); }
          to { transform: translateY(0); }
        }
        @keyframes rollDown {
          from { transform: translateY(-100%); }
          to { transform: translateY(0); }
        }
        .animate-roll-up { animation: rollUp 0.16s cubic-bezier(0.2, 0.8, 0.3, 1.2); }
        .animate-roll-down { animation: rollDown 0.16s cubic-bezier(0.2, 0.8, 0.3, 1.2); }
        .animate-pop-in { animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
        /* Steps window scrollbar: 8px, no track, a rounded #456175 thumb, always shown once the steps overflow. The track keeps
           16px clear at the top and bottom, so it stops where the window's rounded corners begin */
        .steps-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
        .steps-scroll::-webkit-scrollbar-corner { background: transparent; }
        .steps-scroll::-webkit-scrollbar-track { background: transparent; margin: 16px 0; }
        .steps-scroll::-webkit-scrollbar-thumb { background: #456175; border-radius: 9999px; }
        @supports (-moz-appearance: none) {
          .steps-scroll { scrollbar-width: thin; scrollbar-color: #456175 transparent; }
        }
        .animate-fade-out { animation: fadeOut 1s ease-out forwards; }
        .animate-carry-flight { animation: carryFlight 1.4s forwards; }
        @media (prefers-reduced-motion: reduce) {
          .animate-pop-in, .animate-fade-out, .animate-carry-flight, .animate-roll-up, .animate-roll-down { animation-duration: 1ms; }
        }
      `}</style>

      <svg width="0" height="0" className="absolute" aria-hidden="true">
        <defs>
          <linearGradient id="upArrowGrad" x1="0" y1="1" x2="0" y2="0"><stop offset="0%" stopColor="#ecfccb" /><stop offset="30%" stopColor="#86efac" /><stop offset="60%" stopColor="#22c55e" /><stop offset="100%" stopColor="#14532d" /></linearGradient>
          <linearGradient id="stepArrowGrad" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stopColor="#d9653f" /><stop offset="100%" stopColor="#fdbca6" /></linearGradient>
          <linearGradient id="resultArrowGrad" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stopColor={RESULT_GRADIENT[0]} /><stop offset="100%" stopColor={RESULT_GRADIENT[1]} /></linearGradient>
          <linearGradient id="downArrowGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="#fee2e2" /><stop offset="30%" stopColor="#fca5a5" /><stop offset="60%" stopColor="#ef4444" /><stop offset="100%" stopColor="#7f1d1d" /></linearGradient>
        </defs>
      </svg>

      <main className="flex-1 min-w-0 desk:py-[1.5vh] flex flex-col items-center justify-center">
        <div className="w-full desk:w-[99vw]">
          {/* Panel, background #15161e with a discreet gradient of close shades.
              Phone (also held sideways): fills the screen edge to edge and the page scrolls (header, board, then the steps).
              Tablet and desktop (`desk`: at least 48rem wide and 37.5rem tall, see globals.css): 99% of the screen width
              and 97% of its height; the board scrolls inside the middle area */}
          <div className="min-h-dvh desk:min-h-0 desk:h-[97vh] flex flex-col gap-3 2xl:gap-0 bg-linear-to-br from-[#191a23] via-[#15161e] to-[#111219] border-zinc-800 desk:border desk:rounded-3xl p-3 sm:p-5 md:p-6 lg:p-8 md:pr-2.5 lg:pr-2.5 backdrop-blur-xl shadow-2xl">
            {/* 3D title (same for every operation): metallic light-to-shade gradient on the letters, an extruded
                edge built from stacked 1px shadows that get darker downwards, and a soft cast shadow. Raised 5px */}
            {/* Header. The operation tabs always keep the same look (one row, full names) at the top right.
                From lg up: title, control band and tabs on one row while they fit (`bandInline`, measured above).
                Otherwise (narrower desktop, tablet, phone): title and tabs here, and the control band in the controls column */}
            <div ref={headerRef} className={`relative shrink-0 flex flex-wrap ${bandInline ? 'lg:flex-nowrap' : ''} items-center justify-between gap-x-4 gap-y-3`}>
            {/* From lg up: a slot as wide as the longest title (MULTIPLICATION), so the control band doesn't move between operations */}
            <div ref={titleSlotRef} className="order-1 shrink-0 lg:w-[24rem] 2xl:w-[27.5rem]">
            <h1
              ref={titleRef}
              // 10px from the panel's left edge (Julian; see EDGE_5)
              className={`w-max -mt-1.25 ${EDGE_5} text-[32px] sm:text-[39px] md:text-[43px] 2xl:text-[50px] font-black tracking-[calc(-0.05em+3px)]`}
              style={{
                ...TITLE_3D,
                // Light and shade from top to bottom (keeps the 3D look) over the operation's colours from left to right
                backgroundImage: `linear-gradient(180deg, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0.15) 40%, rgba(0, 0, 0, 0.3) 100%), linear-gradient(90deg, ${tint(activeConfig.color, 0.45)}, ${activeConfig.color})`,
              }}
            >
              {activeConfig.label.toUpperCase()}
            </h1>
            </div>
          {/* Control band: Explain to Me, New Numbers and Stop on their own background, with the same padding on both sides.
              On the title's row while it fits there (from lg up, `bandInline`). Otherwise it moves into the controls column,
              under the sliders and INTEGER / FLOAT / Redo (see below); this copy then stays invisible and out of the way,
              only so its width can still be measured */}
            <div ref={bandRef} aria-hidden={!bandInline || undefined} inert={!bandInline} className={`${bandInline ? 'lg:order-2' : 'invisible absolute top-0 left-0 pointer-events-none'} shrink-0 flex items-center bg-zinc-800/50 px-3 py-2 rounded-2xl border border-zinc-700`}>
              <div className="flex items-center gap-2.5">
                {renderActions(false)}
              </div>
            </div>
            {/* Operation tabs: five equal columns below lg (symbol above the name on a phone), one row on the right from lg up.
                The snake line (see `snake` above) is drawn over them, in an SVG the size of the tab row */}
            <nav ref={tabsRef} className={`relative order-2 ${bandInline ? 'lg:order-3' : ''} w-full lg:w-auto px-0.5 grid grid-cols-5 gap-1 lg:flex lg:justify-end`} aria-label="Operations">
              {snake && (
                <svg className="pointer-events-none absolute inset-0 overflow-visible" width={snake.w} height={snake.h} aria-hidden="true">
                  {/* The grey line: thin and close to the panel's background (#15161e), discreet but visible */}
                  <path d={snake.base} fill="none" stroke="#353641" strokeWidth="1" strokeLinejoin="round" strokeLinecap="round" />
                  <path d={snake.close} fill="none" stroke="#353641" strokeWidth="1" strokeLinejoin="round" strokeLinecap="round" />
                  <path d={snake.active} fill="none" stroke={activeConfig.color} strokeWidth="2" strokeLinejoin="round" strokeLinecap="round" className="drop-shadow-[0_0_4px_rgba(255,255,255,0.25)]" />
                </svg>
              )}
              {OPERATIONS.map(op => {
                const active = activeOp === op.id;
                return (
                  <button
                    key={op.id}
                    data-op={op.id}
                    type="button"
                    disabled={isAnimating}
                    onClick={() => selectOp(op.id)}
                    aria-pressed={active}
                    className={`relative min-w-0 flex flex-col sm:flex-row items-center justify-center gap-0.5 sm:gap-1 px-1 sm:px-2.5 lg:px-2 rounded-md text-[9.5px] sm:text-[11px] font-semibold cursor-pointer transition-all hover:brightness-125 disabled:opacity-50 disabled:hover:brightness-100 py-1.5 bg-transparent ${active ? 'font-bold' : 'text-zinc-400 hover:text-zinc-200'}`}
                    // No background: the active tab is shown by its stretch of the line and its name, both in its colour
                    style={active ? { color: op.color } : undefined}
                  >
                    <span className="relative sm:hidden text-lg font-black leading-none" aria-hidden="true">{op.icon === '-' ? '−' : op.icon}</span>
                    <span className="relative max-w-full truncate">{op.label}</span>
                    {!op.board && <span className="relative hidden sm:inline text-[8px] font-bold uppercase tracking-wider px-1 py-px rounded bg-zinc-800 text-zinc-500 border border-zinc-700">Soon</span>}
                  </button>
                );
              })}
            </nav>
            </div>
            {/* Middle area. Desk (tall enough) and lg up: the board on the left keeps its full height and the steps window
                sits on the right. Otherwise: the board on top and the steps window under it, full width */}
            <div className="flex flex-col gap-3 desk:flex-1 desk:min-h-0 desk:lg:flex-row desk:lg:gap-0.5">
            <div className="relative flex flex-col md:flex-row flex-1 min-w-0 min-h-0" style={colBottom ? { minHeight: colBottom } : undefined}>
              {/* Integer / Float / Redo (+ the decimal method in division, + the decimal places for floats). From md up: on the line of the first operand (N1), aligned with the left edge of the canvas
                  (N1's cells start 60px down the board area: 16px padding + 44px, so this is centred on them).
                  On a phone: a normal row above the board (the inline `top` only applies when positioned) */}
              <div ref={colRef} className={`flex flex-col gap-2 w-full md:w-max md:max-w-60 md:absolute md:left-0 ${EDGE_5} md:z-10`} style={toRem({ top: 60 - BOARD_LIFT + COL_DROP + (2 * cell + 34 - DRUM_BOX_H) / 2 })}>
                {/* The digit drums' box, INTEGER | FLOAT under it, Redo under them (as wide as both), then in division
                    CLASSIC and EQUAL DECIMALS, each on its own row: everything as wide as the drums' box (Julian) */}
                {/* Elapsed time (Julian): halfway between the title and the drums' box, its right end in line with the column's
                    (desktop: the column is placed absolutely, under the title) */}
                <div className="hidden md:flex absolute right-0 translate-y-1/2" style={{ bottom: `calc(100% + ${timerGap / 2}px - ${COL_DROP / 2 / 16}rem)` }}>
                  <SevenSeg text={formatElapsed(elapsed)} label={`Elapsed time ${formatElapsed(elapsed)}`} />
                </div>
                <div className="grid w-full md:w-max grid-cols-[auto_1fr] gap-2">
                {/* How many digits each number has: a steel drum per number (always open, no three dots; 1 to 12, fractions:
                    one per numerator / denominator, 1 to 6), each after its label, in their own box (same background as
                    the control band): the grid's first row, spanning both columns. From md up it is centred on the first
                    operand's digits (N1); 20px down to INTEGER (the grid's 8px gap plus mb-3) */}
                <div className="col-span-2 mb-3">
                  {/* One under the other, N1 first; 12px between the drums, the same as from the drums to the box's edges
                      (Julian) */}
                  <div className="flex flex-col gap-3 bg-zinc-800/50 p-3 rounded-2xl border border-zinc-700" role="group" aria-label={activeOp === 'fractions' ? 'Digits of the fractions' : 'Digits'}>
                    {(activeOp === 'fractions'
                      ? FRAC_PARTS.map(k => ({ key: k, label: FRACTION_LABELS[k], first: k.endsWith('1'), value: fracCounts[k], max: FRACTION_MAX_DIGITS, set: (v: number) => handleFracCountChange(k, v) }))
                      : (['n1', 'n2'] as const).map(k => ({ key: k, label: `${k.toUpperCase()} Digits`, first: k === 'n1', value: digitCounts[activeOp][k], max: 12, set: (v: number) => handleDigitCountChange(k, v) }))
                    ).map(d => (
                      <div key={d.key} className="flex items-center justify-between gap-1.5">
                        {/* The label on the drum's row, on one line */}
                        <span className={`text-[8px] font-bold uppercase whitespace-nowrap ${d.first ? 'text-cyan-500' : 'text-pink-500'}`}>{d.label}</span>
                        <CountDrum value={d.value} min={1} max={d.max} onChange={d.set} color={d.first ? 'cyan' : 'pink'} disabled={isAnimating} label={`${d.label}: ${d.value}`} />
                      </div>
                    ))}
                  </div>
                </div>
                {(['integer', 'float'] as NumberType[]).map(t => {
                  const active = numberTypes[activeOp] === t;
                  return (
                    <button
                      type="button"
                      // Fractions are made of whole numbers: INTEGER stays on, FLOAT can't be chosen
                      disabled={isAnimating || activeOp === 'fractions'}
                      title={activeOp === 'fractions' ? 'Fractions use whole numbers' : undefined}
                      key={t}
                      onClick={() => {
                        setNumberTypes(prev => ({ ...prev, [activeOp]: t }));
                        // A float needs at least 2 digits (one before the point), so in division FLOAT raises 1-digit numbers to 2
                        const c = digitCounts[activeOp];
                        const next = t === 'float' && activeOp === 'division' ? { n1: Math.max(2, c.n1), n2: Math.max(2, c.n2) } : c;
                        if (next !== c) setDigitCounts(prev => ({ ...prev, [activeOp]: next }));
                        regenerate(next.n1, next.n2, t);
                      }}
                      className={`whitespace-nowrap px-2 py-1 rounded-lg text-xs font-bold border cursor-pointer transition-all hover:-translate-y-px hover:shadow-[0_0_10px_rgba(6,182,212,0.35)] disabled:opacity-40 disabled:hover:translate-y-0 disabled:hover:shadow-none ${active ? 'bg-cyan-500/10 border-cyan-500 text-cyan-500 hover:bg-cyan-500/20' : 'border-zinc-700 text-zinc-500 hover:border-cyan-700 hover:text-cyan-300'}`}
                    >
                      {t.toUpperCase()}
                    </button>
                  );
                })}
                {/* Redo: under INTEGER and FLOAT, as wide as both together; same height; blue (like Explain to Me) when it can be used, like the other
                    buttons when it can't. Shows the original problem again, as entered */}
                <button
                  type="button"
                  onClick={redo}
                  disabled={isAnimating || !hasWork || !!blocked}
                  title={blocked ?? 'Back to the problem as it was entered'}
                  className="col-span-2 px-2 py-1 rounded-lg border text-xs font-bold leading-4 whitespace-nowrap transition-all text-white text-shadow-[0_1px_1px_rgba(0,0,0,0.3)] border-[#1b55b8] bg-linear-to-l from-[#22b8d6] to-[#1d5fd1] shadow-[inset_0_1px_0_rgba(255,255,255,0.22),inset_0_-1px_0_rgba(0,0,0,0.25),0_2px_5px_rgba(0,0,0,0.35)] hover:-translate-y-px hover:from-[#3cc8e4] hover:to-[#2a6fe0] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.28),inset_0_-1px_0_rgba(0,0,0,0.25),0_2px_10px_rgba(34,184,214,0.45)] active:translate-y-0 disabled:bg-none disabled:bg-transparent disabled:border-zinc-700 disabled:text-zinc-500 disabled:shadow-none disabled:text-shadow-none disabled:hover:translate-y-0 disabled:cursor-default"
                >
                  Redo
                </button>
                {/* Step delay (Julian): extra time after each explanation step, 0 / 0.5 / 1 / 1.5 / 2 s, on a drum like the digit
                    counts (it stops at 0 and 2); the label left-aligned with Redo, the drum right-aligned with FLOAT. Unlike
                    the other controls it works while an explanation runs: the step under way finishes as it was, the
                    next ones take the new delay */}
                <div className="col-span-2 mt-1 flex items-center justify-between" role="group" aria-label="Step delay">
                  <span className="text-[8px] font-bold uppercase whitespace-nowrap text-cyan-500">Step delay</span>
                  <div>
                    <CountDrum
                      value={stepDelay}
                      min={0}
                      max={STEP_DELAYS_MS.length - 1}
                      onChange={setStepDelay}
                      color="cyan"
                      label={`Step delay: ${STEP_DELAYS_MS[stepDelay] / 1000} seconds`}
                      format={i => String(STEP_DELAYS_MS[i] / 1000)}
                      // The 2 alone looks smaller than 0.5 / 1.5 at the same size: 7% bigger (Julian)
                      textStyle={i => (STEP_DELAYS_MS[i] === 2000 ? { fontSize: '26.75px' } : undefined)}
                    />
                  </div>
                </div>
                {/* Pause / Resume (Julian): freezes the explanation exactly where it is, and goes on from there. Amber
                    (Pause) / green (Resume), darker, a metallic gradient from left to right, slightly 3D, with a shadow; pressed, it sinks in and springs
                    back. Only while an explanation runs */}
                <button
                  type="button"
                  onClick={togglePause}
                  disabled={!isAnimating}
                  aria-pressed={paused}
                  title={paused ? 'Go on from here' : 'Stop for a moment, exactly here'}
                  className={`col-span-2 mt-1 flex items-center justify-center gap-2 px-3 py-1.5 rounded-lg border text-xs font-black uppercase tracking-[1.5px] text-white text-shadow-[0_1px_1px_rgba(0,0,0,0.45)] cursor-pointer transition-[transform,box-shadow,filter] duration-150 ease-out shadow-[inset_0_1px_0_rgba(255,255,255,0.45),inset_0_-2px_0_rgba(0,0,0,0.25),0_3px_0_rgba(0,0,0,0.45),0_6px_12px_rgba(0,0,0,0.35)] hover:brightness-110 active:translate-y-0.5 active:scale-[0.97] active:shadow-[inset_0_1px_0_rgba(255,255,255,0.3),inset_0_-1px_0_rgba(0,0,0,0.25),0_1px_0_rgba(0,0,0,0.45),0_2px_5px_rgba(0,0,0,0.35)] disabled:opacity-40 disabled:cursor-default disabled:hover:brightness-100 disabled:active:translate-y-0 disabled:active:scale-100 ${paused ? 'border-[#145c2a] bg-linear-[90deg,#1d7a3c_0%,#2a9a4e_35%,#4fbf6f_55%,#23864a_80%,#165f30_100%]' : 'border-[#7a5200] bg-linear-[90deg,#b07a00_0%,#d69a0a_35%,#f0bd3a_55%,#c88a00_80%,#946400_100%]'}`}
                >
                  {paused ? (
                    <svg viewBox="0 0 12 12" className="w-3 h-3" aria-hidden="true"><path d="M3 1.5 10.5 6 3 10.5z" fill="currentColor" /></svg>
                  ) : (
                    <svg viewBox="0 0 12 12" className="w-3 h-3" aria-hidden="true"><rect x="2.5" y="1.5" width="2.5" height="9" rx="0.6" fill="currentColor" /><rect x="7" y="1.5" width="2.5" height="9" rx="0.6" fill="currentColor" /></svg>
                  )}
                  {paused ? 'Resume' : 'Pause'}
                </button>
                {/* Division only: how the decimal points are moved before dividing (the grid's second row) */}
                {activeOp === 'division' ? (
                  <div className="contents" role="group" aria-label="Decimal method">
                    {([
                      ['classic', 'CLASSIC', 'Move the decimal point by the divisor’s decimal places, so the divisor becomes a whole number'],
                      ['equalize', 'EQUAL DECIMALS', 'Give both numbers the same number of decimal places, so both become whole numbers'],
                    ] as [DivisionMethod, string, string][]).map(([m, label, hint]) => {
                      const active = divisionMethod === m;
                      return (
                        <button
                          type="button"
                          key={m}
                          disabled={isAnimating}
                          title={hint}
                          aria-pressed={active}
                          onClick={() => {
                            if (m === divisionMethod) return;
                            setDivisionMethod(m);
                            resetResult();
                          }}
                          className={`col-span-2 whitespace-nowrap px-2 py-1 rounded-lg text-xs font-bold border cursor-pointer transition-all hover:-translate-y-px hover:shadow-[0_0_10px_rgba(6,182,212,0.35)] disabled:opacity-40 disabled:hover:translate-y-0 disabled:hover:shadow-none ${active ? 'bg-cyan-500/10 border-cyan-500 text-cyan-500 hover:bg-cyan-500/20' : 'border-zinc-700 text-zinc-500 hover:border-cyan-700 hover:text-cyan-300'}`}
                        >
                          {label}
                        </button>
                      );
                    })}
                    {/* The result: with a remainder or with decimals (Julian), side by side */}
                    {([
                      ['remainder', 'REMAINDER', 'Stop at the units: the quotient is a whole number and what is left over is the remainder'],
                      ['decimals', 'DECIMALS', 'Go on after the decimal point: the quotient gets up to 3 decimal places'],
                    ] as [DivisionResult, string, string][]).map(([r, label, hint]) => {
                      const active = effectiveDivisionResult === r;
                      const locked = r === 'remainder' && numberTypes.division === 'float';
                      return (
                        <button
                          type="button"
                          key={r}
                          disabled={isAnimating || locked}
                          title={locked ? 'Numbers with decimals always give a result with decimals' : hint}
                          aria-pressed={active}
                          onClick={() => {
                            if (r === divisionResult) return;
                            setDivisionResult(r);
                            resetResult();
                          }}
                          className={`whitespace-nowrap px-2 py-1 rounded-lg text-xs font-bold border cursor-pointer transition-all hover:-translate-y-px hover:shadow-[0_0_10px_rgba(6,182,212,0.35)] disabled:opacity-40 disabled:hover:translate-y-0 disabled:hover:shadow-none mt-2 ${active ? 'bg-cyan-500/10 border-cyan-500 text-cyan-500 hover:bg-cyan-500/20' : 'border-zinc-700 text-zinc-500 hover:border-cyan-700 hover:text-cyan-300'}`}
                        >
                          {label}
                        </button>
                      );
                    })}
                  </div>
                ) : null}
                </div>
                {/* FLOAT: how many decimal places each number gets (0 to 4); 5px of extra space above */}
                {numberTypes[activeOp] === 'float' && (
                  <div className="mt-1.25 flex flex-col gap-1.5" role="group" aria-label="Decimal places">
                    {(['n1', 'n2'] as const).map(w => {
                      const d = effectiveDecimals(w);
                      const step = 'w-6.5 h-6.5 flex items-center justify-center rounded-lg border border-zinc-700 text-zinc-300 text-sm font-bold leading-none transition-all hover:-translate-y-px hover:border-cyan-700 hover:text-cyan-300 disabled:opacity-40 disabled:hover:translate-y-0 disabled:hover:border-zinc-700 disabled:hover:text-zinc-300';
                      return (
                        <div key={w} className="flex items-center gap-2">
                          {/* 5px more between the label and the − button (mr-1.25 on top of the row's 8px gap) */}
                          <span className={`w-22 shrink-0 mr-1.25 text-[8px] font-bold uppercase whitespace-nowrap ${w === 'n1' ? 'text-cyan-500' : 'text-pink-500'}`}>{w.toUpperCase()} Decimals</span>
                          <button type="button" className={step} onClick={() => changeDecimals(w, -1)} disabled={isAnimating || d <= 0} aria-label={`Fewer decimal places in ${w.toUpperCase()}`}>−</button>
                          <span className={`w-6.5 text-center text-xs font-bold ${w === 'n1' ? 'text-cyan-400' : 'text-pink-400'}`} aria-live="polite">{d}</span>
                          <button type="button" className={step} onClick={() => changeDecimals(w, 1)} disabled={isAnimating || d >= 4} aria-label={`More decimal places in ${w.toUpperCase()}`}>+</button>
                        </div>
                      );
                    })}
                  </div>
                )}
                {/* The control band, when it doesn't fit on the title's row: under the controls, 20px apart (the 8px gap
                    plus mt-3), exactly as wide as they are (w-0 min-w-full: it takes the column's width, never widens it). Phone: one row of three. From md up: Explain to Me on its own row,
                    New Numbers and Stop under it */}
                {!bandInline && (
                  <div className="mt-3 w-0 min-w-full bg-zinc-800/50 px-3 py-2.5 md:py-2 rounded-2xl border border-zinc-700">
                    <div className="grid grid-cols-3 md:grid-cols-2 gap-2">
                      {renderActions(true)}
                    </div>
                  </div>
                )}
              </div>
            {/* From md up, left padding = the width of the Integer / Float / Redo buttons (and, in division, the decimal
                method under them), so wide numbers never run into them.
                Numbers wider than the screen scroll sideways */}
            {/* steps-scroll: the same 8px #456175 scrollbars as the steps window */}
            <div ref={viewRef} className="steps-scroll flex-1 min-w-0 min-h-0 overflow-auto flex md:pl-60 md:-mt-[0.5625rem]">
              {/* The active operation's board (see operations/registry). Multiplication and division sit in a padded frame and
                  start near the top of the panel, just below the title, at the same height for every operation */}
              {(() => {
                const board = activeConfig.board?.({
                  num1,
                  num2,
                  run: boardRun,
                  onStatus: announce,
                  onDone: () => { timerHold(); setIsAnimating(false); },
                  renderSign: renderSignButton,
                  onCycleDigit: cycleDigit,
                  hoverEdit: !isAnimating,
                  availableWidth: Math.max(0, boardViewW - 16),
                  smoothFit,
                  availableHeight: viewHeight,
                  stepsExtra,
                  leftRoom,
                  // centred on the page when closed only if the open window pushed the digits (see toggleSteps)
                  stepsClosed: !stepsUi.open && closedCentred,
                  onNaturalWidth,
                  pageMidX,
                  boardKey,
                  divisionMethod,
                  divisionResult: effectiveDivisionResult,
                  fraction: fracParts,
                  onCycleFractionDigit: cycleFractionDigit,
                });
                // Multiplication and division: the same size and place rule as addition / subtraction (Julian), in a FitBoard
                if (activeOp === 'multiplication' || activeOp === 'division') {
                  return (
                    <FitBoard availableWidth={Math.max(0, boardViewW - 16)} availableHeight={viewHeight} smooth={smoothFit} onNaturalWidth={onNaturalWidth} leftRoom={leftRoom} stepsClosed={!stepsUi.open && closedCentred} pageMidX={pageMidX} longest={Math.max(num1.digits.length, num2.digits.length)}>
                      <div className="w-max pb-4">{board}</div>
                    </FitBoard>
                  );
                }
                return activeConfig.framed
                  ? <FramedBoard viewW={boardViewW} smooth={smoothFit} onNaturalWidth={onNaturalWidth}>{board}</FramedBoard>
                  : board;
              })()}
            </div>

            </div>
            {/* Steps window: the history of the current computation (Step 1, Step 2, …), newest at the bottom and kept
                in view. Metallic green bevelled border on the top, right and bottom that thins out towards the left.
                On a phone it sticks to the bottom of the screen (with its own background), so the explanation stays
                in view while the board scrolls under it; on a very short screen (a phone held sideways) it is lower */}
            <div
              ref={stepsBoxRef}
              onTransitionEnd={onStepsSlideEnd}
              className="sticky bottom-0 z-30 desk:relative desk:z-auto shrink-0 w-full h-40 [@media(max-height:30rem)]:h-24 desk:h-52 desk:lg:h-auto desk:lg:w-[30%] desk:lg:min-w-64 desk:lg:max-w-md rounded-r-2xl bg-[#15161e]/95 backdrop-blur-md desk:bg-transparent desk:backdrop-blur-none transition-[width,height] duration-600 ease-[cubic-bezier(0.22,1,0.36,1)]"
              // Closed: a thin strip. Resized: the width (beside the board) or the height (under it) that was dragged
              style={stepsSide
                ? (!stepsUi.open ? { width: STEPS_STRIP, minWidth: STEPS_STRIP } : stepsUi.w ? { width: stepsUi.w, minWidth: 200, maxWidth: '70vw' } : stepsDefaultW ? { width: stepsDefaultW, minWidth: 200, maxWidth: '70vw' } : undefined)
                : (!stepsUi.open ? { height: STEPS_STRIP } : stepsUi.h ? { height: stepsUi.h } : undefined)}
            >
              {/* Resize: drag the edge facing the board (the left edge beside it, the top edge under it) */}
              {stepsUi.open && (
                <div
                  role="separator"
                  aria-orientation={stepsSide ? 'vertical' : 'horizontal'}
                  aria-label="Resize the explanation window"
                  onPointerDown={startStepsResize}
                  // Double click: back to the default size (beside the board: in line with the Addition tab)
                  onDoubleClick={() => saveSteps(stepsSide ? { ...stepsUi, w: null } : { ...stepsUi, h: null })}
                  // The grip mark follows the pointer along the edge, from the first moment and while dragging
                  onPointerEnter={placeGrip}
                  onPointerMove={placeGrip}
                  className={`absolute z-20 touch-none ${stepsSide ? '-left-1.5 top-0 bottom-0 w-3 cursor-col-resize' : 'left-0 right-0 -top-1.5 h-3 cursor-row-resize'} group`}
                >
                  {/* shown at once (no fade) on hover, and while the edge is being dragged. Beside the board: 2px right of the
                      window's edge (Julian); the edge itself and the resizing are unchanged */}
                  <span
                    ref={gripRef}
                    className={`absolute rounded-full bg-[#456175] opacity-0 group-hover:opacity-100 group-active:opacity-100 ${stepsSide ? 'left-[calc(50%+2px)] top-1/2 -translate-x-1/2 -translate-y-1/2 w-1 h-20' : 'top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2 h-1 w-20'}`}
                  />
                </div>
              )}
              {/* Open / close: < and > beside the board, ˅ and ˄ under it */}
              <button
                type="button"
                onClick={toggleSteps}
                aria-expanded={stepsUi.open}
                aria-label={stepsUi.open ? 'Close the explanation window' : 'Open the explanation window'}
                title={stepsUi.open ? 'Close the explanation window' : 'Open the explanation window'}
                // Closed: the arrow 8px from the green border on the right (which is 3px wide) beside the board, 13px from the
                // edge under it (both 5px further in than at first, Julian); open: at the top left (beside) / top right (under)
                className={`absolute z-30 w-5 h-7 flex items-center ${stepsSide && !stepsUi.open ? 'justify-end' : 'justify-center'} rounded-md text-[#55b58e] hover:text-[#7fd6b0] hover:bg-white/5 cursor-pointer ${stepsSide ? (stepsUi.open ? 'top-2 left-1' : 'top-2 right-[13px]') : (stepsUi.open ? 'top-1 right-2' : 'top-1 right-[15px]')}`}
              >
                <StepsChevron dir={stepsSide ? (stepsUi.open ? 'right' : 'left') : (stepsUi.open ? 'down' : 'up')} />
              </button>
              <div
                aria-hidden="true"
                className="pointer-events-none absolute inset-0 rounded-r-2xl border-y-[3px] border-r-[3px] border-l-0 border-t-[#55b58e] border-r-[#42a07c] border-b-[#2f7f61] shadow-[inset_0_1px_0_rgba(255,255,255,0.18),inset_-1px_0_0_rgba(255,255,255,0.1),0_3px_8px_rgba(0,0,0,0.55)] mask-[linear-gradient(90deg,transparent_0%,black_35%)]"
              />
              <div
                ref={stepsRef}
                role="log"
                aria-live="polite"
                // Room for the open / close arrow: on the left beside the board, at the top under it
                className={`steps-scroll absolute inset-0 overflow-y-auto py-3 pr-4 font-medium text-[14px] tracking-[1px] md:text-[16px] md:tracking-[2px] lg:text-[17px] lg:tracking-[2.5px] leading-relaxed ${stepsUi.open ? '' : 'hidden'} ${stepsSide ? 'pl-8' : 'pl-2 pt-7'}`}
              >
                {steps.length > 0 ? (
                  <ol className="space-y-0.5">
                    {steps.map((line, i) => (
                      <li key={i} className="flex items-start gap-2" style={line.startsWith('Done') ? RESULT_STEP_SIZE : undefined}>
                        {(() => {
                          const result = line.startsWith('Done'), current = i === steps.length - 1;
                          return (
                            <>
                              <StepArrow color={result ? RESULT_STEP : current ? CURRENT_STEP : undefined} />
                              <span style={result ? RESULT_STEP_TEXT : current ? CURRENT_STEP_TEXT : STEP_TEXT}>{line}</span>
                            </>
                          );
                        })()}
                      </li>
                    ))}
                  </ol>
                ) : (
                  <p style={STEP_TEXT}>
                    {status || (isAnimating ? '' : ready ? 'Ready to explain...' : `${activeConfig.label} is not available yet.`)}
                  </p>
                )}
              </div>
            </div>
            </div>

          </div>
        </div>
      </main>
    </div>
  );
}