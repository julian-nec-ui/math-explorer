"use client";

import { useEffect, useRef, useState, type ReactElement } from 'react';
import { paced, pausableTimeout, CarryChip, CarryHop, OperandTag, Digit, HOP_MS, SumPop, type NumberData, doneMessage, formatNumber, ResultSign, ThousandsComma, commaAfter, pickVariant, toRem, useCellSize, lowerScale, lowerStyle, type BoardProps } from '../../math/shared';

interface Cell { value: number; id: string; col?: number; } // col: the dividend column a quotient digit sits under

// A row under the dividend: the product being subtracted, or the remainder (with brought-down digits).
// Digits are keyed by the dividend column they sit under (0 = leftmost digit).
interface WorkRow { id: string; kind: 'product' | 'rem'; y: number; cells: Record<number, Cell>; minusAt?: number; }
interface Line { id: string; y: number; from: number; to: number; }
interface Chip { id: string; col: number; side: 'left' | 'right'; rowY: number; value: number; fading: boolean; }
interface Mover { id: string; value: number; col: number; y: number; }


// The same room as in addition / subtraction (Julian): 6px between digits, 12px for a thousands comma (the shared
// comma glyph is 20px wide, so it is drawn 4px before its slot to stay centred in it)
const GAP = 6;
const COMMA_W = 12;
const COMMA_NUDGE = 4;
// Extra room where the decimal point sits between two digits (Julian): the 6px point then has 3px on each side
// (Julian chose 3px over 2px)
const DOT_ROOM = 6;

// The result (Julian): with a remainder (whole numbers: stop at the units and say what is left), or with decimals:
// the division goes on after the decimal point with brought-down zeros, for at most this many decimal places in the
// quotient (or until it comes out exact). Numbers with decimals always get a result with decimals
export type DivisionResult = 'remainder' | 'decimals';
const MAX_QUOTIENT_DECIMALS = 3;

// How the decimal points are moved before dividing:
//   classic  — by the divisor's decimal places, so the divisor becomes whole (the dividend may keep decimals)
//   equalize — both numbers get the same number of decimal places (the larger of the two), so both become whole
//   none     — not moved yet: the numbers as entered (shown before the explanation starts)
export type DivisionMethod = 'classic' | 'equalize';
type PlanMethod = DivisionMethod | 'none';

const ZERO = BigInt(0);
const TEN = BigInt(10);

// The whole division worked out in advance, so the layout knows every column and the quotient's length.
//   Dt / dt  — dividend digits and decimal places after moving the decimal point
//   Vt / vDec — divisor digits (leading zeros removed once moved; vOffset of them were removed) and the decimal
//              places it still has (only before moving)
//   intLen   — how many of Dt's digits are in the integer part
//   endCol   — last dividend column the division reaches (columns past Dt are brought-down zeros)
//   quotient / qDot — the quotient's digits as shown, and how many of them are in its integer part
// The numbers being divided are BigInts: with up to 12 digits and 4 decimals they can pass 2^53.
interface DivisionPlan {
  Dt: number[]; dt: number; Vt: number[]; vDec: number; vOffset: number; shift: number; divisor: bigint;
  intLen: number; decimalMode: boolean; k0: number; endCol: number;
  qcols: number[]; quotient: number[]; qDot: number; remainder: bigint;
}
const planDivision = (a: NumberData, b: NumberData, method: PlanMethod, result: DivisionResult = 'remainder'): DivisionPlan => {
  const shift = method === 'none' ? 0 : method === 'equalize' ? Math.max(a.decimalCount, b.decimalCount) : b.decimalCount;
  const Dt = [...a.digits, ...Array<number>(Math.max(0, shift - a.decimalCount)).fill(0)];
  const dt = Math.max(0, a.decimalCount - shift);
  const Vfull = [...b.digits, ...Array<number>(Math.max(0, shift - b.decimalCount)).fill(0)];
  const vDec = Math.max(0, b.decimalCount - shift);
  let vOffset = 0;
  if (method !== 'none') while (vOffset < Vfull.length - 1 && Vfull[vOffset] === 0) vOffset++;
  const Vt = Vfull.slice(vOffset);
  const divisor = BigInt(Vt.join('') || '0');
  const decimalMode = a.decimalCount > 0 || b.decimalCount > 0 || result === 'decimals';
  const intLen = Math.max(1, Dt.length - dt);
  const maxCol = decimalMode ? intLen - 1 + MAX_QUOTIENT_DECIMALS : Dt.length - 1;
  const at = (k: number) => BigInt(k < Dt.length ? Dt[k] : 0);
  const qcols: number[] = [];
  let k = 0;
  let cur = at(0);
  if (divisor > ZERO) {
    while (cur < divisor && k < maxCol) { qcols[k] = 0; k++; cur = cur * TEN + at(k); }
  }
  const k0 = k;
  let rem = cur;
  for (;;) {
    const q = divisor > ZERO ? cur / divisor : ZERO;
    qcols[k] = Number(q);
    rem = cur - q * divisor;
    if (k >= maxCol || (decimalMode && rem === ZERO && k >= Dt.length - 1)) break;
    k++;
    cur = rem * TEN + at(k);
  }
  const endCol = k;
  for (let c = 0; c <= endCol; c++) qcols[c] = qcols[c] ?? 0;
  const intDigits = qcols.slice(0, intLen);
  while (intDigits.length > 1 && intDigits[0] === 0) intDigits.shift();
  const quotient = [...intDigits, ...qcols.slice(intLen, endCol + 1)];
  return { Dt, dt, Vt, vDec, vOffset, shift, divisor, intLen, decimalMode, k0, endCol, qcols, quotient, qDot: intDigits.length, remainder: rem };
};
// The quotient shown after column `col` has been divided (same rules as the final quotient), each digit with the
// dividend column it sits under (place value: the quotient's units are under the dividend's units)
const quotientUpTo = (plan: DivisionPlan, col: number): { value: number; col: number }[] => {
  const cols = plan.qcols.slice(0, col + 1);
  const intPart = cols.slice(0, plan.intLen);
  let first = 0;
  while (first < intPart.length - 1 && intPart[first] === 0) first++;
  return cols.slice(first).map((value, t) => ({ value, col: first + t }));
};

interface DivisionBoardProps extends BoardProps { method?: DivisionMethod; result?: DivisionResult; }

// Long division: N1 : N2 = quotient, with the subtractions written under the dividend.
export default function DivisionBoard({ num1, num2, run, onStatus, onDone, renderSign, onCycleDigit, hoverEdit = false, method = 'classic', result = 'remainder', availableHeight }: DivisionBoardProps): ReactElement {
  const cell = useCellSize();
  const P = cell + GAP;
  // The numbers are shown as entered until the explanation moves their decimal points
  const [shifted, setShifted] = useState(false);
  const plan = planDivision(num1, num2, shifted ? method : 'none', result);
  const D = plan.Dt;                   // dividend columns (after moving the decimal point)
  const V = plan.Vt;                   // divisor digits (a whole number once the decimal points have moved)
  const cols = plan.endCol + 1;
  // Both numbers whole: decimals only in the result (see `result`)
  const wholeInputs = num1.decimalCount === 0 && num2.decimalCount === 0;        // dividend columns, including brought-down zeros after the last digit
  const n = V.length;
  const vInt = n - plan.vDec;          // the divisor's integer digits

  // Board coordinates (px). N1, then ":" and N2 under it, then "=" and the quotient, on every screen, all lined up by
  // place value: units under units, thousands separators under each other, decimal points under each other.
  // A digit's place value p is 0 for the units, 1 for the tens, …, −1 for the tenths, …
  // The quotient's digits sit under the dividend's columns they came from (so its decimal point is under the
  // dividend's), and the subtractions below use the dividend's columns too.
  const commaGap = COMMA_W + GAP;
  const S0 = 40 + GAP + 72; // operation-sign column, then room for the number signs
  const pD = (k: number): number => plan.intLen - 1 - k; // place value of dividend column k
  const pV = (t: number): number => vInt - 1 - t;        // place value of divisor digit t
  const pTop = Math.max(pD(0), pV(0));                   // the leftmost place value on the board
  const pBottom = Math.min(pD(Math.max(0, cols - 1)), pV(Math.max(0, n - 1)));
  // Left edge of the cell for place value p; a thousands separator follows the places 3, 6, 9, …
  const xp = (p: number): number => S0 + (pTop - p) * P + (Math.floor(Math.max(pTop, 0) / 3) - Math.floor(Math.max(p, 0) / 3)) * commaGap + (p < 0 && pTop >= 0 ? DOT_ROOM : 0);
  const x = (k: number): number => xp(pD(k));
  const xDiv = (t: number): number => xp(pV(t));
  // N1 starts 44px down, the same height as N1 in addition, subtraction and multiplication
  const yD = 44;
  const yV = yD + cell + 31;
  const yQ = yV + cell + 31;
  const yWork = yQ + cell + 8;
  // Like addition (Julian): the sign buttons 13px before the leftmost digit, "N1 ▶" / "N2 ▶" 8px before them, the ":"
  // and the "=" in the operation-sign column 50px before them (data-fit: see FitBoard)
  const signPos = (y: number) => ({ left: S0 - 45, top: y + (cell - 32) / 2 });
  const opLeft = S0 - 95;
  const colonPos = { left: opLeft + 7, top: (yD + cell + yV) / 2 - 12 };
  const eqPos = { left: opLeft + 2, top: (yV + cell + yQ) / 2 - cell / 2 };
  const qSignPos = { left: S0 - 53, top: yQ };
  const boardWidth = xp(pBottom) + cell + 4;

  const [rows, setRows] = useState<WorkRow[]>([]);
  const [lines, setLines] = useState<Line[]>([]);
  const [quot, setQuot] = useState<Cell[]>([]);
  const [hl, setHl] = useState<Set<string>>(new Set()); // `${row}:${column}`; "D" = dividend, "V" = divisor
  const [usedD, setUsedD] = useState<Set<number>>(new Set());
  const [chips, setChips] = useState<Chip[]>([]);
  // A borrow: the ten jumps from the digit on the left onto the digit that needs it (`hop`), which then shows for a
  // moment with the ten added, e.g. 13 (`pop`). Board px
  const [pop, setPop] = useState<{ x: number; y: number; text: string; lead: number; splitting: boolean } | null>(null);
  const [hop, setHop] = useState<{ x0: number; y0: number; x1: number; y1: number; key: string } | null>(null);
  const [mover, setMover] = useState<Mover | null>(null);
  const [fadingCells, setFadingCells] = useState<Set<string>>(new Set());
  const [qSign, setQSign] = useState<1 | -1 | null>(null);
  const [finalRow, setFinalRow] = useState<string | null>(null);

  // The animation reads the latest cell size through this ref; it is updated after every render
  const layout = useRef({ cell, yD, yWork, x });
  useEffect(() => {
    layout.current = { cell, yD, yWork, x };
  });

  useEffect(() => {
    if (!run) return;
    let alive = true;
    const wait = (ms: number) => new Promise<boolean>(resolve => pausableTimeout(() => resolve(alive), paced(ms)));
    let seq = 0;
    const id = (p: string) => `${p}${seq++}`;

    const dropFaded = () => window.setTimeout(() => { if (alive) setChips(prev => prev.filter(c => !c.fading)); }, 900);
    const addChip = (col: number, rowY: number) => {
      setChips(prev => [...prev.map(c => (c.side === 'right' ? { ...c, fading: true } : c)), { id: id('c'), col, side: 'left', rowY, value: 1, fading: false }]);
      dropFaded();
    };
    // The borrow taken from the digit on the left slides into that digit's top-right corner
    const moveIncoming = (col: number) => {
      setChips(prev => prev.map(c => {
        if (c.fading) return c;
        if (c.side === 'right') return { ...c, fading: true };
        return { ...c, col, side: 'right' };
      }));
      dropFaded();
    };
    const fadeAll = () => { setChips(prev => prev.map(c => ({ ...c, fading: true }))); dropFaded(); };

    (async () => {

      // React's strict mode (dev) mounts, cleans up and mounts again: let the throwaway run end here,

      // before it announces its first step (otherwise that step shows twice)

      await Promise.resolve();

      if (!alive) return;
      // The plan with the decimal points moved (the board shows the numbers as entered until the first step)
      const plan = planDivision(num1, num2, method, result);
      const D = plan.Dt;
      const cellPx = () => layout.current.cell;
      const divisor = plan.divisor;
      const at = (k: number) => (k < D.length ? D[k] : 0);
      const rowsLocal: WorkRow[] = [];
      const linesLocal: Line[] = [];
      const quotLocal: Cell[] = [];
      const used = new Set<number>();
      const pushRows = () => setRows(rowsLocal.map(r => ({ ...r, cells: { ...r.cells } })));
      const digitsOf = (v: bigint) => String(v).split('').map(Number);
      const places = (k: number) => `${k} decimal place${k === 1 ? '' : 's'}`;
      const fmt = (x: NumberData) => {
        const i = x.digits.length - x.decimalCount;
        return x.digits.slice(0, i).join('') + (x.decimalCount ? '.' + x.digits.slice(i).join('') : '');
      };
      const dividendText = plan.dt ? `${D.slice(0, D.length - plan.dt).join('')}.${D.slice(D.length - plan.dt).join('')}` : D.join('');

      if (plan.shift > 0) {
        const s = plan.shift;
        onStatus(method === 'equalize'
          ? `${fmt(num1)} has ${places(num1.decimalCount)} and ${fmt(num2)} has ${places(num2.decimalCount)}. We give both the same number of decimal places, ${s}, and move the decimal point ${s} place${s > 1 ? 's' : ''} to the right in both numbers (zeros fill the empty places). Both become whole numbers and the quotient stays the same: ${dividendText} ÷ ${divisor}.`
          : `The divisor has ${places(s)}, so we move the decimal point ${s} place${s > 1 ? 's' : ''} to the right in both numbers. Now the divisor is a whole number: ${dividendText} ÷ ${divisor}.`);
        setShifted(true);
        if (!(await wait(3200))) return;
      } else {
        setShifted(true);
      }
      onStatus(`We divide by ${divisor}, taking the digits of N1 from left to right.`);
      // Start: 30% longer (1600 → 2080 ms, and the first step the same)
      if (!(await wait(2080))) return;

      // First number: take digits until the divisor fits into it
      let k = plan.k0;
      let cur = ZERO;
      for (let c = 0; c <= k; c++) cur = cur * TEN + BigInt(at(c));
      let minRow = 'D';
      let minRowY = layout.current.yD;
      let minStart = 0;
      const takenCols = Array.from({ length: k + 1 }, (_, i) => i);
      setHl(new Set(takenCols.map(c => `D:${c}`)));
      onStatus(k === 0 ? `We start with ${cur}.` : `${cur / TEN} is smaller than ${divisor}, so we take one more digit: ${cur}.`);
      if (!(await wait(k === 0 ? 2080 : 1600))) return;

      let yCursor = layout.current.yWork;

      for (;;) {
        const q = Number(cur / divisor);
        const prod = BigInt(q) * divisor;
        const rem = cur - prod;
        const minCols = Array.from({ length: k - minStart + 1 }, (_, i) => minStart + i);
        setHl(new Set([...minCols.map(c => `${minRow}:${c}`), 'V']));
        onStatus(q > 0
          ? `How many times does ${divisor} fit into ${cur}? ${q} time${q > 1 ? 's' : ''}, because ${q} × ${divisor} = ${prod}.`
          : `${divisor} doesn't fit into ${cur}, so we write 0 in the quotient.`);
        if (!(await wait(1800))) return;
        // The quotient so far, with its decimal point once the division reaches the dividend's decimals
        const shown = quotientUpTo(plan, k);
        quotLocal.splice(0, quotLocal.length, ...shown.map(d => ({ value: d.value, col: d.col, id: `q${d.col}` })));
        setQuot([...quotLocal]);
        if (!(await wait(800))) return;

        let value = cur;
        if (q > 0) {
          // The product, written under the current number
          const pd = digitsOf(prod);
          const pStart = k - pd.length + 1;
          const product: WorkRow = { id: id('r'), kind: 'product', y: yCursor + 16, cells: {}, minusAt: pStart };
          pd.forEach((v: number, t: number) => { product.cells[pStart + t] = { value: v, id: id('p') }; });
          rowsLocal.push(product);
          pushRows();
          yCursor = product.y + cellPx();
          onStatus(`Write ${prod} under ${cur} and subtract.`);
          if (!(await wait(1100))) return;
          linesLocal.push({ id: id('l'), y: yCursor + 8, from: Math.min(minStart, pStart), to: k });
          setLines([...linesLocal]);
          yCursor += 8 + 3;

          // The subtraction, digit by digit from the right, with borrows
          const remRow: WorkRow = { id: id('r'), kind: 'rem', y: yCursor + 8, cells: {} };
          rowsLocal.push(remRow);
          yCursor = remRow.y + cellPx();
          const curDigits = digitsOf(cur);
          const curAt = (c: number) => curDigits[c - (k - curDigits.length + 1)] ?? 0;
          const prodAt = (c: number) => product.cells[c]?.value ?? 0;
          let borrow = 0;
          for (let c = k; c >= minStart; c--) {
            setHl(new Set([`${minRow}:${c}`, `${product.id}:${c}`]));
            moveIncoming(c);
            if (!(await wait(1000))) return;
            const md = curAt(c);
            const pdd = prodAt(c);
            const raw = md - pdd - borrow;
            const next = raw < 0 ? 1 : 0;
            const digit = raw < 0 ? raw + 10 : raw;
            const left = borrow ? `${md} − 1` : `${md}`;
            onStatus(next ? `${left} is less than ${pdd} → borrow 10: ${md + 10 - borrow} − ${pdd} = ${digit}` : `${left} − ${pdd} = ${digit}`);
            if (next) {
              // The ten jumps from the digit on the left onto this one, which shows for a moment with the ten added
              const { x: X, cell: cl } = layout.current;
              // (just above the digit, so the digit itself stays readable)
              const cx = X(c) + cl / 2, cy = minRowY - 16;
              setHop({ x0: X(c - 1) + cl / 2, y0: minRowY + cl / 2, x1: cx, y1: cy, key: id('h') });
              if (!(await wait(HOP_MS))) return;
              setHop(null);
              const withTen = String(md - borrow + 10);
              setPop({ x: cx, y: cy, text: withTen, lead: withTen.length > 1 ? 1 : 0, splitting: false });
              if (!(await wait(1000))) return;
              setPop(prev => (prev ? { ...prev, splitting: true } : prev));
            }
            remRow.cells[c] = { value: digit, id: id('d') };
            pushRows();
            if (!(await wait(next ? 600 : 900))) return;
            setPop(null);
            borrow = next;
            if (borrow) {
              addChip(c, minRowY);
              if (!(await wait(900))) return;
            }
          }
          fadeAll();
          setHl(new Set());

          // Leading zeros of the remainder disappear (at least one digit stays)
          const fadeCols: number[] = [];
          for (let c = minStart; c < k; c++) {
            if (remRow.cells[c]?.value === 0) fadeCols.push(c); else break;
          }
          if (fadeCols.length) {
            setFadingCells(new Set(fadeCols.map(c => `${remRow.id}:${c}`)));
            if (!(await wait(900))) return;
            fadeCols.forEach(c => { delete remRow.cells[c]; });
            pushRows();
            setFadingCells(new Set());
          }
          value = rem;
          minRow = remRow.id;
          minRowY = remRow.y;
          minStart = k - String(rem).length + 1;
        }

        for (let c = 0; c <= k; c++) used.add(c);
        setUsedD(new Set(used));
        if (k >= plan.endCol) { cur = value; break; }
        k++;

        // Bring the next dividend digit down next to the remainder
        const target = rowsLocal.find(r => r.id === minRow);
        if (!target) { cur = value; break; }
        const down = at(k);
        onStatus(k >= D.length
          ? 'No digits are left, so we bring down a 0 and continue after the decimal point.'
          : k === plan.intLen && plan.intLen < D.length
            ? `We reach the decimal point, so the quotient gets one too. Bring down the next digit, ${down}.`
            : `Bring down the next digit, ${down}.`);
        setHl(new Set([`D:${k}`]));
        const mv = { id: id('m'), value: down, col: k, y: layout.current.yD };
        setMover(mv);
        if (!(await wait(60))) return;
        setMover({ ...mv, y: minRowY });
        if (!(await wait(750))) return;
        if (value === ZERO) {
          // A remainder of 0 is not written in front of the brought-down digit
          const zeroCols = Object.keys(target.cells).map(Number);
          zeroCols.forEach(c => { delete target.cells[c]; });
        }
        target.cells[k] = { value: down, id: id('d') };
        pushRows();
        setMover(null);
        used.add(k);
        setUsedD(new Set(used));
        cur = value * TEN + BigInt(down);
        minStart = k - String(cur).length + 1;
        if (!(await wait(800))) return;
      }

      setHl(new Set());
      setFinalRow(minRow);
      const qDigits = plan.quotient.join('');
      const qDecimals = plan.quotient.length - plan.qDot;
      const qs = (/[1-9]/.test(qDigits) ? num1.sign * num2.sign : 1) as 1 | -1;
      setQSign(qs);
      const quotientText = formatNumber(qDigits, qDecimals, qs);
      if (plan.decimalMode) {
        // With decimals we keep dividing after the decimal point instead of giving a remainder
        onStatus(doneMessage(quotientText, cur === ZERO ? '' : ` (we stop after ${qDecimals} decimal place${qDecimals === 1 ? '' : 's'})`));
      } else {
        // As in JavaScript and C: the remainder takes the sign of the dividend
        onStatus(doneMessage(
          quotientText,
          cur === ZERO ? ' (no remainder)' : `, remainder ${formatNumber(String(cur), 0, num1.sign)}`,
        ));
      }
      onDone();
    })();

    return () => { alive = false; setPop(null); setHop(null); };
    // The board runs once, on mount; a reset remounts it (through `key`)
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const bottom = Math.max(yWork, ...rows.map(r => r.y + cell), ...lines.map(l => l.y + 3));
  const width = boardWidth;
  // The subtractions shrink when the finished board would not fit the area's height (see lowerScale). Known in advance:
  // every quotient digit other than 0 writes a product, a line and a difference (16 + cell + 11 + 8 + cell px)
  const steps = planDivision(num1, num2, method, result).qcols.filter(q => q > 0).length;
  const finalBottom = yWork + steps * (2 * cell + 35);
  const ls = lowerScale(availableHeight, yWork, finalBottom + 16);
  // The box keeps the room for the rows still to come (like multiplication), so its height is the final one from the
  // start: the rows can't push it taller during the explanation, and FitBoard can fit the height in advance
  const height = yWork + (Math.max(bottom, finalBottom) + 16 - yWork) * ls;
  // Where something drawn at board px (x, y) in the work area ends up once it is shrunk (towards the top right corner)
  const lowX = (left: number) => width - (width - left) * ls;
  const lowY = (top: number) => yWork + (top - yWork) * ls;
  const glyph = 'absolute flex items-center justify-center text-3xl font-light text-cyan-500';
  // A decimal point in the gap after the cell at `left`
  const decimalPoint = (left: number, y: number, key: string) => (
    <div key={key} className="absolute z-20 w-1.5 h-1.5 rounded-full bg-cyan-300 shadow-[0_0_4px_rgba(103,232,249,0.9)]" style={toRem({ left: left + cell + (GAP + DOT_ROOM) / 2 - 3, top: y + cell - 9 })} />
  );
  const chipLeft = (c: Chip) => (c.side === 'left' ? x(c.col) - 4 : x(c.col) + cell - 16);
  // Borrows (in the corners of the top digits), the ten that jumps and the number it makes: in the work area (`low`,
  // drawn inside the shrinking layer) or on N1 itself, when the first subtraction is done right under the dividend
  const renderBorrows = (low: boolean) => (
    <>
      {chips.filter(c => (c.rowY >= yWork) === low).map(c => (
        <div
          key={c.id}
          className={`absolute z-40 origin-bottom-right transition-[left,opacity,scale] duration-650 ease-in-out ${c.fading ? 'opacity-0' : 'opacity-100'} ${c.side === 'right' ? 'scale-80' : 'scale-100'}`}
          style={toRem({ left: chipLeft(c), top: c.rowY - 12 })}
        >
          <CarryChip value={c.value} kind="borrow" />
        </div>
      ))}
      {pop && (pop.y >= yWork) === low && <SumPop x={pop.x} y={pop.y} text={pop.text} lead={pop.lead} kind="borrow" splitting={pop.splitting} />}
      {hop && (hop.y0 >= yWork) === low && <CarryHop key={hop.key} x0={hop.x0} y0={hop.y0} x1={hop.x1} y1={hop.y1} value={10} kind="borrow" />}
    </>
  );

  return (
    <div className="relative mx-auto" style={toRem({ width, height })}>
      {/* N1 (the dividend), after moving the decimal point. Zeros added for the shift, and the zeros brought down
          after its last digit, are drawn as ghost cells; only N1's own digits can be turned */}
      {Array.from({ length: cols }, (_, k) => {
        const own = k < num1.digits.length;
        // Whole numbers divided with decimals (Julian): N1 keeps no decimal point and no row of zeros after it; a zero
        // shows there only for the moment it is brought down
        if (!own && wholeInputs && !hl.has(`D:${k}`)) return null;
        return (
          <div key={`a${k}`} className="absolute" style={toRem({ left: x(k), top: yD })}>
            <Digit
              digit={k < D.length ? D[k] : 0}
              variant={pickVariant({ highlighted: hl.has(`D:${k}`), computed: own && usedD.has(k), ghost: !own })}
              isNum1
              onIncrement={() => onCycleDigit('n1', k, 1)}
              onDecrement={() => onCycleDigit('n1', k, -1)}
              hoverEditable={hoverEdit && own}
              operand
            />
          </div>
        );
      })}
      {cols > 0 && <div data-fit className="absolute" style={toRem(signPos(yD))}>{renderSign('n1', num1.sign)}</div>}
      {cols > 0 && <div data-fit className="absolute -translate-x-full -translate-y-1/2" style={toRem({ left: S0 - 53, top: yD + cell / 2 })}><OperandTag label="N1" color="text-cyan-400" /></div>}
      {Array.from({ length: plan.intLen }, (_, k) => commaAfter(k, plan.intLen) && <ThousandsComma key={`kd${k}`} left={x(k) + cell + GAP - COMMA_NUDGE} top={yD + cell - 28} />)}
      {cols > plan.intLen && !wholeInputs && decimalPoint(x(plan.intLen - 1), yD, 'pd')}
      {V.map((_, t) => t < vInt && commaAfter(t, vInt) && <ThousandsComma key={`kv${t}`} left={xDiv(t) + cell + GAP - COMMA_NUDGE} top={yV + cell - 28} />)}
      {plan.vDec > 0 && decimalPoint(xDiv(vInt - 1), yV, 'pv')}
      {quot.map((c, t) => t + 1 < quot.length && commaAfter(c.col ?? 0, plan.intLen) && <ThousandsComma key={`kq${t}`} left={x(c.col ?? 0) + cell + GAP - COMMA_NUDGE} top={yQ + cell - 28} />)}
      {quot.some(c => (c.col ?? 0) >= plan.intLen) && decimalPoint(x(plan.intLen - 1), yQ, 'pq')}

      {/* The division sign: two thick dots */}
      <svg data-fit className="absolute text-cyan-500" style={toRem({ ...colonPos, width: 10, height: 24 })} viewBox="0 0 10 24" aria-label="divided by">
        <circle cx="5" cy="5" r="4" fill="currentColor" />
        <circle cx="5" cy="19" r="4" fill="currentColor" />
      </svg>

      {/* N2 (the divisor) */}
      {n > 0 && <div data-fit className="absolute" style={toRem(signPos(yV))}>{renderSign('n2', num2.sign)}</div>}
      {n > 0 && <div data-fit className="absolute -translate-x-full -translate-y-1/2" style={toRem({ left: S0 - 53, top: yV + cell / 2 })}><OperandTag label="N2" color="text-pink-400" /></div>}
      {V.map((v: number, t: number) => {
        // Zeros added when the decimal points move (equalize) are ghost cells; only N2's own digits can be turned
        const own = t + plan.vOffset < num2.digits.length;
        return (
          <div key={`b${t}`} className="absolute" style={toRem({ left: xDiv(t), top: yV })}>
            <Digit
              digit={v}
              variant={pickVariant({ highlighted: hl.has('V'), computed: false, ghost: !own })}
              isNum1={false}
              onIncrement={() => onCycleDigit('n2', t + plan.vOffset, 1)}
              onDecrement={() => onCycleDigit('n2', t + plan.vOffset, -1)}
              hoverEditable={hoverEdit && own}
              operand
            />
          </div>
        );
      })}

      <div data-fit className={glyph} style={toRem({ ...eqPos, width: 20, height: cell })}>=</div>

      {/* The quotient */}
      {qSign !== null && (
        <div className="absolute flex items-center" style={toRem({ ...qSignPos, height: cell })}>
          <ResultSign sign={qSign} />
        </div>
      )}
      {quot.map(c => (
        <div key={c.id} className="absolute animate-pop-in" style={toRem({ left: x(c.col ?? 0), top: yQ })}>
          <Digit digit={c.value} variant="result" />
        </div>
      ))}

      {/* The work area under the quotient: drawn smaller towards the right when needed (ls, see above) */}
      <div className="absolute inset-0 pointer-events-none" style={lowerStyle(ls, width, yWork)}>
      {/* The subtractions */}
      {rows.map(r => (
        <div key={r.id}>
          {r.kind === 'product' && r.minusAt !== undefined && (
            <div className="absolute flex items-center justify-center text-2xl font-light text-zinc-400" style={toRem({ left: x(r.minusAt) - 30, top: r.y, width: 20, height: cell })}>−</div>
          )}
          {Object.entries(r.cells).map(([key, c]) => {
            const col = Number(key);
            const isFinal = finalRow === r.id;
            const variant = hl.has(`${r.id}:${col}`) ? 'highlight' : isFinal ? 'result' : r.kind === 'product' ? 'computed' : 'idle';
            return (
              <div key={c.id} className="absolute" style={toRem({ left: x(col), top: r.y })}>
                <div className={fadingCells.has(`${r.id}:${col}`) ? 'animate-fade-out' : 'animate-pop-in'}>
                  <Digit digit={c.value} variant={variant} />
                </div>
              </div>
            );
          })}
        </div>
      ))}
      {/* "Remainder ▶" on the left of what is left at the end, centred on its row (Julian); whole-number divisions only
          (with decimals the division goes on after the point instead) */}
      {(() => {
        const r = !plan.decimalMode && finalRow ? rows.find(w => w.id === finalRow) : undefined;
        const cs = r ? Object.keys(r.cells).map(Number) : [];
        return r && cs.length > 0 && (
          <div data-fit className="absolute -translate-x-full -translate-y-1/2 animate-pop-in" style={toRem({ left: x(Math.min(...cs)) - 13, top: r.y + cell / 2 })}>
            <OperandTag label="Remainder" color="text-amber-400" />
          </div>
        );
      })()}
      {lines.map(l => (
        <div key={l.id} className="absolute h-0.75 bg-zinc-600 rounded-full" style={toRem({ left: x(l.from) - 4, top: l.y, width: x(l.to) + cell - x(l.from) + 8 })} />
      ))}
      {renderBorrows(true)}
      </div>

      {/* The digit being brought down: from N1 (full size) down to its row, shrinking with the work area */}
      {mover && (() => {
        const low = mover.y >= yWork;
        return (
          <div
            className="absolute z-40 origin-top-left transition-[top,left,scale] duration-700 ease-in-out"
            style={{ ...toRem({ left: low ? lowX(x(mover.col)) : x(mover.col), top: low ? lowY(mover.y) : mover.y }), scale: String(low ? ls : 1) }}
          >
            <Digit digit={mover.value} variant="highlight" />
          </div>
        );
      })()}

      {renderBorrows(false)}
    </div>
  );
}

