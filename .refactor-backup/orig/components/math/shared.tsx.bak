"use client";

import { useEffect, useRef, useState, useSyncExternalStore, type CSSProperties, type PointerEvent as ReactPointerEvent, type ReactElement, type ReactNode } from 'react';

export type MathOp = 'addition' | 'subtraction' | 'multiplication' | 'division' | 'fractions';
export type NumberType = 'integer' | 'float';
export type BadgeKind = 'carry' | 'borrow';
export type DigitVariant = 'highlight' | 'ghostHighlight' | 'result' | 'computed' | 'ghost' | 'idle' | 'input';

// A number as its digits (integer part first, then decimals), how many of them are decimals, and its sign
export interface NumberData { digits: number[]; decimalCount: number; sign: 1 | -1; }

// Fractions: each numerator and denominator is its own number (1 to 6 digits, one slider each); the signs of the two
// fractions are the signs of N1 and N2
export type FracPart = 'n1' | 'd1' | 'n2' | 'd2';
export type FractionParts = Record<FracPart, NumberData>;
export const FRAC_PARTS: FracPart[] = ['n1', 'd1', 'n2', 'd2'];

// What the multiplication and division boards receive from MathExplorer
export interface BoardProps {
  num1: NumberData;
  num2: NumberData;
  run: boolean;
  onStatus: (text: string) => void;
  onDone: () => void;
  renderSign: (which: 'n1' | 'n2', sign: 1 | -1) => ReactNode;
  onCycleDigit: (which: 'n1' | 'n2', index: number, direction: 1 | -1) => void;
  hoverEdit?: boolean;
  availableWidth?: number;
  // How much wider (px) the steps window is than its usual width, beside the board (0 = usual or narrower, closed, or
  // under the board): addition / subtraction shrink their board in the same proportion as the board area
  stepsExtra?: number;
  // Room (px) on the left of the board area the board may move into (desktop): up to 15px from the controls column
  leftRoom?: number;
  // The steps window is collapsed (beside the board or under it): the board can sit in the middle of all the room
  stepsClosed?: boolean;
  // The middle of the page (px from the board area's left content edge)
  pageMidX?: number;
  // The board area's height (nominal px): multiplication and division shrink what is under their operands to fit it
  availableHeight?: number;
  // The steps window is opening / closing and the board's size or place changes with it: glide there (600ms)
  smoothFit?: boolean;
  // Reports the width the board needs at full size (nominal px), to tell whether the steps window's width affects it
  onNaturalWidth?: (w: number) => void;
}

// Digit cells: 36px on phones, 43px from the md breakpoint (48rem) up
export const CELL_W = 'w-9 md:w-10.75';
export const CELL = 'w-9 h-9 md:w-10.75 md:h-10.75';
export const GAP = 11;
export const REM_PX = 16;

// Step delay (Julian): extra time after each step of an explanation (each new line in the steps window), chosen on
// the page (0, 0.5, 1, 1.5 or 2 s). The page adds it to `owed` when it shows a step; the board's next pause takes it
// (`paced`), so the step stays on screen that much longer; the animations themselves keep their speed
export const STEP_DELAYS_MS = [0, 500, 1000, 1500, 2000];
export const pace = { stepMs: 0, owed: 0 };
export const paced = (ms: number): number => {
  const extra = pace.owed;
  pace.owed = 0;
  return ms + extra;
};

// Pause / Resume (Julian): every board's pauses go through `pausableTimeout`; pausing stops those timers (keeping what
// was left of each) and freezes every running animation on the page (CSS animations and transitions, and the
// Web Animations of the hops), exactly where they are; resuming starts them all again from there
interface PausableTimer { fn: () => void; due: number; remaining: number; id: number }
const timers = new Set<PausableTimer>();
const frozen = new Set<Animation>();
export const pauseState = { paused: false };
export const pausableTimeout = (fn: () => void, ms: number): void => {
  const t: PausableTimer = { fn, due: performance.now() + ms, remaining: ms, id: 0 };
  const fire = () => { timers.delete(t); fn(); };
  t.fn = fire;
  if (!pauseState.paused) t.id = window.setTimeout(fire, ms);
  timers.add(t);
};
export const pauseAll = (): void => {
  if (pauseState.paused) return;
  pauseState.paused = true;
  const now = performance.now();
  timers.forEach(t => { window.clearTimeout(t.id); t.remaining = Math.max(0, t.due - now); });
  document.getAnimations().forEach(a => { if (a.playState === 'running') { a.pause(); frozen.add(a); } });
};
export const resumeAll = (): void => {
  if (!pauseState.paused) return;
  pauseState.paused = false;
  const now = performance.now();
  timers.forEach(t => { t.due = now + t.remaining; t.id = window.setTimeout(t.fn, t.remaining); });
  frozen.forEach(a => { try { a.play(); } catch { /* gone */ } });
  frozen.clear();
};
export const COMMA_W = 20;

// Pixel geometry written as rem, so the boards scale with the root font size
// What is under the operands (multiplication: the partial products and the sum; division: the subtractions) is drawn
// smaller when the whole board would not fit the board area's height (Julian): only as much as needed, never below 70%;
// past that it stays at 70% and the area scrolls. `top` is where the smaller part starts, `bottom` where the board ends
// at full size (board px). Worked out from the board's final height, so the digits keep one size for the whole explanation.
// 16 = the frame's bottom padding (pb-4)
export const MIN_LOWER_SCALE = 0.7;
export const lowerScale = (available: number | undefined, top: number, bottom: number): number => {
  if (!available || bottom <= top) return 1;
  const s = (available - 16 - top) / (bottom - top);
  return Math.max(MIN_LOWER_SCALE, Math.min(1, Math.floor(s * 100) / 100));
};
// The transform that shrinks that part towards its top right corner (`right`, `top`): the units stay under the units
export const lowerStyle = (s: number, right: number, top: number): CSSProperties => (s < 1
  ? { transform: `scale(${s})`, transformOrigin: `${right / REM_PX}rem ${top / REM_PX}rem` }
  : {});

export const toRem = (style: Record<string, number>): CSSProperties => {
  const out: Record<string, string> = {};
  for (const [k, v] of Object.entries(style)) out[k] = `${v / REM_PX}rem`;
  return out as CSSProperties;
};

// Thousands separators in a number of `len` digits: how many come before digit `k` (0 = leftmost),
// and whether one follows digit `k`
export const commasBefore = (k: number, len: number): number => Math.floor((len - 1) / 3) - Math.floor((len - 1 - k) / 3);
export const commaAfter = (k: number, len: number): boolean => k < len - 1 && (len - 1 - k) % 3 === 0;

// A random number with `count` digits (no leading zero). A float gets `decimals` decimal places (default 2,
// at most 4), keeping at least one digit before the point
export const computeNumber = (count: number, type: NumberType, options: { decimals?: number } = {}): NumberData => {
  const { decimals = 2 } = options;
  const digits: number[] = [];
  for (let i = 0; i < count; i++) digits.push(i === 0 && count > 1 ? Math.floor(Math.random() * 9) + 1 : Math.floor(Math.random() * 10));
  const decimalCount = type === 'float' ? Math.max(0, Math.min(decimals, 4, count - 1)) : 0;
  return { digits, decimalCount, sign: 1 };
};

export const intLength = (n: NumberData): number => n.digits.length - n.decimalCount;

// Removes leading zeros from the integer part (at least one integer digit stays)
export const cleanNumber = (n: NumberData): NumberData => {
  const intLen = Math.max(1, intLength(n));
  let k = 0;
  while (k < intLen - 1 && n.digits[k] === 0) k++;
  return { ...n, digits: n.digits.slice(k) };
};

const VARIANT: Record<DigitVariant, string> = {
  highlight: 'bg-linear-to-br from-yellow-400 to-orange-500 text-zinc-900 border-yellow-300 scale-110 shadow-[0_0_20px_rgba(250,204,21,0.6)] z-30',
  result: 'bg-linear-to-br from-cyan-400 to-blue-500 text-zinc-900 border-cyan-300 scale-105 shadow-[0_0_15px_rgba(34,211,238,0.5)]',
  computed: 'bg-linear-to-br from-slate-600 to-slate-800 text-slate-200 border-slate-500 shadow-inner',
  ghost: 'bg-transparent text-zinc-600 border-dashed border-zinc-700',
  // A placeholder 0 (added when a row moves left, or brought down after the last digit) in a highlighted column (Julian):
  // it stays a dashed placeholder, only its border takes the highlight's yellow
  ghostHighlight: 'bg-transparent text-zinc-600 border-dashed border-yellow-400 scale-110 z-30',
  idle: 'bg-zinc-800 text-zinc-400 border-zinc-700',
  // The operands' digits (N1, N2) before they are used: a blue gradient made like the result's (light at the top left,
  // darker at the bottom right), from #004d80 to #002e4d. Over it, so the whole button looks slightly domed (curved on
  // every side, not only one like the drum): a soft light at the top left and edges that darken all the way round
  input: 'bg-[image:radial-gradient(ellipse_75%_60%_at_35%_22%,rgba(255,255,255,0.28),transparent_70%),radial-gradient(ellipse_at_center,transparent_48%,rgba(0,0,0,0.42)_100%),linear-gradient(to_bottom_right,#004d80,#002e4d)] text-zinc-200 border-[#0a5d94]',
};

export const pickVariant = (s: { highlighted: boolean; computed: boolean; ghost: boolean }): DigitVariant =>
  s.highlighted ? (s.ghost ? 'ghostHighlight' : 'highlight') : s.ghost ? 'ghost' : s.computed ? 'computed' : 'input';

// A digit that rolls up or down (the shorter way round) when its value changes
// `text`: what to show instead of the value itself (the step delay drum shows 0.5 for its value 1, …)
function RollingDigit({ value, text }: { value: number; text?: string }): ReactElement {
  const [shown, setShown] = useState({ value, dir: 0 });
  if (shown.value !== value) setShown({ value, dir: (value - shown.value + 10) % 10 <= 5 ? 1 : -1 });
  const anim = shown.dir === 1 ? 'animate-roll-up' : shown.dir === -1 ? 'animate-roll-down' : '';
  return (
    <span className="relative inline-block h-[1em] overflow-hidden leading-none">
      <span key={`${shown.value}-${shown.dir}`} className={`block ${anim}`}>{text ?? shown.value}</span>
    </span>
  );
}

// ---------- The steel drum used to change a digit ----------

const MAX_ANGLE = 90;
// Degrees between rows of holes: 13, so the arrows' tip rows (±6, at 78°) are on the visible front too (Julian: one
// more dot at the head of each arrow)
const HOLE_STEP = 13;
// How far from the middle the rows reach (% of the drum's height): 39.5, so the last dot stays clear of the top and
// bottom edges (Julian: ~4px; it was 42, then one more pixel each way)
const HOLE_REACH = 39.5;
const HOLE_COLS = 4;

// Hole pattern on the drum: green rows above the middle (count up, #00e600), red rows below (count down, #ff0f6f).
// Only the arrows' shafts are holes; their heads are drawn as a V of two straight lines (see ARROW_HEAD, Julian: like
// the steps window's open / close arrow)
// The shaft: 4 rows of 2 holes right up to the V: the 4th stops a hair before the V's outer (dark) edge, never under
// it (Julian; measured 0.4–0.5px, at right angles to the line, in his Chrome). The two shafts are about one dot
// further apart in the middle than before (Julian), so the rows are a little closer together
const SHAFT_ROWS = [1.21, 2.09, 2.98, 3.86];
const SHAFT_COLS = [1, 2];
// The V: from the outer columns at row ±4 to the middle at row ±6 (the tip)
const ARROW_HEAD = { base: 4, tip: 6 };
const HEAD_COLOR: Record<'green' | 'red', { stroke: string; glow: string; light: string }> = {
  green: { stroke: '#1fe61f', glow: 'rgba(0, 230, 0, 0.9)', light: '#d6ffd6' },
  red: { stroke: '#ff1a76', glow: 'rgba(255, 15, 111, 0.9)', light: '#ffd6e6' },
};
type HoleColor = 'green' | 'red' | 'blue';
const glowOf = (row: number) => Math.min(1, Math.abs(row) / 6);

const HOLE_BG: Record<HoleColor, string> = {
  green: 'radial-gradient(circle at 35% 30%, #f0fff0, #66ff66 22%, #00e600 48%, #007a00 85%)',
  red: 'radial-gradient(circle at 35% 30%, #fff0f6, #ff6ba6 22%, #ff0f6f 48%, #a3003f 85%)',
  blue: 'radial-gradient(circle at 35% 30%, #eaf6ff, #5cc2ff 22%, #0a8dff 48%, #0046b3 85%)',
};
const HOLE_SHADOW: Record<HoleColor, string> = {
  green: '0 0 0 0.5px rgba(0, 0, 0, 0.7), 0 0 4px 0.5px rgba(0, 230, 0, 1)',
  red: '0 0 0 0.5px rgba(0, 0, 0, 0.7), 0 0 4px 0.5px rgba(255, 15, 111, 1)',
  blue: '0 0 0 0.5px rgba(0, 0, 0, 0.7), 0 0 4px 0.5px rgba(10, 141, 255, 1)',
};
const HOLE_BG_HOT: Record<'green' | 'red', string> = {
  green: 'radial-gradient(circle at 35% 30%, #dcffdc, #1aff1a 25%, #00d600 50%, #005c00 88%)',
  red: 'radial-gradient(circle at 35% 30%, #ffd9e8, #ff1a76 25%, #e6005c 50%, #6b0027 88%)',
};
const holeStyle = (row: number, color: HoleColor): CSSProperties => {
  if (color === 'blue') return { background: HOLE_BG.blue, boxShadow: HOLE_SHADOW.blue, filter: 'none' };
  const g = glowOf(row);
  const rgb = color === 'green' ? '0, 230, 0' : '255, 15, 111';
  return {
    background: g >= 0.8 ? HOLE_BG_HOT[color] : HOLE_BG[color],
    boxShadow: `0 0 0 0.5px rgba(0, 0, 0, 0.75), 0 0 ${2 + 2 * g}px ${0.3 + 0.5 * g}px rgba(${rgb}, ${0.6 + 0.4 * g})`,
    filter: `saturate(${0.75 + 0.9 * g}) brightness(${0.8 + 0.35 * g})`,
  };
};

// Mouse cursor while counting: a copy of the system's up/down cursor (two black triangles with a white edge), where the
// triangle of the direction being counted is filled with a bright metallic white. Drawn at 1x and 2x (retina).
// Same bases (10px wide, 4px apart); the tips are 7% higher, so the triangles are a little taller and sharper
const cursorPair = (active: 1 | -1, scale: 1 | 2): string => {
  const fill = (on: boolean) => (on ? 'url(#m)' : '#000');
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${24 * scale}" height="${24 * scale}" viewBox="0 0 24 24">`
    + '<defs><linearGradient id="m" x1="0" y1="0" x2="0.6" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="0.45" stop-color="#f2f5f8"/><stop offset="0.8" stop-color="#c3cdd6"/><stop offset="1" stop-color="#a7b3bd"/></linearGradient>'
    + '<filter id="s" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="0.6" stdDeviation="0.6" flood-color="#000" flood-opacity="0.45"/></filter></defs>'
    + '<g filter="url(#s)" stroke="#fff" stroke-width="1.6" stroke-linejoin="round">'
    + `<path d="M12 2.5 17 10H7Z" fill="${fill(active === 1)}"/><path d="M7 14H17L12 21.5Z" fill="${fill(active === -1)}"/></g></svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
};
const cursorFor = (active: 1 | -1) =>
  `-webkit-image-set(${cursorPair(active, 1)} 1x, ${cursorPair(active, 2)} 2x) 12 12, ${active === 1 ? 'n-resize' : 's-resize'}`;
const CURSOR_UP = cursorFor(1);
const CURSOR_DOWN = cursorFor(-1);

// How far the holes turn, at most: a fifth of the drum's angle, up to 8°, so an arrow moves a little but never
// leaves the frame
const HOLES_MAX_TURN = 8;

// The rows of holes on the front of the drum. Green (count up) and red (count down) are drawn on two layers:
// while counting in one direction (`dir`), only that arrow is shown; both are back when the mouse is released
// fadeUp / fadeDown: that arrow is pale (a count drum at its highest / lowest value: that way does nothing)
// Where a row is (% of the drum's height), with the drum turned by `angle`: half the drum's curve, half even steps, so
// the rows near the edges don't crowd together as much
const rowTop = (row: number, angle: number): number => {
  const a = ((row * HOLE_STEP - angle) * Math.PI) / 180;
  return 50 + HOLE_REACH * (0.5 * Math.sin(a) + (0.5 * (a * 180) / Math.PI) / (6 * HOLE_STEP));
};
const colLeft = (col: number): number => 14 + (col * 72) / (HOLE_COLS - 1);

function DrumHoles({ angle: drumAngle, dir, fadeUp = false, fadeDown = false }: { angle: number; dir: 0 | 1 | -1; fadeUp?: boolean; fadeDown?: boolean }): ReactElement {
  const angle = Math.max(-HOLES_MAX_TURN, Math.min(HOLES_MAX_TURN, drumAngle / 5));
  const out: Record<'green' | 'red', ReactElement[]> = { green: [], red: [] };
  for (const row of SHAFT_ROWS.flatMap(r => [-r, r])) {
    const color: 'green' | 'red' = row < 0 ? 'green' : 'red';
    const a = ((row * HOLE_STEP - angle) * Math.PI) / 180;
    const depth = Math.cos(a);
    if (depth <= 0.08) continue;
    const top = rowTop(row, angle);
    for (const col of SHAFT_COLS) {
      out[color].push(
        <div
          key={`${row}:${col}`}
          className="absolute -translate-x-1/2 -translate-y-1/2 rounded-full"
          style={{ left: `${colLeft(col)}%`, top: `${top}%`, width: '0.18rem', height: `${0.15 * (0.35 + 0.65 * depth)}rem`, opacity: 0.55 + 0.45 * depth, ...holeStyle(row, color) }}
        />,
      );
    }
  }
  // The arrow heads: two straight lines meeting at the tip, round joins and ends (the join doesn't show)
  for (const color of ['green', 'red'] as const) {
    const sign = color === 'green' ? -1 : 1;
    const yb = rowTop(sign * ARROW_HEAD.base, angle), yt = rowTop(sign * ARROW_HEAD.tip, angle);
    const { stroke, glow } = HEAD_COLOR[color];
    out[color].push(
      // A dark edge under it, the colour, and a thin light line along the middle: sharper and more like a lit tube
      <svg key="head" className="absolute inset-0 w-full h-full overflow-visible" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" shapeRendering="geometricPrecision" style={{ filter: `drop-shadow(0 0 1px ${glow})` }}>
        {[['rgba(0,0,0,0.6)', 3.6], [stroke, 2.2], [HEAD_COLOR[color].light, 0.7]].map(([c, w]) => (
          <polyline key={String(w)} points={`${colLeft(0)},${yb} ${colLeft(1.5)},${yt} ${colLeft(3)},${yb}`} fill="none" stroke={String(c)} strokeWidth={Number(w)} strokeLinecap="round" strokeLinejoin="round" vectorEffect="non-scaling-stroke" />
        ))}
      </svg>,
    );
  }
  const layer = (color: 'green' | 'red', hidden: boolean, faded: boolean) => (
    <div className="absolute inset-0 transition-opacity duration-200 ease-out" style={{ opacity: hidden ? 0 : faded ? 0.45 : 1 }}>{out[color]}</div>
  );
  return <>{layer('green', dir === -1, fadeUp)}{layer('red', dir === 1, fadeDown)}</>;
}

// ---------- Turning the drum with a mouse wheel or a two-finger swipe on a trackpad (Mac and Windows) ----------

// Both send `wheel` events. A gesture = wheel events with less than WHEEL_GAP_MS between them (a trackpad's inertia
// included). The drum takes a gesture only if it began at least WHEEL_ARM_MS after the drum opened, so a page scroll
// that carries a digit under the pointer keeps scrolling the page, to its end
const WHEEL_GAP_MS = 220;
const WHEEL_ARM_MS = 300;
const WHEEL_STEP_PX = 40;   // trackpad: the swipe distance for one step
const WHEEL_NOTCH_PX = 50;  // a gesture starting with a jump this big (or counted in lines/pages) is a mouse wheel
const WHEEL_MIN_MS = 70;
const NUDGE_HOLD_MS = 450; // after a wheel or keyboard step the white arrow of the cursor stays this long    // at most one step every 70 ms, so a fast flick can't spin through every digit
// When the current gesture began, for the whole page: measured before any drum sees the event (capture phase)
const wheelClock = { last: 0, start: 0, on: false };
const startWheelClock = () => {
  if (wheelClock.on || typeof window === 'undefined') return;
  wheelClock.on = true;
  window.addEventListener('wheel', () => {
    const t = performance.now();
    if (t - wheelClock.last > WHEEL_GAP_MS) wheelClock.start = t;
    wheelClock.last = t;
  }, { capture: true, passive: true });
};
const isMac = () => typeof navigator !== 'undefined' && /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
// Which way a wheel gesture counts. deltaY > 0 = the page content would move up.
// Mac (Julian's choice): scrolling up counts up, down counts down, with the trackpad and the mouse (deltaY < 0 = up
// with natural scrolling, the default; Safari says when it is off and the sign is turned around).
// Windows / Linux: fingers up on a precision touchpad (natural scrolling, their default) and the wheel rolled away
// from you on a mouse count up
const wheelDirection = (deltaSign: 1 | -1, notch: boolean, e: WheelEvent): 1 | -1 => {
  const natural = (e as WheelEvent & { webkitDirectionInvertedFromDevice?: boolean }).webkitDirectionInvertedFromDevice;
  if (isMac()) return (natural === false ? deltaSign : -deltaSign) as 1 | -1;
  if (notch) return -deltaSign as 1 | -1;
  return deltaSign;
};

// Press the top of the holes to count up, the bottom to count down; hold or drag to keep counting; or turn it with
// the mouse wheel / two fingers on a trackpad while it is open
// `ends`: a count drum (it stops at min / max, and the arrow that can't go further is pale); `text`: what it shows
// `textSize`: one size for every value of a count drum (decided by its longest text), so 0, 0.5 and 1 look alike
// `textStyle`: an extra style for one value's text (the step delay's 2 is 7% bigger: alone it looks smaller)
function DigitDrum({ value, onStep, open = false, min = 0, max = 9, label, ends = false, text, textSize = '', textStyle }: { value: number; onStep: (dir: 1 | -1) => void; open?: boolean; min?: number; max?: number; label?: string; ends?: boolean; text?: string; textSize?: string; textStyle?: CSSProperties }): ReactElement {
  const [angle, setAngleState] = useState(0);
  const angleRef = useRef(0);
  // The direction being counted (1 up, -1 down, 0 none): only that arrow is shown, and the cursor points that way
  const [dir, setDir] = useState<0 | 1 | -1>(0);
  const stepRef = useRef(onStep);
  const dragRef = useRef<{ startY: number; base: number } | null>(null);
  const repeatRef = useRef(0);
  const rafRef = useRef(0);
  useEffect(() => { stepRef.current = onStep; });
  const setAngle = (a: number) => { angleRef.current = a; setAngleState(a); };
  const stopSpring = () => { if (rafRef.current) cancelAnimationFrame(rafRef.current); rafRef.current = 0; };
  const stopRepeat = () => { window.clearTimeout(repeatRef.current); repeatRef.current = 0; };
  useEffect(() => () => { stopSpring(); stopRepeat(); }, []);
  // One step with the drum turned a little that way, then back (keyboard arrows and the wheel). The arrow of that
  // direction (and the white triangle of the cursor) stays at least NUDGE_HOLD_MS after the last step
  const holdRef = useRef(0);
  const nudge = (d: 1 | -1) => {
    stepRef.current(d);
    stopSpring();
    setDir(d);
    setAngle(d * 30);
    holdRef.current = performance.now() + NUDGE_HOLD_MS;
    springBack();
  };
  const nudgeRef = useRef(nudge);
  useEffect(() => { nudgeRef.current = nudge; });

  // The wheel: only while the drum is open, and only for a gesture that began after it opened (see WHEEL_ARM_MS)
  const rootRef = useRef<HTMLDivElement>(null);
  const openRef = useRef(open);
  const openedAt = useRef(0);
  useEffect(() => {
    openRef.current = open;
    if (open) openedAt.current = performance.now();
  }, [open]);
  useEffect(() => {
    startWheelClock();
    const el = rootRef.current;
    if (!el) return;
    const w = { gesture: -1, acc: 0, notch: false, first: false, lastStep: 0 };
    const onWheel = (e: WheelEvent) => {
      // Pinch-zoom (sent as ctrl + wheel) and sideways swipes stay with the page; so does a drag in progress
      if (!openRef.current || dragRef.current || e.ctrlKey || e.deltaY === 0 || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
      if (wheelClock.start < openedAt.current + WHEEL_ARM_MS) return;
      e.preventDefault(); // the page doesn't scroll while the drum turns
      e.stopPropagation();
      const px = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * 400 : e.deltaY;
      if (w.gesture !== wheelClock.start) {
        w.gesture = wheelClock.start;
        w.acc = 0;
        w.notch = e.deltaMode !== 0 || Math.abs(px) >= WHEEL_NOTCH_PX;
        w.first = true; // the first movement of a gesture counts at once
      }
      w.acc += px;
      const now = performance.now();
      if (!(w.first || w.notch || Math.abs(w.acc) >= WHEEL_STEP_PX) || now - w.lastStep < WHEEL_MIN_MS) return;
      const sign: 1 | -1 = (w.notch ? px : w.acc) > 0 ? 1 : -1;
      w.first = false;
      w.acc = 0;
      w.lastStep = now;
      nudgeRef.current(wheelDirection(sign, w.notch, e));
    };
    el.addEventListener('wheel', onWheel, { passive: false });
    return () => el.removeEventListener('wheel', onWheel);
  }, []);

  // Springs back to the rest position after release
  const springBack = () => {
    stopSpring();
    let a = angleRef.current, v = 0;
    const tick = () => {
      v += -0.16 * a - 0.24 * v;
      a += v;
      if (Math.abs(a) < 0.3 && Math.abs(v) < 0.3 && performance.now() >= holdRef.current) { setAngle(0); setDir(0); rafRef.current = 0; return; }
      setAngle(a);
      rafRef.current = requestAnimationFrame(tick);
    };
    rafRef.current = requestAnimationFrame(tick);
  };
  const dirOf = (a: number): 0 | 1 | -1 => (a > 8 ? 1 : a < -8 ? -1 : 0);
  // While held, keeps counting; the further the drum is turned, the faster
  const repeat = () => {
    if (!dragRef.current) return;
    const d = dirOf(angleRef.current);
    if (d) stepRef.current(d);
    repeatRef.current = window.setTimeout(repeat, Math.max(70, 330 - Math.abs(angleRef.current) * 2.9));
  };
  const onDown = (e: ReactPointerEvent<HTMLDivElement>) => {
    e.preventDefault();
    e.stopPropagation();
    e.currentTarget.setPointerCapture(e.pointerId);
    stopSpring();
    stopRepeat();
    const r = e.currentTarget.getBoundingClientRect();
    const dir: 1 | -1 = e.clientY < r.top + r.height / 2 ? 1 : -1;
    dragRef.current = { startY: e.clientY, base: dir * 40 };
    setDir(dir);
    setAngle(dir * 40);
    stepRef.current(dir);
    repeatRef.current = window.setTimeout(repeat, 450);
  };
  const onMove = (e: ReactPointerEvent<HTMLDivElement>) => {
    const d = dragRef.current;
    if (!d) return;
    const a = Math.max(-MAX_ANGLE, Math.min(MAX_ANGLE, d.base + (d.startY - e.clientY) * 1.5));
    setAngle(a);
    // Dragged past the middle the other way: the other arrow (and cursor) takes over
    const nd = dirOf(a);
    if (nd) setDir(nd);
  };
  // Released: both arrows come back
  const onUp = () => { dragRef.current = null; stopRepeat(); setDir(0); springBack(); };

  return (
    <div
      ref={rootRef}
      role="spinbutton"
      tabIndex={0}
      aria-label={label ?? 'Press the top of the holes to count up and the bottom to count down; hold to keep counting, or scroll'}
      aria-valuenow={value}
      aria-valuemin={min}
      aria-valuemax={max}
      onKeyDown={e => {
        if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
        e.preventDefault();
        nudge(e.key === 'ArrowUp' ? 1 : -1);
      }}
      onClick={e => e.stopPropagation()}
      // The up/down cursor over the whole drum (the digit too), not only over the holes: its arrow of the direction
      // being counted is filled white while pressing, dragging or scrolling, and both are black again when it stops
      className="absolute inset-0 rounded-sm cursor-ns-resize select-none overflow-hidden focus-visible:outline-2 focus-visible:outline-cyan-400"
      style={dir ? { cursor: dir === 1 ? CURSOR_UP : CURSOR_DOWN } : undefined}
    >
      <div className="absolute inset-0 bg-linear-to-b from-zinc-950 via-zinc-600 to-zinc-900" />
      <div className="absolute inset-0 bg-linear-[180deg,transparent_14%,rgba(255,255,255,0.32)_28%,transparent_38%,rgba(0,0,0,0.3)_55%,rgba(255,255,255,0.22)_70%,transparent_82%]" />
      <div className="absolute -left-1 top-0 bottom-0 w-2 rounded-[50%] bg-linear-to-r from-zinc-900 to-zinc-500 shadow-[inset_-1px_0_1px_rgba(255,255,255,0.6)]" />
      <div className="absolute inset-y-0 left-1 w-[62%] bg-linear-to-r from-zinc-300/0 via-zinc-300/20 to-zinc-300/0" />
      <div className="absolute inset-y-[18%] left-1 w-[62%] bg-linear-to-b from-transparent via-white/14 to-transparent blur-[1px]" />
      <div className="absolute inset-y-0 left-1 w-[58%] flex items-center justify-center text-2xl font-black text-zinc-950 text-shadow-[0_1px_0_rgba(255,255,255,0.45)]">
        <span className={textSize} style={textStyle}><RollingDigit value={value} text={text} /></span>
      </div>
      <div onPointerDown={onDown} onPointerMove={onMove} onPointerUp={onUp} onPointerCancel={onUp} className={`absolute inset-y-0 right-0 w-[38%] touch-none ${dir === 1 ? 'cursor-n-resize' : dir === -1 ? 'cursor-s-resize' : 'cursor-ns-resize'}`} style={dir ? { cursor: dir === 1 ? CURSOR_UP : CURSOR_DOWN } : undefined}>
        <DrumHoles angle={angle} dir={dir} fadeUp={ends && value >= max} fadeDown={ends && value <= min} />
      </div>
    </div>
  );
}

// How many digits a number gets (instead of a slider): the same steel drum as a digit, always open (no three dots),
// in the frame of an open digit (the number's colour, dark background). min … max, never past them. Wider when it can
// show two digits (10 to 12)
// `format`: what it shows for a value (the step delay: 0, 0.5, 1, 1.5); the drum is as wide as its longest text.
// At min the red (down) arrow is pale, at max the green one (Julian)
export function CountDrum({ value, min, max, onChange, color, disabled = false, label, format = String, textStyle }: { value: number; min: number; max: number; onChange: (v: number) => void; color: 'cyan' | 'pink'; disabled?: boolean; label: string; format?: (v: number) => string; textStyle?: (v: number) => CSSProperties | undefined }): ReactElement {
  // The longest text of ALL its values (not only min and max: 0 … 2 has 0.5 and 1.5 in between)
  let longest = 0;
  for (let v = min; v <= max; v++) longest = Math.max(longest, format(v).length);
  const step = (dir: 1 | -1) => {
    const v = Math.max(min, Math.min(max, value + dir));
    if (v !== value) onChange(v);
  };
  return (
    <div
      className={`relative ${longest >= 3 ? 'w-16' : longest === 2 ? 'w-14' : 'w-11'} h-10 shrink-0 rounded-md border-2 overflow-hidden bg-zinc-900 shadow-[0_2px_6px_rgba(0,0,0,0.5)] transition-opacity ${color === 'cyan' ? 'border-cyan-500' : 'border-pink-500'} ${disabled ? 'opacity-40 pointer-events-none' : ''}`}
      inert={disabled}
    >
      <div className="absolute inset-0 rounded-sm overflow-hidden">
        <DigitDrum value={value} onStep={step} open={!disabled} min={min} max={max} label={label} ends text={format(value)} textSize={longest >= 3 ? 'text-[25px]' : ''} textStyle={textStyle?.(value)} />
      </div>
    </div>
  );
}

interface DigitProps {
  digit: number;
  variant: DigitVariant;
  isNum1?: boolean;
  onIncrement?: () => void;
  onDecrement?: () => void;
  hoverEditable?: boolean;
  operand?: boolean;
  // A smaller cell (36px everywhere) with a bigger digit (24px; 26px for a result), so the digit fills its square
  // better (fractions' calculations)
  compact?: boolean;
}

// A digit cell. An editable operand digit turns into a steel drum: with a mouse when the pointer is over it,
// on a phone or tablet when it is tapped (another tap outside it closes the drum)
export function Digit({ digit, variant, isNum1 = true, onIncrement, onDecrement, hoverEditable = false, operand = false, compact = false }: DigitProps): ReactElement {
  const [open, setOpen] = useState(false);
  const [leaving, setLeaving] = useState(false);
  const closeTimer = useRef(0);
  const rootRef = useRef<HTMLDivElement>(null);
  const clearClose = () => { window.clearTimeout(closeTimer.current); closeTimer.current = 0; };
  useEffect(() => () => clearClose(), []);
  const show = () => { clearClose(); setLeaving(false); setOpen(true); };
  const hide = () => { clearClose(); setLeaving(true); closeTimer.current = window.setTimeout(() => setOpen(false), 750); };

  const visible = open && !leaving;
  // Touch: a tap anywhere outside the open drum closes it
  useEffect(() => {
    if (!visible || !hoverEditable) return;
    const onDown = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' && rootRef.current && !rootRef.current.contains(e.target as Node)) hide();
    };
    document.addEventListener('pointerdown', onDown);
    return () => document.removeEventListener('pointerdown', onDown);
  }, [visible, hoverEditable]);

  // Only a click (or a tap) on the three dots opens the drum; hovering does nothing. Once open, it stays open until
  // the pointer leaves the whole digit (or, on touch, until a tap outside it)
  const handlers = hoverEditable
    ? { onPointerLeave: (e: ReactPointerEvent<HTMLDivElement>) => { if (e.pointerType === 'mouse') hide(); } }
    : {};
  const dotHandlers = {
    onClick: () => { if (!visible) show(); },
  };
  const step = (dir: 1 | -1) => { if (dir === 1) onIncrement?.(); else onDecrement?.(); };

  if (hoverEditable) {
    const frame = visible ? `${isNum1 ? 'border-cyan-500' : 'border-pink-500'} bg-zinc-900` : VARIANT[variant];
    const fade: CSSProperties = { transitionDuration: '750ms' };
    return (
      <div ref={rootRef} {...handlers} className={`${CELL} shrink-0 relative rounded-md border-2 overflow-hidden shadow-[0_2px_6px_rgba(0,0,0,0.5)] transition-[border-color,background-color] ease-in-out ${frame}`} style={fade}>
        <div className="absolute inset-0 rounded-sm overflow-hidden flex items-center justify-center font-extrabold text-[26px] md:text-[30px] transition-opacity ease-in-out" style={{ opacity: visible ? 0 : 1, ...fade }}>
          <span className="translate-y-1.75"><RollingDigit value={digit} /></span>
          {/* Three small steel dots: click them to change this digit. With a mouse only the dots themselves react (13×3 px,
              plus 1 px around them: 15×5 px); on a touch screen the area stays bigger (24×20 px), so a finger can hit it */}
          <div aria-hidden="true" {...dotHandlers} className="absolute top-[3px] right-[3px] w-[15px] h-[5px] flex justify-center items-center gap-0.5 cursor-pointer pointer-coarse:top-0 pointer-coarse:right-0 pointer-coarse:w-6 pointer-coarse:h-5 pointer-coarse:pt-1 pointer-coarse:pr-1 pointer-coarse:justify-end pointer-coarse:items-start">
            {[0, 1, 2].map(i => (
              <span key={i} className="block size-[3px] rounded-full bg-[radial-gradient(circle_at_35%_30%,#f4f7fa,#cfdae3_45%,#9aa9b5_85%,#6b7b88)] shadow-[0_0_1px_rgba(0,0,0,0.6)]" />
            ))}
          </div>
        </div>
        <div className={`absolute inset-0 rounded-sm overflow-hidden transition-opacity ease-in-out ${visible ? '' : 'pointer-events-none'}`} style={{ opacity: visible ? 1 : 0, ...fade }} inert={!visible}>
          <DigitDrum value={digit} onStep={step} open={visible} />
        </div>
      </div>
    );
  }

  return (
    <div {...handlers} className="shrink-0">
      <div className={`${compact ? 'w-9 h-9' : CELL} shrink-0 flex items-center justify-center rounded-md border-2 font-extrabold ${compact ? (variant === 'result' ? 'text-[26px]' : 'text-[24px]') : variant === 'result' ? 'text-[28px] md:text-[32px]' : operand ? 'text-[22px] md:text-[25px]' : 'text-lg md:text-xl'} transition-all duration-700 relative ${VARIANT[variant]}`}>
        <RollingDigit value={digit} />
      </div>
    </div>
  );
}

// "N1 ▶" / "N2 ▶" on the left of a number's sign button: the label, 8px of room, and an arrow pointing at the number
// (the same triangle as the arrows in the steps window), both in the number's colour; 8px from the button
export const OperandTag = ({ label, color }: { label: string; color: string }): ReactElement => (
  <span className={`flex items-center gap-2 font-bold uppercase whitespace-nowrap text-[9px] tracking-[1.5px] ${color}`}>
    {label}
    <svg viewBox="0 0 10 12" aria-hidden="true" className="h-2.5 w-auto shrink-0"><path d="M0 0 10 6 0 12z" fill="currentColor" /></svg>
  </span>
);

export const OpIcon = ({ op }: { op: MathOp }): ReactElement => (
  <svg viewBox="0 0 24 24" className="w-5 h-5 md:w-6 md:h-6 block" fill="none" stroke="currentColor" strokeWidth="1.75" aria-hidden="true">
    {op === 'addition' && <path d="M0 12h24M12 0v24" />}
    {op === 'subtraction' && <path d="M0 12h24" />}
    {op === 'multiplication' && <path d="M1 1l22 22M23 1 1 23" />}
    {op === 'division' && (
      <>
        <path d="M0 12h24" />
        <circle cx="12" cy="4.5" r="2" fill="currentColor" stroke="none" />
        <circle cx="12" cy="19.5" r="2" fill="currentColor" stroke="none" />
      </>
    )}
    {op === 'fractions' && <path d="M19 0 5 24" />}
  </svg>
);

// The cell size in px follows the same breakpoint as CELL (md = 48rem)
const MD_QUERY = '(min-width: 48rem)';
const subscribeMd = (cb: () => void) => {
  const mq = window.matchMedia(MD_QUERY);
  mq.addEventListener('change', cb);
  return () => mq.removeEventListener('change', cb);
};
const isMd = () => window.matchMedia(MD_QUERY).matches;
const isMdServer = () => false;
export function useCellSize(): number {
  return useSyncExternalStore(subscribeMd, isMd, isMdServer) ? 43 : 36;
}

// The green carry chips are 50% bigger than the red borrow ones (Julian): 30px with a 24px digit (15px, then 60% bigger), against 20px / 10px
export const CARRY_CHIP = 30;
export const BORROW_CHIP = 20;
export const chipSize = (kind: BadgeKind): string => (kind === 'borrow' ? 'w-5 h-5 text-[10px] rounded-md' : 'w-7.5 h-7.5 text-[24px] leading-none rounded-lg');
export const CarryChip = ({ value, kind }: { value: number; kind: BadgeKind }): ReactElement => (
  <div className={`${chipSize(kind)} flex items-center justify-center font-black shadow-[0_0_10px_rgba(0,0,0,0.35)] border animate-pop-in ${kind === 'borrow' ? 'bg-red-600 border-red-400 text-white' : 'bg-green-600 border-green-400 text-white'}`}>
    {value}
  </div>
);

// ---------- Carries and borrows that move where you can see them ----------

// How long a carry (or a borrowed ten) takes to jump from one place to another
export const HOP_MS = 950;
// Coordinates are px: real screen px for `fixed` (measured with getBoundingClientRect), board px (written as rem,
// like the rest of the board) otherwise
const hopUnit = (v: number, fixed: boolean) => (fixed ? `${v}px` : `${v / REM_PX}rem`);

// A chip jumping in an arc (a curve over both ends) from (x0, y0) to (x1, y1), centres. It starts big and lands at
// the size of a carry / borrow chip. Green for a carry, red for a borrow
// `duration`: how long the jump takes (fractions jump more slowly, so a child can follow each number).
// `endScale`: the size it lands at (it starts at 1.6; 1 = the size of a carry chip; fractions land at 1.28, only 20%
// smaller than at the start). `fadeOutMs`: it fades out during its last fadeOutMs (0 = it doesn't), so what it brings
// can appear in its place at the same time. `wide`: the square grows sideways with its text (24, 2³), keeping the
// same room on the left and right as above and below (otherwise it is a fixed 20px square, as for the carries)
export function CarryHop({ x0, y0, x1, y1, value, kind = 'carry', fixed = false, duration = HOP_MS, endScale = 1, fadeOutMs = 0, wide = false }: { x0: number; y0: number; x1: number; y1: number; value: number | string; kind?: BadgeKind; fixed?: boolean; duration?: number; endScale?: number; fadeOutMs?: number; wide?: boolean }): ReactElement {
  const ref = useRef<HTMLDivElement>(null);
  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const peak = Math.min(y0, y1) - 46;
    // Half its size, to centre it on the path, in the unit of the path (screen px when fixed, board px otherwise)
    const k = fixed ? 1 : (parseFloat(getComputedStyle(document.documentElement).fontSize) || REM_PX) / REM_PX;
    const half = el.offsetWidth / 2 / k || 10;
    const halfH = el.offsetHeight / 2 / k || 10;
    const frames: Keyframe[] = [];
    for (let i = 0; i <= 16; i++) {
      const t = i / 16, u = 1 - t;
      const x = u * u * x0 + 2 * u * t * ((x0 + x1) / 2) + t * t * x1;
      const y = u * u * y0 + 2 * u * t * (2 * peak - (y0 + y1) / 2) + t * t * y1;
      frames.push({ transform: `translate(${hopUnit(x - half, fixed)}, ${hopUnit(y - halfH, fixed)}) scale(${1.6 + (endScale - 1.6) * t})`, opacity: fadeOutMs ? Math.min(1, ((1 - t) * duration) / fadeOutMs) : 1, offset: t });
    }
    const a = el.animate(frames, { duration: reduce ? 1 : duration, easing: 'ease-in-out', fill: 'forwards' });
    return () => a.cancel();
  }, [x0, y0, x1, y1, fixed, duration, endScale, fadeOutMs]);
  return (
    <div
      ref={ref}
      className={`${fixed ? 'fixed' : 'absolute'} left-0 top-0 z-100 pointer-events-none ${wide ? 'min-w-5 px-1.5 whitespace-nowrap h-5 text-[10px] rounded-md' : chipSize(kind)} flex items-center justify-center font-black text-white border ${kind === 'borrow' ? 'bg-red-600 border-red-400 shadow-[0_0_12px_rgba(248,113,113,0.6)]' : 'bg-green-600 border-green-400 shadow-[0_0_12px_rgba(74,222,128,0.6)]'}`}
      style={{ transform: `translate(${hopUnit(x0 - (wide || kind === 'borrow' ? 10 : CARRY_CHIP / 2), fixed)}, ${hopUnit(y0 - (wide || kind === 'borrow' ? 10 : CARRY_CHIP / 2), fixed)}) scale(1.6)` }}
    >
      {value}
    </div>
  );
}

// A number shown for a moment, centred on (x, y): a column's sum (e.g. 16: the carry 1 in green, 6 in white) or,
// in a subtraction, the top digit with the borrowed ten (e.g. 13: the borrowed 1 in red). `lead` = how many of its
// first characters are the carry / borrowed ten. When `splitting`, the coloured part goes and the rest shrinks away
// `extra`: shown after the number in the carry colour, smaller (multiplication: "42 + 3", the carry being added)
export function SumPop({ x, y, text, lead, kind = 'carry', splitting = false, fixed = false, extra }: { x: number; y: number; text: string; lead: number; kind?: BadgeKind; splitting?: boolean; fixed?: boolean; extra?: string }): ReactElement {
  return (
    <div className={`${fixed ? 'fixed' : 'absolute'} z-90 pointer-events-none -translate-x-1/2 -translate-y-1/2 flex items-baseline font-black text-[30px] leading-none animate-pop-in`} style={{ left: hopUnit(x, fixed), top: hopUnit(y, fixed) }}>
      {lead > 0 && (
        <span className={`transition-opacity duration-200 ${splitting ? 'opacity-0' : 'opacity-100'} ${kind === 'borrow' ? 'text-red-400 drop-shadow-[0_0_8px_rgba(248,113,113,0.7)]' : 'text-green-400 drop-shadow-[0_0_8px_rgba(74,222,128,0.7)]'}`}>{text.slice(0, lead)}</span>
      )}
      <span className={`text-white drop-shadow-[0_0_8px_rgba(255,255,255,0.5)] transition-[opacity,scale] duration-500 ${splitting ? 'opacity-0 scale-75' : 'opacity-100'}`}>{text.slice(lead)}</span>
      {/* Above the number, outside the flow: the number stays centred where its digit goes, and the "+ 3" covers
          neither the digits already written on its right nor the row below */}
      {extra && <span className="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 text-[22px] leading-none text-green-400 drop-shadow-[0_0_8px_rgba(74,222,128,0.7)] whitespace-nowrap animate-pop-in">{extra}</span>}
    </div>
  );
}

export const COMMA_STYLE = 'inline-block translate-y-0.5 font-black text-2xl leading-7 bg-linear-[180deg,#e6f6fd_50%,#a5ddf3_61%,#63c3e9_72%,#2f8fb8_85%,#b3e4f7_100%] bg-clip-text text-transparent drop-shadow-[0_0_3px_rgba(99,195,233,0.5)]';

export const ThousandsComma = ({ left, top }: { left: number; top: number }): ReactElement => (
  <div className="absolute w-5 flex justify-center leading-7" style={toRem({ left, top })} aria-hidden="true">
    <span className={COMMA_STYLE}>,</span>
  </div>
);

export const ResultSign = ({ sign }: { sign: 1 | -1 }): ReactElement => (
  <div className={`w-10 flex items-center justify-center text-[42px] leading-none font-bold transition-colors duration-700 ${sign === -1 ? 'text-pink-400' : 'text-cyan-400'}`}>
    {sign === 1 ? '+' : '-'}
  </div>
);

// "1234567" with 2 decimals → "12,345.67"; a minus sign only when the number isn't zero
export const formatNumber = (digits: string, decimals = 0, sign: 1 | -1 = 1): string => {
  const intPart = (decimals ? digits.slice(0, digits.length - decimals) : digits) || '0';
  const decPart = decimals ? digits.slice(digits.length - decimals) : '';
  const grouped = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return `${sign < 0 && /[1-9]/.test(digits) ? '−' : ''}${grouped}${decPart ? `.${decPart}` : ''}`;
};

export const doneMessage = (result: string, extra = ''): string => `Done!  Result = ${result}${extra}`;

export const numberValue = (n: NumberData): number => Number(n.digits.join('') || '0');
