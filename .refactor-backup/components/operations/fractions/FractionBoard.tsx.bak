"use client";

import { Fragment, useEffect, useLayoutEffect, useRef, useState, type ReactElement, type ReactNode } from 'react';
import { paced, pausableTimeout, CarryHop, Digit, OpIcon, doneMessage, numberValue, type BoardProps, type DigitVariant, type FracPart, type FractionParts } from '../../math/shared';

// Fractions: two fractions, each numerator and denominator its own number of 1 to 6 digits (one slider each in the
// page; every digit turns with the steel drum). The ± buttons (N1's and N2's signs) give each fraction its sign; each
// signed fraction sits in round brackets, so (+2/3) + (−1/4) shows the subtraction.
// The explanation: a common denominator (lists of multiples), amplification (top and bottom times the same number),
// one long fraction line under all the numerators and their signs, then the sum, simplifying and a mixed number.

interface Frac { n: number; d: number; s: 1 | -1; }
// A fraction being amplified (×k) or simplified (÷k): the chip beside it, then the old values crossed out in red
// with the new ones written small next to them
interface Mark { k: number; crossed: boolean; n: number; d: number; }
interface Hop { x0: number; y0: number; x1: number; y1: number; value: number | string; key: string; }

// The numbers jump more slowly than the carries of the other operations (950 ms), with a short pause after each
// jump, so a child can follow every number
const FR_HOP_MS = 1700;
const FR_HOP_PAUSE = 400;
// A jumping number shrinks only 20% (from 1.6 to 1.28 times a chip), so it stays easy to read
const FR_HOP_END = 1.28;
// The landing: the number it brings starts to appear (blurred, then sharp) FR_LAND_MS before the jump ends, while the
// jumping square fades out, so there is never a moment with nothing on the screen
const FR_LAND_MS = 300;
// A mixed number with up to this many wholes is split piece by piece ((8 + 8 + 7)/8); more wholes are written as a
// product ((8 × 9 + 8)/9)
const MAX_WHOLE_PIECES = 3;
// Fit to the board area: the whole board shrinks down to 75% at most; the gap between the parts of the row (gap-x-5)
const MIN_FIT = 0.75;
const EXPR_GAP = 20;

// While a denominator is 0 the page keeps Explain to Me and Redo disabled (see `blocked` in operations/registry), and
// the board shows its warning
export const hasZeroDenominator = (fr: FractionParts): boolean =>
  (['d1', 'd2'] as const).some(k => fr[k].digits.length > 0 && numberValue(fr[k]) === 0);
// How many cells the list of multiples would have (without building it: the numbers can be big)
const listLength = (d: number, k: number): number => (d === 1 && k > 2 ? 3 : k);

// The multiples of a denominator up to the common one. A denominator of 1 doesn't list 1, 2, 3, 4, 5: it shows 1 … 5
// (its first multiple, dots — null —, the common one)
const listOf = (d: number, k: number): (number | null)[] =>
  d === 1 && k > 2 ? [1, null, k] : Array.from({ length: k }, (_, i) => d * (i + 1));
// Lists of multiples up to this long are shown; when one would be longer, the LCM is found by prime factorization
const MAX_MULTIPLES = 7;

// The prime factors of n with their powers, e.g. 12 → 2² × 3 = [{ p: 2, e: 2 }, { p: 3, e: 1 }] (1 → none)
const primeFactors = (n: number): { p: number; e: number }[] => {
  const out: { p: number; e: number }[] = [];
  for (let p = 2; n > 1; p++) {
    let e = 0;
    while (n % p === 0) { n /= p; e++; }
    if (e) out.push({ p, e });
  }
  return out;
};
// 2 and 3 → "2³" (for the status line and the jumping square)
const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';
const powerText = (p: number, e: number): string => (e > 1 ? `${p}${[...String(e)].map(c => SUP[Number(c)]).join('')}` : `${p}`);

// A cell of the prime factorization: a factor (2), a power (2³ with a small raised 3) or a value; green when picked
// for the LCM. It fades in blurred -> sharp
function FactorChip({ p, e = 1, pick = false, hidden = false, refFn }: { p: number; e?: number; pick?: boolean; hidden?: boolean; refFn?: (el: HTMLSpanElement | null) => void }): ReactElement {
  return (
    <span ref={refFn} className={`min-w-6.5 h-6.5 px-1 text-xs sm:min-w-8 sm:h-7 sm:px-1.5 sm:text-sm flex items-center justify-center rounded-md border font-black transition-[color,background-color,border-color,box-shadow,opacity,filter] duration-300 ${hidden ? 'opacity-0 blur-sm' : 'opacity-100 blur-none'} ${pick ? 'bg-green-600 border-green-400 text-white shadow-[0_0_12px_rgba(74,222,128,0.6)]' : 'bg-zinc-800 border-zinc-700 text-zinc-300'}`}>
      {/* inline text, so the small power is raised next to its base (2³), not put under it */}
      <span className="leading-none">{p}{e > 1 && <sup className="ml-px text-[0.68em]">{e}</sup>}</span>
    </span>
  );
}
const Mul = ({ hidden = false }: { hidden?: boolean }): ReactElement => (
  <span className={`text-sm font-black text-zinc-500 transition-opacity duration-300 ${hidden ? 'opacity-0' : 'opacity-100'}`}>×</span>
);
const SmallEq = (): ReactElement => <span className="px-0.5 text-sm font-black text-zinc-400 animate-pop-in">=</span>;

// A tall round bracket around a signed fraction: ( +2/3 )
const Bracket = ({ side }: { side: 'left' | 'right' }): ReactElement => (
  <svg viewBox="0 0 14 100" preserveAspectRatio="none" aria-hidden="true" className="w-3.5 self-stretch my-5 text-zinc-400 shrink-0">
    <path d={side === 'left' ? 'M12 2 Q1 50 12 98' : 'M2 2 Q13 50 2 98'} fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" vectorEffect="non-scaling-stroke" />
  </svg>
);
const gcd = (a: number, b: number): number => (b === 0 ? Math.abs(a) : gcd(b, a % b));
const lcm = (a: number, b: number): number => (a / gcd(a, b)) * b;
const showFrac = (f: Frac): string => `${f.s < 0 && f.n !== 0 ? '−' : ''}${f.n}/${f.d}`;

// A whole number as a row of digit cells
function Num({ value, variant, refFn, hidden = false }: { value: number; variant: DigitVariant; refFn?: (el: HTMLDivElement | null) => void; hidden?: boolean }): ReactElement {
  return (
    <div ref={refFn} className={`flex gap-1 transition-[opacity,filter] duration-300 ease-out ${hidden ? 'opacity-0 blur-sm' : 'opacity-100 blur-none'}`}>
      {String(Math.abs(value)).split('').map((c, i) => <Digit key={i} digit={Number(c)} variant={variant} operand compact />)}
    </div>
  );
}

// A sign written inside an expression: cyan plus, pink minus (like the rewritten negatives in addition)
const SignMark = ({ s, hidden = false }: { s: 1 | -1; hidden?: boolean }): ReactElement => (
  <span className={`w-6 text-center text-[32px] font-black leading-none transition-[opacity,filter] duration-300 ease-out ${hidden ? 'opacity-0 blur-sm' : 'opacity-100 blur-none'} ${s < 0 ? 'text-pink-400' : 'text-cyan-400'}`}>
    {s < 0 ? '−' : '+'}
  </span>
);

// A bracket around a negative sum: −(8/8 + 7/8)
const Paren = ({ ch }: { ch: '(' | ')' }): ReactElement => <span className="text-[44px] font-light leading-none text-zinc-400">{ch}</span>;
// The "×" inside a product (8 × 9)
const Times = (): ReactElement => <span className="w-6 text-center text-[28px] font-black leading-none text-cyan-400">×</span>;

const Eq = (): ReactElement => <span className="text-[34px] font-black leading-none text-zinc-400 animate-pop-in">=</span>;

// The "×4" / "÷2" chip beside a numerator or a denominator: 28px tall, 9px padding at the sides, the sign and the
// digit 18.4px (20% bigger than 15.3px; the chip itself keeps its height and padding, so there is room all round)
const OpChip = ({ text, kind }: { text: string; kind: 'times' | 'divide' }): ReactElement => (
  <div className={`absolute left-full ml-2 top-1/2 -translate-y-1/2 h-7 px-[9px] flex items-center rounded-md border text-[18.4px] leading-none font-black text-white whitespace-nowrap animate-pop-in ${kind === 'times' ? 'bg-green-600 border-green-400 shadow-[0_0_10px_rgba(74,222,128,0.5)]' : 'bg-red-600 border-red-400 shadow-[0_0_10px_rgba(248,113,113,0.5)]'}`}>
    {text}
  </div>
);

// A value that gets crossed out in red, with its new value written small above it (numerator) or below it (denominator)
// — 6px away from the digit (was 4px), so it doesn't crowd it
function Crossable({ children, crossed, value, below = false, refFn }: { children: ReactNode; crossed: boolean; value: number; below?: boolean; refFn?: (el: HTMLDivElement | null) => void }): ReactElement {
  return (
    <div className="relative">
      {children}
      {crossed && (
        <>
          {/* The red strike: from the bottom-left to the top-right corner of the number, so it stays inside it however
              many digits it has. The width and height are set: an svg doesn't stretch between left/right like a div,
              without them it takes the browser's default size (300×150) and the lines run across the board */}
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" className="absolute -left-1 top-1 w-[calc(100%+0.5rem)] h-[calc(100%-0.5rem)] z-40 pointer-events-none overflow-visible drop-shadow-[0_0_4px_rgba(239,68,68,0.8)]">
            <line x1="0" y1="82" x2="100" y2="18" stroke="#ef4444" strokeWidth="3" strokeLinecap="round" vectorEffect="non-scaling-stroke" />
          </svg>
          <div ref={refFn} className={`absolute left-1/2 -translate-x-1/2 ${below ? 'top-full mt-1.5' : 'bottom-full mb-1.5'} text-xl font-black leading-none text-red-300 drop-shadow-[0_0_6px_rgba(248,113,113,0.6)] animate-pop-in whitespace-nowrap`}>
            {value}
          </div>
        </>
      )}
    </div>
  );
}

// The warning triangle, in relief, lit from the top left: the face in #f2f2f2 (lighter at the top left, greyer
// towards the base and the right side), a bright edge along the left side, a darker edge along the base and the right
// side, and a shadow falling down and to the right. The "!" in #e73131 is raised too: lighter at the top, darker at
// the bottom, with a thin highlight on its left and a small shadow to the bottom right
const TRIANGLE = 'M10.27 1.9a2 2 0 0 1 3.46 0l9.5 16.5A2 2 0 0 1 21.5 21.4h-19a2 2 0 0 1-1.73-3L10.27 1.9z';
const WarningIcon = (): ReactElement => (
  <svg viewBox="0 0 24 22" aria-hidden="true" className="absolute left-3 top-2.5 w-6.5 h-6 overflow-visible drop-shadow-[1.5px_2px_1.5px_rgba(0,0,0,0.5)]">
    <defs>
      <linearGradient id="warn-face" x1="0.2" y1="0" x2="0.8" y2="1">
        <stop offset="0" stopColor="#ffffff" />
        <stop offset="0.45" stopColor="#f2f2f2" />
        <stop offset="0.8" stopColor="#dadada" />
        <stop offset="1" stopColor="#c2c2c2" />
      </linearGradient>
      <linearGradient id="warn-light" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stopColor="#ffffff" stopOpacity="1" />
        <stop offset="0.5" stopColor="#ffffff" stopOpacity="0" />
      </linearGradient>
      <linearGradient id="warn-dark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0.45" stopColor="#000000" stopOpacity="0" />
        <stop offset="1" stopColor="#000000" stopOpacity="0.38" />
      </linearGradient>
      <linearGradient id="warn-mark" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#ff6b6b" />
        <stop offset="0.5" stopColor="#e73131" />
        <stop offset="1" stopColor="#b01f1f" />
      </linearGradient>
      <clipPath id="warn-clip"><path d={TRIANGLE} /></clipPath>
      <filter id="warn-mark-shadow" x="-50%" y="-20%" width="200%" height="140%">
        <feDropShadow dx="0.6" dy="0.8" stdDeviation="0.35" floodColor="#000000" floodOpacity="0.45" />
      </filter>
    </defs>
    <path d={TRIANGLE} fill="url(#warn-face)" />
    {/* Bevel: a bright edge at the top left, a dark one along the base and the right side (inside the triangle only) */}
    <g clipPath="url(#warn-clip)" fill="none">
      <path d={TRIANGLE} stroke="url(#warn-light)" strokeWidth="2" />
      <path d={TRIANGLE} stroke="url(#warn-dark)" strokeWidth="2.4" />
    </g>
    <g filter="url(#warn-mark-shadow)" fill="url(#warn-mark)">
      <rect x="10.85" y="6.6" width="2.3" height="8" rx="1.15" />
      <circle cx="12" cy="17.6" r="1.35" />
    </g>
    {/* A thin highlight on the left of the "!" */}
    <rect x="11.15" y="7.2" width="0.55" height="6.6" rx="0.27" fill="#ffffff" opacity="0.45" />
  </svg>
);

// A fraction: its top, a line as wide as the wider of top and bottom (signs included), its bottom
// The chips beside it get exactly the room they need: an invisible copy of the chip after the fraction, so whatever
// follows (a bracket, a sign) comes after the chips. The line sticks out 6px on both sides of the wider number
function FracView({ top, bottom, chip, roomForChip = false, topRef }: { top: ReactNode; bottom: ReactNode; chip?: { text: string; kind: 'times' | 'divide' }; roomForChip?: boolean; topRef?: (el: HTMLDivElement | null) => void }): ReactElement {
  return (
    <div className="flex items-center">
      <div className="frac-col flex flex-col items-center gap-2 py-7 px-1.5">
        <div ref={topRef} className="relative flex items-center gap-1.5 px-1">{top}{chip && <OpChip {...chip} />}</div>
        <div className="h-1 self-stretch -mx-1.5 rounded-full bg-zinc-300 shadow-[0_0_8px_rgba(212,212,216,0.35)]" />
        <div className="relative flex items-center gap-1.5 px-1">{bottom}{chip && <OpChip {...chip} />}</div>
      </div>
      {chip && roomForChip && (
        <span aria-hidden="true" className="invisible ml-2 h-7 px-[9px] border text-[18.4px] leading-none font-black whitespace-nowrap">{chip.text}</span>
      )}
    </div>
  );
}

interface FractionBoardProps extends BoardProps {
  fraction: FractionParts;
  onCycleFractionDigit: (part: FracPart, index: number, direction: 1 | -1) => void;
}

export default function FractionBoard({ num1, num2, run, onStatus, onDone, renderSign, hoverEdit = false, availableWidth, fraction, onCycleFractionDigit }: FractionBoardProps): ReactElement {
  const f1: Frac = { n: numberValue(fraction.n1), d: numberValue(fraction.d1), s: num1.sign };
  const f2: Frac = { n: numberValue(fraction.n2), d: numberValue(fraction.d2), s: num2.sign };
  const ready = (['n1', 'd1', 'n2', 'd2'] as const).every(k => fraction[k].digits.length > 0);

  // The numbers of the whole explanation (valid only when both denominators are > 0)
  const valid = f1.d > 0 && f2.d > 0;
  const D = valid ? lcm(f1.d, f2.d) : 1;
  const k1 = D / (f1.d || 1);
  const k2 = D / (f2.d || 1);
  const a1 = f1.s * f1.n * k1; // amplified numerators, with their signs
  const a2 = f2.s * f2.n * k2;
  const N = a1 + a2;
  const g = gcd(Math.abs(N), D) || 1;
  const rn = Math.abs(N) / g;
  const rd = D / g;
  const sN: 1 | -1 = N < 0 ? -1 : 1;
  const whole = Math.floor(rn / rd);
  const rem = rn % rd;

  const [hl, setHl] = useState('');
  // The lists of multiples; null = "…" (the multiples of 1 are shortened: 1 … 5)
  const [multiples, setMultiples] = useState<{ a: (number | null)[]; b: (number | null)[]; common: number | null } | null>(null);
  const [amp1, setAmp1] = useState<Mark | null>(null);
  const [amp2, setAmp2] = useState<Mark | null>(null);
  const [line2, setLine2] = useState<{ t1: boolean; t2: boolean; den: boolean } | null>(null);
  const [line3, setLine3] = useState<{ num: boolean; den: boolean; simp: Mark | null } | null>(null);
  const [extra, setExtra] = useState<'whole' | 'mixed' | null>(null);
  // The mixed number explained, e.g. 15/8: 1 = (8 + 7)/8, 2 = 8/8 + 7/8, 3 = 1 + 7/8, then the mixed number 1 7/8.
  // parts / den / wholes / fw: what has already appeared (the jumps land on hidden places that then show up)
  const [mix, setMix] = useState<{ stage: 1 | 2 | 3; parts: number; den: boolean; wholes: number; fw: boolean } | null>(null);
  const [hop, setHop] = useState<Hop | null>(null);

  // The LCM by prime factorization (when a list of multiples would be longer than MAX_MULTIPLES): each denominator as
  // a product of primes (8 = 2 × 2 × 2), then with powers (= 2³), then every prime once with its biggest power (green),
  // which jump into the LCM row: 2³ × 3² = 8 × 9 = 72
  const fRows = [f1.d, f2.d].map(d => {
    const pf = primeFactors(d);
    return { d, pf, flat: pf.flatMap(({ p, e }) => Array<number>(e).fill(p)), hasPower: pf.some(x => x.e > 1) };
  });
  const lcmPicks = (() => {
    const best = new Map<number, { e: number; row: number }>();
    fRows.forEach((r, row) => r.pf.forEach(({ p, e }) => {
      const cur = best.get(p);
      if (!cur || e > cur.e) best.set(p, { e, row });
    }));
    return [...best.entries()].sort((a, b) => a[0] - b[0]).map(([p, { e, row }]) => ({ p, e, row }));
  })();
  const picked = (row: number, p: number) => lcmPicks.some(k => k.row === row && k.p === p);
  const [fact, setFact] = useState<{ rows: number; shown: number[]; power: boolean[]; pick: boolean; lcmRow: boolean; lcm: number; values: boolean; result: boolean } | null>(null);

  // The division-by-zero warning can be closed (its X, or a click anywhere outside it). Explain to Me and Redo stay
  // disabled while a denominator is 0; when a denominator becomes 0 again (or the other one does too), it comes back
  const zeroKey = `${f1.d === 0}-${f2.d === 0}`;
  const [closedFor, setClosedFor] = useState<string | null>(null);
  const [lastZeroKey, setLastZeroKey] = useState(zeroKey);
  if (lastZeroKey !== zeroKey) {
    setLastZeroKey(zeroKey);
    setClosedFor(null);
  }
  const alertRef = useRef<HTMLDivElement>(null);
  const alertOpen = (f1.d === 0 || f2.d === 0) && closedFor !== zeroKey;
  useEffect(() => {
    if (!alertOpen) return;
    const onDown = (e: PointerEvent) => {
      if (alertRef.current && !alertRef.current.contains(e.target as Node)) setClosedFor(zeroKey);
    };
    document.addEventListener('pointerdown', onDown);
    return () => document.removeEventListener('pointerdown', onDown);
  }, [alertOpen, zeroKey]);

  // Elements the jumps start from and land on, by name
  const refs = useRef<Record<string, HTMLElement | null>>({});
  const reg = (k: string) => (el: HTMLElement | null) => { refs.current[k] = el; };

  useEffect(() => {
    if (!run || !ready) return;
    let alive = true;
    let seq = 0;
    const wait = (ms: number) => new Promise<boolean>(resolve => pausableTimeout(() => resolve(alive), paced(ms)));
    const centre = (k: string) => {
      const r = refs.current[k]?.getBoundingClientRect();
      return r ? { x: r.left + r.width / 2, y: r.top + r.height / 2 } : null;
    };
    // A number jumps slowly in an arc (like a carry) from one place to another, then a short pause
    // `land` shows what the number brings: FR_LAND_MS before the end, while the square fades out (crossfade)
    const jump = async (from: string, to: string, value: number | string, land: () => void) => {
      const a = centre(from);
      const b = centre(to);
      if (a && b) setHop({ x0: a.x, y0: a.y, x1: b.x, y1: b.y, value, key: `h${seq++}` });
      if (!(await wait(FR_HOP_MS - FR_LAND_MS))) return false;
      land();
      const ok = await wait(FR_LAND_MS);
      setHop(null);
      return ok && wait(FR_HOP_PAUSE);
    };

    (async () => {

      // React's strict mode (dev) mounts, cleans up and mounts again: let the throwaway run end here,

      // before it announces its first step (otherwise that step shows twice)

      await Promise.resolve();

      if (!alive) return;
      if (!valid) {
        onStatus('We can\'t divide by zero: a denominator can\'t be 0. Choose a different number for the red denominator, then try again.');
        onDone();
        return;
      }
      const second = f2.s < 0 ? `(${showFrac(f2)})` : showFrac(f2);
      onStatus(`We add the fractions ${showFrac(f1)} + ${second}.${f2.s < 0 ? ' Adding a negative fraction is the same as subtracting it.' : ''}`);
      if (!(await wait(2080))) return;

      if (f1.d === f2.d) {
        setHl('d');
        onStatus(`Both fractions have the denominator ${D}: their pieces are the same size, so we can add the numerators straight away.`);
        if (!(await wait(1800))) return;
      } else {
        setHl('d');
        const byFactors = listLength(f1.d, k1) > MAX_MULTIPLES || listLength(f2.d, k2) > MAX_MULTIPLES;
        onStatus(`The denominators ${f1.d} and ${f2.d} are different: the pieces have different sizes. We need a common denominator: the least common multiple (LCM) of ${f1.d} and ${f2.d}.`);
        if (!(await wait(1800))) return;
        if (byFactors) {
          // Prime factorization, row by row: the multiplication first, then the same written with powers
          onStatus(`The lists of multiples would be too long, so we break each denominator into prime factors: numbers that can't be split any more.`);
          if (!(await wait(2200))) return;
          const st = { rows: 0, shown: [0, 0], power: [false, false], pick: false, lcmRow: false, lcm: 0, values: false, result: false };
          const put = () => setFact({ ...st, shown: [...st.shown], power: [...st.power] });
          for (let r = 0; r < 2; r++) {
            const row = fRows[r];
            st.rows = r + 1;
            put();
            onStatus(row.d === 1 ? '1 has no prime factors.'
              : row.flat.length === 1 ? `${row.d} is a prime number: it can't be split into smaller factors.`
              : `${row.d} = ${row.flat.join(' × ')}.`);
            for (let i = 0; i < Math.max(1, row.flat.length); i++) {
              st.shown[r] = i + 1;
              put();
              if (!(await wait(450))) return;
            }
            if (row.hasPower) {
              const first = row.pf.find(x => x.e > 1) ?? row.pf[0];
              if (!(await wait(500))) return;
              st.power[r] = true;
              put();
              onStatus(`${Array(first.e).fill(first.p).join(' × ')} is written ${powerText(first.p, first.e)} (say: ${first.p} to the power of ${first.e}): ${first.p} multiplied by itself ${first.e} times. So ${row.d} = ${row.pf.map(x => powerText(x.p, x.e)).join(' × ')}.`);
              if (!(await wait(2800))) return;
            } else if (!(await wait(1200))) return;
          }
          onStatus(`For the LCM we take every prime factor once, with its biggest power: ${lcmPicks.map(k => `${powerText(k.p, k.e)} from ${fRows[k.row].d}`).join(' and ')}.`);
          st.pick = true;
          put();
          if (!(await wait(2200))) return;
          st.lcmRow = true;
          put();
          if (!(await wait(400))) return;
          for (let i = 0; i < lcmPicks.length; i++) {
            const k = lcmPicks[i];
            if (!(await jump(`pf${k.row}-${k.p}`, `lcm${i}`, powerText(k.p, k.e), () => { st.lcm = i + 1; put(); }))) return;
          }
          if (lcmPicks.some(k => k.e > 1)) {
            onStatus(`${lcmPicks.map(k => powerText(k.p, k.e)).join(' × ')} = ${lcmPicks.map(k => k.p ** k.e).join(' × ')} = ${D}.`);
            st.values = true;
            put();
            if (!(await wait(1800))) return;
          }
          st.result = true;
          put();
          onStatus(`${D} is the least common multiple (LCM) of ${f1.d} and ${f2.d}: our common denominator.`);
          if (!(await wait(2000))) return;
        } else {
        // The multiples of each denominator, one by one (see listOf)
        const A: (number | null)[] = [];
        const B: (number | null)[] = [];
        setMultiples({ a: [], b: [], common: null });
        for (const v of listOf(f1.d, k1)) {
          A.push(v);
          setMultiples({ a: [...A], b: [], common: null });
          if (!(await wait(380))) return;
        }
        for (const v of listOf(f2.d, k2)) {
          B.push(v);
          setMultiples({ a: [...A], b: [...B], common: null });
          if (!(await wait(380))) return;
        }
        setMultiples({ a: A, b: B, common: D });
        onStatus(`${D} is the first number in both lists: the least common multiple. It is our common denominator.`);
        if (!(await wait(1800))) return;
        }

        // Amplify each fraction whose denominator isn't D yet
        const steps: { f: Frac; k: number; set: (m: Mark | null) => void; id: string }[] = [
          { f: f1, k: k1, set: setAmp1, id: '1' },
          { f: f2, k: k2, set: setAmp2, id: '2' },
        ];
        for (const st of steps) {
          setHl(`f${st.id}`);
          if (st.k === 1) {
            onStatus(`${showFrac(st.f)} already has the denominator ${D}: it stays as it is.`);
            if (!(await wait(1500))) return;
            continue;
          }
          onStatus(`${st.f.d} × ${st.k} = ${D}, so we multiply the numerator AND the denominator of ${showFrac(st.f)} by ${st.k}. The fraction keeps its value: the pieces just get smaller.`);
          st.set({ k: st.k, crossed: false, n: st.f.n * st.k, d: D });
          if (!(await wait(2000))) return;
          onStatus(`${st.f.n} × ${st.k} = ${st.f.n * st.k}  and  ${st.f.d} × ${st.k} = ${D}.`);
          st.set({ k: st.k, crossed: true, n: st.f.n * st.k, d: D });
          if (!(await wait(1800))) return;
        }
      }
      setHl('');

      // One fraction with a long line: the numerators with their signs on top, the common denominator below
      setLine2({ t1: false, t2: false, den: false });
      onStatus(`Now both fractions have the denominator ${D}. We write them as ONE fraction: a long line, the numerators with their signs on top, ${D} below.`);
      if (!(await wait(700))) return;
      if (!(await jump(k1 > 1 ? 'n1x' : 'n1', 't1', Math.abs(a1), () => setLine2({ t1: true, t2: false, den: false })))) return;
      if (!(await jump(k2 > 1 ? 'n2x' : 'n2', 't2', Math.abs(a2), () => setLine2({ t1: true, t2: true, den: false })))) return;
      if (!(await jump(k1 > 1 ? 'd1x' : 'd1', 'den', D, () => setLine2({ t1: true, t2: true, den: true })))) return;
      if (!(await wait(1300))) return;

      // The sum of the numerators; the denominator stays
      setLine3({ num: false, den: false, simp: null });
      onStatus(`${a1 < 0 ? '−' : ''}${Math.abs(a1)} ${a2 < 0 ? '−' : '+'} ${Math.abs(a2)} = ${N < 0 ? '−' : ''}${Math.abs(N)}. The denominator stays ${D}: we counted pieces of the same size.`);
      if (!(await wait(700))) return;
      if (!(await jump('top2', 'rn', Math.abs(N), () => setLine3({ num: true, den: false, simp: null })))) return;
      if (!(await jump('den', 'rd', D, () => setLine3({ num: true, den: true, simp: null })))) return;
      if (!(await wait(1500))) return;

      if (N === 0) {
        onStatus('The numerator is 0: no pieces at all, so the result is 0.');
        setExtra('whole');
        if (!(await wait(1500))) return;
      } else {
        if (g > 1) {
          onStatus(`${Math.abs(N)} and ${D} can both be divided by ${g}, so we simplify the fraction: top and bottom ÷ ${g}.`);
          setLine3({ num: true, den: true, simp: { k: g, crossed: false, n: rn, d: rd } });
          if (!(await wait(2000))) return;
          onStatus(`${Math.abs(N)} ÷ ${g} = ${rn}  and  ${D} ÷ ${g} = ${rd}.`);
          setLine3({ num: true, den: true, simp: { k: g, crossed: true, n: rn, d: rd } });
          if (!(await wait(1800))) return;
        }
        if (rd === 1) {
          onStatus(`The denominator is 1, so the result is the whole number ${sN < 0 ? '−' : ''}${rn}.`);
          setExtra('whole');
          if (!(await wait(1500))) return;
        } else if (rn > rd) {
          // How the whole in front is found: split the numerator into wholes (rd pieces each) and the rest
          const few = whole <= MAX_WHOLE_PIECES;
          const pieces = few ? whole + 1 : 2;
          const st = { stage: 1 as 1 | 2 | 3, parts: 0, den: false, wholes: 0, fw: false };
          setMix({ ...st });
          onStatus(few
            ? `${rn}/${rd} is more than a whole. One whole is ${rd}/${rd}: ${rd} pieces of ${rd}. So we split ${rn} into ${[...Array(whole).fill(rd), rem].join(' + ')}.`
            : `${rn}/${rd} is more than a whole. ${rn} ÷ ${rd} = ${whole} remainder ${rem}, so ${rn} = ${whole} × ${rd} + ${rem}.`);
          if (!(await wait(900))) return;
          // The first piece appears as the number lands; the others follow
          if (!(await jump(g > 1 ? 'rnx' : 'rn', 'm1top', rn, () => { st.parts = 1; setMix({ ...st }); }))) return;
          if (!(await wait(650))) return;
          for (let i = 2; i <= pieces; i++) {
            st.parts = i;
            setMix({ ...st });
            if (!(await wait(650))) return;
          }
          if (!(await jump(g > 1 ? 'rdx' : 'rd', 'm1den', rd, () => { st.den = true; setMix({ ...st }); }))) return;
          if (!(await wait(1600))) return;

          st.stage = 2;
          setMix({ ...st });
          onStatus(few
            ? `Each part goes over ${rd}: ${[...Array(whole).fill(`${rd}/${rd}`), `${rem}/${rd}`].join(' + ')}.`
            : `Each part goes over ${rd}: ${whole * rd}/${rd} + ${rem}/${rd}.`);
          if (!(await wait(2400))) return;

          st.stage = 3;
          setMix({ ...st });
          onStatus(few
            ? `${rd}/${rd} is one whole: ${rd} pieces of ${rd}. So ${rd}/${rd} = 1.`
            : `${whole * rd}/${rd} = ${whole * rd} ÷ ${rd} = ${whole} wholes.`);
          if (!(await wait(700))) return;
          for (let i = 0; i < (few ? whole : 1); i++) {
            if (!(await jump(`m2w${i}`, `m3w${i}`, few ? 1 : whole, () => { st.wholes = i + 1; setMix({ ...st }); }))) return;
          }
          if (!(await wait(1400))) return;

          setExtra('mixed');
          onStatus(`${whole} + ${rem}/${rd} is written as the mixed number ${whole} ${rem}/${rd}: ${whole} whole${whole > 1 ? 's' : ''} and ${rem}/${rd}.`);
          if (!(await wait(700))) return;
          if (!(await jump('m3ws', 'fw', whole, () => { st.fw = true; setMix({ ...st }); }))) return;
          if (!(await wait(1800))) return;
        }
      }

      const sign = sN < 0 && N !== 0 ? '−' : '';
      const result = N === 0 ? '0' : rd === 1 ? `${sign}${rn}` : rn > rd ? `${sign}${whole} ${rem}/${rd}` : `${sign}${rn}/${rd}`;
      onStatus(doneMessage(result, rn > rd && rd > 1 ? `  (= ${sign}${rn}/${rd})` : ''));
      onDone();
    })();

    return () => { alive = false; };
    // The board is remounted (new key) for every new run, so it only depends on `run`
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [run]);

  // Fit: when the row of the calculations is wider than the board area, everything shrinks evenly (CSS zoom: digits,
  // signs, lines, chips, brackets) until it fits, but never below MIN_FIT (75%); from there the rows wrap. Measured
  // after every render, at the natural size (the measured widths divided by the current zoom)
  const contentRef = useRef<HTMLDivElement>(null);
  const [fit, setFit] = useState(1);
  useLayoutEffect(() => {
    const row = contentRef.current?.querySelector<HTMLElement>('[data-expr]');
    if (!row || !availableWidth) return;
    const items = [...row.children] as HTMLElement[];
    const natural = items.reduce((w, c) => w + c.getBoundingClientRect().width / fit, 0) + EXPR_GAP * Math.max(0, items.length - 1);
    // 2% to spare, so rounding never pushes the last part onto a new row
    const next = Math.max(MIN_FIT, Math.min(1, (availableWidth - 16) / Math.max(1, natural * 1.02)));
    if (Math.abs(next - fit) > 0.02) setFit(next);
  });

  if (!ready) return <div />;
  const editable = hoverEdit && !run;
  const variantOf = (key: string, part: 'n' | 'd'): DigitVariant => (hl === key || (hl === 'd' && part === 'd') ? 'highlight' : 'input');

  // A denominator of 0 can be chosen, but it is circled in red and the board warns under the problem
  const zero1 = f1.d === 0;
  const zero2 = f2.d === 0;
  const zeroWhere = zero1 && zero2 ? 'both fractions' : zero1 ? 'the first fraction' : 'the second fraction';

  // A numerator or denominator of the problem (1 to 6 digits), each digit turned with its steel drum while nothing runs
  const operand = (which: 'n1' | 'n2', part: 'n' | 'd', value: number) => {
    const key: FracPart = `${part}${which === 'n1' ? '1' : '2'}` as FracPart;
    return (
      // While the explanation runs (the digits can't be changed) the input digits are 15% bigger
      // (zoom, not scale: the brackets, the line, the chips and the sign make room for the bigger digits)
      <div ref={reg(key)} className={`flex gap-2.5 ${run ? '[zoom:1.15]' : ''} ${part === 'd' && value === 0 ? 'rounded-md ring-2 ring-red-500 ring-offset-2 ring-offset-zinc-950 shadow-[0_0_14px_rgba(239,68,68,0.75)] transition-shadow' : ''}`}>
        {fraction[key].digits.map((dg, i) => (
          <Digit
            key={i}
            digit={dg}
            variant={variantOf(which === 'n1' ? 'f1' : 'f2', part)}
            isNum1={which === 'n1'}
            operand
            hoverEditable={editable}
            onIncrement={() => onCycleFractionDigit(key, i, 1)}
            onDecrement={() => onCycleFractionDigit(key, i, -1)}
          />
        ))}
      </div>
    );
  };

  const problemFrac = (which: 'n1' | 'n2', f: Frac, amp: Mark | null) => {
    const id = which === 'n1' ? '1' : '2';
    return (
      <FracView
        roomForChip={!!amp}
        chip={amp ? { text: `×${amp.k}`, kind: 'times' } : undefined}
        top={<Crossable crossed={!!amp?.crossed} value={amp?.n ?? 0} refFn={reg(`n${id}x`)}>{operand(which, 'n', f.n)}</Crossable>}
        bottom={<Crossable crossed={!!amp?.crossed} value={amp?.d ?? 0} below refFn={reg(`d${id}x`)}>{operand(which, 'd', f.d)}</Crossable>}
      />
    );
  };

  const simp = line3?.simp ?? null;
  const sign = sN;

  return (
    // The jumping square stays outside the zoomed part (it is placed in screen pixels)
    <div className="flex flex-col items-center">
    {/* Zoomed to fit (see `fit`), and at most as wide as the board area, so the rows wrap (the second fraction under
        the first) instead of scrolling */}
    <div ref={contentRef} className="flex flex-col items-center" style={{ zoom: fit, maxWidth: availableWidth ? Math.max(320, availableWidth - 16) / fit : undefined }}>
      <div data-expr className="flex flex-wrap items-center justify-center gap-x-5 gap-y-4">
        {/* The problem: (±a/b) + (±c/d): each fraction with its sign in round brackets, the + between them. When they
            don't fit side by side, the second goes under the first and the + stays after the first */}
        <div className="flex max-w-full flex-wrap items-center justify-center gap-x-3 gap-y-2">
          <div className="flex items-stretch gap-2">
            <Bracket side="left" />
            <div className="flex items-center gap-2">{renderSign('n1', num1.sign)}{problemFrac('n1', f1, amp1)}</div>
            <Bracket side="right" />
          </div>
          <span className="text-cyan-500"><OpIcon op="addition" /></span>
          <div className="flex items-stretch gap-2">
            <Bracket side="left" />
            <div className="flex items-center gap-2">{renderSign('n2', num2.sign)}{problemFrac('n2', f2, amp2)}</div>
            <Bracket side="right" />
          </div>
        </div>

        {/* One fraction, one long line under the numerators and their signs */}
        {line2 && (
          <div className="flex items-center gap-4">
            <Eq />
            <FracView
              topRef={reg('top2')}
              top={(
                <>
                  {a1 < 0 && <SignMark s={-1} hidden={!line2.t1} />}
                  <Num value={a1} variant="computed" refFn={reg('t1')} hidden={!line2.t1} />
                  <SignMark s={a2 < 0 ? -1 : 1} hidden={!line2.t2} />
                  <Num value={a2} variant="computed" refFn={reg('t2')} hidden={!line2.t2} />
                </>
              )}
              bottom={<Num value={D} variant="computed" refFn={reg('den')} hidden={!line2.den} />}
            />
          </div>
        )}

        {/* The sum of the numerators over the common denominator (then simplified) */}
        {line3 && (
          <div className="flex items-center gap-4">
            <Eq />
            <FracView
              roomForChip={!!simp}
              chip={simp ? { text: `÷${simp.k}`, kind: 'divide' } : undefined}
              top={(
                <>
                  {sign < 0 && <SignMark s={-1} hidden={!line3.num} />}
                  <Crossable crossed={!!simp?.crossed} value={simp?.n ?? 0} refFn={reg('rnx')}><Num value={N} variant="result" refFn={reg('rn')} hidden={!line3.num} /></Crossable>
                </>
              )}
              bottom={<Crossable crossed={!!simp?.crossed} value={simp?.d ?? 0} below refFn={reg('rdx')}><Num value={D} variant="result" refFn={reg('rd')} hidden={!line3.den} /></Crossable>}
            />
          </div>
        )}

        {/* A whole number, or a mixed number */}
        {extra === 'whole' && (
          <div className="flex items-center gap-4">
            <Eq />
            {sign < 0 && N !== 0 && <SignMark s={-1} />}
            <Num value={N === 0 ? 0 : rn} variant="result" />
          </div>
        )}
        {/* The mixed number explained: (8 + 7)/8 = 8/8 + 7/8 = 1 + 7/8 (wholes ringed in green) */}
        {mix && (() => {
          const few = whole <= MAX_WHOLE_PIECES;
          const ring = 'rounded-md ring-2 ring-green-400/80 shadow-[0_0_10px_rgba(74,222,128,0.45)]';
          const neg = sign < 0;
          return (
            <>
              <div className="flex items-center gap-4">
                <Eq />
                {neg && <SignMark s={-1} />}
                <FracView
                  topRef={reg('m1top')}
                  top={few ? (
                    <>
                      {[...Array(whole).fill(rd), rem].map((v: number, i) => (
                        <div key={i} className="flex items-center gap-1.5">
                          {i > 0 && <SignMark s={1} hidden={mix.parts <= i} />}
                          <div className={i < whole && mix.parts > i ? `${ring} p-1` : 'p-1'}><Num value={v} variant="computed" hidden={mix.parts <= i} /></div>
                        </div>
                      ))}
                    </>
                  ) : (
                    <>
                      <div className={`flex items-center gap-1.5 transition-opacity duration-500 ${mix.parts >= 1 ? `opacity-100 ${ring} p-1` : 'opacity-0'}`}>
                        <Num value={whole} variant="computed" /><Times /><Num value={rd} variant="computed" />
                      </div>
                      <SignMark s={1} hidden={mix.parts < 2} />
                      <Num value={rem} variant="computed" hidden={mix.parts < 2} />
                    </>
                  )}
                  bottom={<Num value={rd} variant="computed" refFn={reg('m1den')} hidden={!mix.den} />}
                />
              </div>
              {mix.stage >= 2 && (
                <div className="flex items-center gap-3 animate-pop-in">
                  <Eq />
                  {neg && <SignMark s={-1} />}
                  {neg && <Paren ch="(" />}
                  {(few ? [...Array(whole).keys()] : [0]).map(i => (
                    <div key={i} className="flex items-center gap-3">
                      {i > 0 && <SignMark s={1} />}
                      {/* the ring hugs the fraction: its own top/bottom room (py-7) is taken away inside the ring */}
                      <div ref={reg(`m2w${i}`)} className={`${ring} px-1 [&_.frac-col]:py-1`}>
                        <FracView top={<Num value={few ? rd : whole * rd} variant="computed" />} bottom={<Num value={rd} variant="computed" />} />
                      </div>
                    </div>
                  ))}
                  <SignMark s={1} />
                  <FracView top={<Num value={rem} variant="computed" />} bottom={<Num value={rd} variant="computed" />} />
                  {neg && <Paren ch=")" />}
                </div>
              )}
              {mix.stage >= 3 && (
                <div className="flex items-center gap-3 animate-pop-in">
                  <Eq />
                  {neg && <SignMark s={-1} />}
                  {neg && <Paren ch="(" />}
                  <div ref={reg('m3ws')} className="flex items-center gap-3">
                    {(few ? [...Array(whole).keys()] : [0]).map(i => (
                      <div key={i} className="flex items-center gap-3">
                        {i > 0 && <SignMark s={1} hidden={mix.wholes <= i} />}
                        <Num value={few ? 1 : whole} variant="result" refFn={reg(`m3w${i}`)} hidden={mix.wholes <= i} />
                      </div>
                    ))}
                  </div>
                  <SignMark s={1} />
                  <FracView top={<Num value={rem} variant="computed" />} bottom={<Num value={rd} variant="computed" />} />
                  {neg && <Paren ch=")" />}
                </div>
              )}
            </>
          );
        })()}
        {extra === 'mixed' && (
          <div className="flex items-center gap-4">
            <Eq />
            <div className="flex items-center gap-2">
              {sign < 0 && <SignMark s={-1} hidden={!mix?.fw} />}
              <Num value={whole} variant="result" refFn={reg('fw')} hidden={!mix?.fw} />
              <FracView top={<Num value={rem} variant="result" />} bottom={<Num value={rd} variant="result" />} />
            </div>
          </div>
        )}
      </div>

      {/* Division by zero: the warning stays until the red denominator is changed. Red plate (#e73131), light text
          (#f2f2f2), and a warning triangle in its top-left corner: the triangle in the text's colour, the "!" in the
          plate's colour, with a soft shadow */}
      {alertOpen && (
        <div ref={alertRef} role="alert" className="relative mt-2 max-w-md rounded-xl border border-[#ff7a7a]/50 bg-[#e73131] py-2.5 pl-12 pr-9 text-center text-[#f2f2f2] shadow-[inset_0_1px_0_rgba(255,255,255,0.22),0_4px_14px_rgba(231,49,49,0.45)] animate-pop-in">
          <WarningIcon />
          {/* Close: only the X, no circle or frame; on hover it gets bolder (2 → 3) so it stands out */}
          <button type="button" onClick={() => setClosedFor(zeroKey)} aria-label="Close the warning" className="group absolute right-2 top-2 p-1 text-[#f2f2f2] opacity-85 transition-opacity hover:opacity-100 focus-visible:outline-2 focus-visible:outline-[#f2f2f2] rounded-sm cursor-pointer">
            <svg viewBox="0 0 12 12" aria-hidden="true" className="block w-3 h-3" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round"><path d="M2 2l8 8M10 2l-8 8" className="transition-[stroke-width] duration-150 group-hover:stroke-3" /></svg>
          </button>
          <div className="text-sm font-black">We can&apos;t divide by zero!</div>
          <div className="text-[13px] font-semibold">The denominator (the bottom number) can&apos;t be 0. Choose a different number, from 1 to 9, for {zeroWhere}.</div>
        </div>
      )}

      {/* The LCM by prime factorization: "Prime factors of 8:  2 × 2 × 2 = 2³", one row per denominator, then
          "LCM:  2³ × 3² = 8 × 9 = 72". Same grid as the multiples (labels on the left, stacked on phones) */}
      {fact && (
        <div className="mt-4 grid grid-cols-1 sm:grid-cols-[auto_auto] items-center gap-x-3 gap-y-1 sm:gap-y-2">
          {fRows.slice(0, fact.rows).map((row, r) => (
            <div key={r} className="contents">
              <span className="whitespace-nowrap text-left text-xs font-bold text-zinc-400 mt-1 sm:mt-0">Prime factors of {row.d}:</span>
              <div className="flex flex-wrap items-center gap-1 sm:gap-1.5">
                {row.flat.length === 0 ? <FactorChip p={1} hidden={fact.shown[r] < 1} /> : row.flat.map((p, i) => {
                  const firstOfP = row.flat.indexOf(p) === i;
                  return (
                    <Fragment key={i}>
                      {i > 0 && <Mul hidden={fact.shown[r] <= i} />}
                      <FactorChip p={p} hidden={fact.shown[r] <= i} pick={fact.pick && !row.hasPower && firstOfP && picked(r, p)} refFn={!row.hasPower && firstOfP ? reg(`pf${r}-${p}`) : undefined} />
                    </Fragment>
                  );
                })}
                {row.hasPower && fact.power[r] && (
                  <>
                    <SmallEq />
                    {row.pf.map(({ p, e }, i) => (
                      <Fragment key={p}>
                        {i > 0 && <Mul />}
                        <FactorChip p={p} e={e} pick={fact.pick && picked(r, p)} refFn={reg(`pf${r}-${p}`)} />
                      </Fragment>
                    ))}
                  </>
                )}
              </div>
            </div>
          ))}
          {fact.lcmRow && (
            <div className="contents">
              <span className="whitespace-nowrap text-left text-xs font-bold text-zinc-400 mt-1 sm:mt-0">LCM:</span>
              <div className="flex flex-wrap items-center gap-1 sm:gap-1.5">
                {lcmPicks.map((k, i) => (
                  <Fragment key={k.p}>
                    {i > 0 && <Mul hidden={fact.lcm <= i} />}
                    <FactorChip p={k.p} e={k.e} hidden={fact.lcm <= i} refFn={reg(`lcm${i}`)} />
                  </Fragment>
                ))}
                {fact.values && (
                  <>
                    <SmallEq />
                    {lcmPicks.map((k, i) => (
                      <Fragment key={k.p}>
                        {i > 0 && <Mul />}
                        <FactorChip p={k.p ** k.e} />
                      </Fragment>
                    ))}
                  </>
                )}
                {fact.result && <><SmallEq /><FactorChip p={D} pick /></>}
              </div>
            </div>
          )}
        </div>
      )}

      {/* Looking for the common denominator: a grid of two columns. The labels ("Multiples of 6:") start on the left,
          one under the other, colons aligned, never wrapping; the numbers are aligned to the right, so the common
          multiple (green) is in the same column on every row. On narrow screens (under 640px) each label goes on its own
          line, above its numbers, and the cells get smaller, so 9 multiples still fit on a phone */}
      {multiples && (
        <div className="mt-4 grid grid-cols-1 sm:grid-cols-[auto_auto] items-center gap-x-3 gap-y-1 sm:gap-y-2">
          {[{ d: f1.d, list: multiples.a, id: 'a' }, { d: f2.d, list: multiples.b, id: 'b' }].map(row => (
            <div key={row.id} className="contents">
              <span className="whitespace-nowrap text-left text-xs font-bold text-zinc-400 mt-1 sm:mt-0">Multiples of {row.d}:</span>
              <div className="flex justify-end gap-1 sm:gap-1.5">
                {row.list.map(v => (v === null ? (
                  <span key="dots" aria-label="and so on" className="min-w-6.5 h-6.5 sm:min-w-8 sm:h-7 flex items-center justify-center text-sm sm:text-base font-black tracking-wider text-zinc-500 animate-pop-in">…</span>
                ) : (
                  <span key={v} className={`min-w-6.5 h-6.5 px-1 text-xs sm:min-w-8 sm:h-7 sm:px-1.5 sm:text-sm flex items-center justify-center rounded-md border font-black animate-pop-in transition-colors duration-500 ${multiples.common === v ? 'bg-green-600 border-green-400 text-white shadow-[0_0_12px_rgba(74,222,128,0.6)]' : 'bg-zinc-800 border-zinc-700 text-zinc-300'}`}>
                    {v}
                  </span>
                )))}
              </div>
            </div>
          ))}
        </div>
      )}

    </div>
      {hop && <CarryHop key={hop.key} fixed duration={FR_HOP_MS} endScale={FR_HOP_END} fadeOutMs={FR_LAND_MS} wide x0={hop.x0} y0={hop.y0} x1={hop.x1} y1={hop.y1} value={hop.value} />}
    </div>
  );
}
