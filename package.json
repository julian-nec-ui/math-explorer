{
  "name": "math-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev-moz": "start firefox http://localhost:3001 && next dev",
    "dev-ch": "start http://localhost:3001 && next dev",
    "dev-ch-mac": "open -a \"Google Chrome\" http://localhost:3001 && next dev",
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "next build",
    "start": "next start",
    "start:api": "tsx server/index.ts",
    "lint": "next lint"
  },
  "dependencies": {
    "@xyflow/react": "^12.6.0",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mermaid": "^11.6.0",
    "motion": "^12.9.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.3"
}
